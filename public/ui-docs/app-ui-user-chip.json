{
  "name": "AppUi::UserChip",
  "component": "app-ui/user-chip",
  "doc": "app-ui-user-chip.md",
  "description": "An avatar and the user's name.",
  "arguments": {
    "user": { "type": "object", "required": true, "description": "The user record" },
    "linked": { "type": "boolean", "required": false, "default": false, "description": "Link the name to the user page" },
    "size": { "type": "string", "required": false, "description": "The avatar size: sm, xs or none" }
  },
  "events": {},
  "blocks": {},
  "data": {
    "user": {
      "type": "object",
      "fields": {
        "id": { "type": "string|number", "required": false, "description": "The user image address and agent lookup" },
        "name": { "type": "string", "required": false, "description": "Shown as the name" },
        "type": { "type": "string", "required": false, "description": "agent for an agent" }
      }
    }
  }
}
