{
  "name": "AppUi::Avatar",
  "component": "app-ui/avatar",
  "doc": "app-ui-avatar.md",
  "description": "The round picture of a user (person or agent).",
  "arguments": {
    "user": { "type": "object", "required": true, "description": "The user record" },
    "size": { "type": "string", "required": false, "description": "sm, xs or none" }
  },
  "events": {},
  "blocks": {},
  "data": {
    "user": {
      "type": "object",
      "fields": {
        "id": { "type": "string|number", "required": false, "description": "The user image address and agent lookup" },
        "name": { "type": "string", "required": false, "description": "The alternative text and the source of the initials" },
        "type": { "type": "string", "required": false, "description": "agent for an agent" }
      }
    }
  }
}
