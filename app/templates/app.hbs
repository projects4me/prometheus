<DocumentTitle />
<AppLayouts::ApplicationWrapper>
  {{!-- Main Header --}}
  <AppLayouts::ApplicationHeader
      @session={{this.session}}
      @invalidateSession={{this.invalidateSession}}
      @userProfile={{this.userProfile}}
      @searchedItem={{this.itemSearched}}
      @projects={{this.projects}}
  />

  {{!-- Left side column. contains the logo and sidebar --}}
  <AppLayouts::ApplicationSidebar
  />
  {{!-- Content Wrapper. Contains page content --}}
  <div class="content-wrapper">
    {{outlet}}
  </div>
  {{!-- /.content-wrapper --}}

  {{!-- Main Footer --}}
  <AppLayouts::ApplicationFooter />
  <AppLayouts::NotificationsSidebar/>
</AppLayouts::ApplicationWrapper>
