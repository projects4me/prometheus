<div class="module-view-wrapper">
  <div class="module-view">

    <div class="list-view-header clearfix">

      <div class="list-view-module">
        <h1>{{this.module}}</h1>
      </div>

      <div class="btn-group">
        <AppUi::Button type="button" class="btn btn-default"> <i class="fa fa-plus"></i> {{t "global.form.createnew"}}</AppUi::Button>
      </div>

    </div>

    <div class="row list-view-actions">
      <div class="col-sm-10">
        {{#if this.querySchema}}
          <EzSearch @schema={{this.querySchema}} @query={{this.query}} @onApply={{this.applyQuery}} />
        {{/if}}
      </div>

      <div class="btn-group col-sm-2">
        <span class="list-view-count pull-left">{{t "global.list.selected"}} {{this.selectedCount}}</span>
        <span class="pagination">
          {{#if this.model.content.meta._links.prev}}
            <AppUi::Button type="button" class="btn btn-default" {{on "click" (fn this.paginate (get-page this.model.content.meta._links.next.href))}}><i class="fa fa-angle-double-left"></i></AppUi::Button>
          {{else}}
            <AppUi::Button type="button" class="btn btn-default disabled"><i class="fa fa-angle-double-left"></i></AppUi::Button>
          {{/if}}

          {{#if this.model.content.meta._links.next}}
            <AppUi::Button type="button" class="btn btn-default" {{on "click" (fn this.paginate (get-page this.model.content.meta._links.next.href))}}><i class="fa fa-angle-double-right"></i></AppUi::Button>
          {{else}}
            <AppUi::Button type="button" class="btn btn-default disabled"><i class="fa fa-angle-double-right"></i></AppUi::Button>
          {{/if}}
        </span>
      </div>
    </div>

    <div class="list-view table-responsive">
      <table class="table table-hover table-striped table-bordered">
        <thead>
          <tr>
            <th>
              <div class="btn-group">
                <AppUi::Button type="button" class="btn">{{checkbox-field action=this.selectAll type="checkbox" data-select="all"}}</AppUi::Button>
                <AppUi::Button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="caret"></span>
                  <span class="sr-only">{{t 'global.list.toggleDropdown'}}</span>
                </AppUi::Button>
                <ul class="dropdown-menu">
                  <li><a href="javascript:void(0);" {{on "click" this.selectAll}}>{{t 'global.list.selectAll'}}</a></li>
                  <li><a href="javascript:void(0);" {{on "click" this.deleteAll}}>{{t 'global.list.deleteAll'}}</a></li>
                  <li><a href="javascript:void(0);" {{on "click" this.exportAll}}>{{t 'global.list.exportAll'}}</a></li>
                  <li><a href="javascript:void(0);" {{on "click" this.updateAll}}>{{t 'global.list.updateAll'}}</a></li>
                </ul>
              </div>
            </th>
            {{#each-in this.metaData.fields as |field definition|}}
              {{#if definition.sort}}
                <th class="sortable" data-sort="{{this.module}}.{{definition.fieldName}}Sortable"><a href="javascript:void(0);" {{on "click" (fn this.sortData definition.fieldName)}}>{{t definition.label}}</a></th>
              {{else}}
                <th>{{t definition.label}}</th>
              {{/if}}
            {{/each-in}}
          </tr>
        </thead>
        <tbody>
          {{#each this.model as |entity|}}
            <tr>
              <td>
                <div class="btn-group">
                  <AppUi::Button type="button" class="btn">{{checkbox-field action=this.select type="checkbox" data-select=entity.id}}</AppUi::Button>
                  <AppUi::Button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="caret"></span>
                    <span class="sr-only">{{t "global.list.toggleDropdown"}}</span>
                  </AppUi::Button>
                  <ul class="dropdown-menu">
                    <li><a href="javascript:void(0);" {{on "click" this.select}}>{{t 'global.list.select'}}</a></li>
                    <li><a href="javascript:void(0);" {{on "click" this.export}}>{{t 'global.list.export'}}</a></li>
                    <li><a href="javascript:void(0);" {{on "click" this.delete}}>{{t 'global.list.delete'}}</a></li>
                    <li><a href="javascript:void(0);" {{on "click" (fn this.edit entity.id)}}>{{t 'global.list.edit'}}</a></li>
                    <li><a href="javascript:void(0);" {{on "click" (fn this.detail entity.id)}}>{{t 'global.list.detail'}}</a></li>
                  </ul>
                </div>
              </td>
              {{#each-in this.metaData.fields as |field definition|}}
                <td>{{field-view view='list' navigate=(fn this.detail entity.id) definition=definition model=entity field=field module=this.module}}</td>
              {{/each-in}}
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
