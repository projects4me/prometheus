<div class="row idea-page">
  <div class="col-md-8" data-idea-main>
    {{#if this.model}}
      <Idea::ConversationBox
        @idea={{this.model}}
        @messages={{this.messages}}
        @onRefresh={{this.loadMessages}}
        @onRename={{this.rename}}
        @onToggleArchive={{this.toggleArchive}}
        @onSend={{this.send}}
      />
    {{/if}}
  </div>
  <div class="col-md-4" data-idea-side>
    {{#if this.model}}
      <Idea::PlanBox @plans={{this.plans}} @onApprove={{this.approvePlan}} />
      <Idea::CreatedIssuesBox @plans={{this.plans}} @planIssues={{this.planIssues}} />
      <Idea::SummaryBox @idea={{this.model}} @messages={{this.messages}} @plans={{this.plans}} @createdUserName={{this.createdUserName}} />
    {{/if}}
  </div>
</div>
