<div class="row idea-create">
  <AccessControl @aclContext="idea.create">
    <div class="col-md-8" data-idea-main>
      <div class="box box-primary">
        <div class="box-header with-border">
          <h3 class="box-title">{{t "views.app.idea.create.title"}}</h3>
        </div>
        <div class="box-body">
          <div class="form-group">
            <div class="form-field">
              <FormFields::FieldText
                @placeholder={{t "views.app.idea.create.titlePlaceholder"}}
                @label={{t "views.app.idea.fields.title"}}
                @value={{this.model.title}}
                @data-field="idea.title"
                @validate={{action this.validateField "ideaCreate" (hash name="title" value=this.model.title)}}
                @message={{this.message.ideaCreate.title}}
                {{autofocus}}
              />
            </div>
            <div class="form-field">
              <FormFields::FieldTextArea
                @placeholder={{t "views.app.idea.create.descriptionPlaceholder"}}
                @label={{t "views.app.idea.fields.description"}}
                @value={{this.model.description}}
                @data-field="idea.description"
              />
            </div>
          </div>
        </div>
      </div>
      <AppUi::Button type="button" class="btn btn-primary" @onClick={{fn this.save "ideaCreate" "idea"}} @aclContext="idea.create" data-start-idea>{{t "views.app.idea.create.start"}}</AppUi::Button>
      <AppUi::Button type="button" class="btn btn-default" @onClick={{this.cancel}}>{{t "global.form.cancel"}}</AppUi::Button>
    </div>
    <div class="col-md-4" data-idea-side>
      <div class="box box-info">
        <div class="box-header with-border">
          <h3 class="box-title">{{t "views.app.idea.create.how.title"}}</h3>
        </div>
        <div class="box-body">
          <ol>
            <li>{{t "views.app.idea.create.how.step1"}}</li>
            <li>{{t "views.app.idea.create.how.step2"}}</li>
            <li>{{t "views.app.idea.create.how.step3"}}</li>
          </ol>
        </div>
      </div>
    </div>
  </AccessControl>
</div>
