{{#if this.model}}
  <div class="conversation-opened-container row" data-conversation-opened>
    <div class="col-md-8">
      <Conversation::ThreadBox
        @entity={{this.model}}
        @membersList={{this.layout.membersList}}
        @currentUser={{this.layout.currentUser}}
        @toggleVote={{this.layout.toggleVote}}
        @comments={{this.threadComments}}
        @votes={{this.threadVotes}}
        @onVote={{this.castVote}}
        @onLoadOlderComments={{this.loadOlderComments}}
        @onReply={{this.postComment}}
        @search={{this.layout.search}}
        @linkIssueSearch={{this.layout.linkIssueSearch}}
        @onUpdateConversation={{this.layout.updateConversation}}
      />
    </div>
    <div class="col-md-4">
      {{#if (eq this.model.roomType "vote")}}
        <Conversation::ResultBox @votes={{this.threadVotes}} @members={{this.layout.membersList}} />
      {{else}}
        <Conversation::LinkedIssueBox @issue={{this.model.issue}} />
      {{/if}}
      <Conversation::ParticipantsBox @participants={{this.participants}} />
      {{!-- Room below for the Create issue and Activity boxes --}}
    </div>
  </div>
{{/if}}
