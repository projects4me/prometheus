<div class="row idea-wrapper">
  <AccessControl @aclContext="idea.read">
    {{#unless this.browserCollapsed}}
    <div class="col-md-3">
      <div class="box box-primary idea-browser" data-idea-browser>
        <div class="box-header with-border">
          <h3 class="box-title">{{t "views.app.idea.browser.title"}}</h3>
          <div class="box-tools pull-right">
            <AccessControl @aclContext="idea.create">
              <LinkTo @route="app.project.idea.create" class="btn btn-primary btn-sm" data-new-idea>
                <i class="fa fa-plus"></i> {{t "views.app.idea.browser.new"}}
              </LinkTo>
            </AccessControl>
            <button type="button" class="btn btn-box-tool" title={{t "views.app.idea.browser.collapse"}} {{on "click" this.toggleBrowser}} data-collapse-browser>
              <i class="fa fa-angle-double-left"></i>
            </button>
          </div>
        </div>
        <div class="box-body no-padding">
          <ul class="nav nav-stacked idea-list" data-idea-list>
            {{#each this.listedIdeas as |idea|}}
              <li class={{if (eq idea.id this.selectedIdeaId) "active menu-open"}} data-idea={{idea.id}}>
                <LinkTo @route="app.project.idea.page" @model={{idea.id}}>
                  <span data-idea-title>{{idea.title}}</span>
                  {{#let (get this.progressByIdea idea.id) as |progress|}}
                    <span class="label pull-right {{progress.class}}" data-idea-status>{{t progress.label}}</span>
                  {{/let}}
                </LinkTo>
              </li>
            {{else}}
              <li class="no-entry">{{t "views.app.idea.browser.empty"}}</li>
            {{/each}}
          </ul>
        </div>
        {{#if this.archivedIdeas.length}}
          <div class="box-footer text-center">
            <button type="button" class="btn btn-link" {{on "click" this.toggleArchived}} data-toggle-archived>
              {{#if this.showArchived}}
                {{t "views.app.idea.browser.hideArchived" count=this.archivedIdeas.length}}
              {{else}}
                {{t "views.app.idea.browser.showArchived" count=this.archivedIdeas.length}}
              {{/if}}
            </button>
          </div>
        {{/if}}
      </div>
    </div>
    {{/unless}}

    <div class={{if this.browserCollapsed "col-md-12" "col-md-9"}}>
      {{#if this.browserCollapsed}}
        <div class="idea-browser-expand">
          <button type="button" class="btn btn-box-tool" title={{t "views.app.idea.browser.expand"}} {{on "click" this.toggleBrowser}} data-expand-browser>
            <i class="fa fa-angle-double-right"></i>
          </button>
        </div>
      {{/if}}
      {{outlet}}
    </div>
  </AccessControl>
</div>
