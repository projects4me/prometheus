<section class="content">
  <div class="gantt-view">
    <AppUi::GanttChart
      @milestones={{this.milestones}}
      @timelineStart={{this.timelineStart}}
      @timelineEnd={{this.timelineEnd}}
      @expandedMilestones={{this.expandedMilestones}}
      @onToggleMilestone={{this.toggleMilestone}}
      @onIssueClick={{this.openIssue}}
      @selectedIssue={{this.selectedIssue}}
      @onIssueDragEnd={{this.updateIssueDates}}
      @isMilestoneExpanded={{this.isMilestoneExpanded}}
      @onCreateDependency={{this.createDependency}}
      @onDeleteDependency={{this.deleteDependency}}
    />
  </div>
</section>
