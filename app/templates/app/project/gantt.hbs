<div class="gantt-view">
  <AppUi::GanttChart
    @milestones={{this.milestones}}
    @timelineStart={{this.timelineStart}}
    @timelineEnd={{this.timelineEnd}}
    @liveSyncRevision={{this.liveSyncRevision}}
    @expandedMilestones={{this.expandedMilestones}}
    @onToggleMilestone={{this.toggleMilestone}}
    @onIssueClick={{this.openIssue}}
    @onOpenIssuePanel={{this.openIssuePanel}}
    @selectedIssue={{this.selectedIssue}}
    @onIssueDragEnd={{this.updateIssueDates}}
    @onIssueResizeEnd={{this.updateIssueDates}}
    @isMilestoneExpanded={{this.isMilestoneExpanded}}
    @onCreateDependency={{this.createDependency}}
    @onDeleteDependency={{this.deleteDependency}}
    @isIssuePanelOpen={{this.isIssuePanelOpen}}
    @panelIssue={{this.panelIssue}}
    @onCloseIssuePanel={{this.closeIssuePanel}}
    @selectStatic={{this.selectStatic}}
    @projectController={{this.projectController}}
    @issueTypes={{this.projectController.issuetypes}}
  >
    <:search>
      {{#if this.querySchema}}
        <SavedSearch::CompactBar
          @schema={{this.querySchema}}
          @query={{this.query}}
          @savedSearches={{this.savedsearches}}
          @activeSavedSearchId={{this.searchId}}
          @relatedTo="issue"
          @projectId={{this.trackedProject.id}}
          @aclContext="issue.read"
          @onApply={{this.applyQuery}}
          @onSavedSearchChange={{this.selectSavedSearch}}
        />
      {{/if}}
    </:search>
  </AppUi::GanttChart>
</div>
