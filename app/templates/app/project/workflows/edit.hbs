<div class="row workflows-edit">
  <div class="col-md-12">
    <div class="box box-primary">
      <div class="box-header with-border">
        <h3 class="box-title">Edit Workflow: {{@model.workflow.name}}</h3>
        
        <div class="box-tools pull-right">
          {{#if this.canDesignWorkflow}}
            <button 
              type="button" 
              class="btn btn-info"
              {{on "click" this.designWorkflow}}
              data-test="design-workflow-btn">
              <i class="fa fa-sitemap"></i> Design
            </button>
          {{/if}}

          {{#if this.canMonitorWorkflow}}
            <button 
              type="button" 
              class="btn btn-default"
              {{on "click" this.viewInstances}}
              data-test="view-instances-btn">
              <i class="fa fa-list"></i> Instances
            </button>
          {{/if}}

          <div class="btn-group">
            <button 
              type="button" 
              class="btn btn-default dropdown-toggle" 
              data-toggle="dropdown" 
              aria-expanded="false"
              data-test="workflow-actions-dropdown">
              <i class="fa fa-ellipsis-v"></i>
            </button>
            <ul class="dropdown-menu" role="menu">
              <li>
                <a href="javascript:void(0);" {{on "click" this.duplicateWorkflow}} data-test="duplicate-workflow-btn">
                  <i class="fa fa-copy"></i> Duplicate
                </a>
              </li>
              {{#if this.canDeleteWorkflow}}
                <li class="divider"></li>
                <li>
                  <a href="javascript:void(0);" {{on "click" this.deleteWorkflow}} data-test="delete-workflow-btn" class="text-danger">
                    <i class="fa fa-trash"></i> Delete
                  </a>
                </li>
              {{/if}}
            </ul>
          </div>

          <button 
            type="button" 
            class="btn btn-default"
            {{on "click" this.cancelEdit}}
            data-test="cancel-edit-btn">
            <i class="fa fa-times"></i> Cancel
          </button>
        </div>
      </div>
      {{!-- /.box-header --}}
      
      <div class="box-body">
        {{#if this.errors.length}}
          <div class="alert alert-danger" data-test="error-messages">
            <h4><i class="icon fa fa-ban"></i> Error!</h4>
            <ul>
              {{#each this.errors as |error|}}
                <li data-test="error-message">{{error}}</li>
              {{/each}}
            </ul>
          </div>
        {{/if}}

        {{#if this.hasUnsavedChanges}}
          <div class="alert alert-warning" data-test="unsaved-changes-warning">
            <i class="icon fa fa-warning"></i>
            You have unsaved changes. Don't forget to save your work!
          </div>
        {{/if}}

        <div class="row">
          <div class="col-md-8">
            <Workflow::WorkflowForm 
              @workflow={{@model.workflow}}
              @project={{@model.project}}
              @isEditing={{true}}
              @isLoading={{this.isLoading}}
              @errors={{this.errors}}
              @onSave={{this.saveWorkflow}}
              @onCancel={{this.cancelEdit}}
              @onFieldChange={{this.updateField}}
              @onValidateName={{this.validateWorkflowName}}
              @canEdit={{this.canEditWorkflow}}
              data-test="workflow-edit-form" />
          </div>

          <div class="col-md-4">
            {{!-- Workflow Information Panel --}}
            <div class="box box-info">
              <div class="box-header with-border">
                <h3 class="box-title">Workflow Information</h3>
              </div>
              <div class="box-body">
                <dl class="dl-horizontal">
                  <dt>Version:</dt>
                  <dd data-test="workflow-version">{{@model.workflow.version}}</dd>
                  
                  <dt>Status:</dt>
                  <dd data-test="workflow-status">
                    {{#if @model.workflow.isActive}}
                      <span class="badge badge-success">Active</span>
                    {{else}}
                      <span class="badge badge-default">Inactive</span>
                    {{/if}}
                  </dd>
                  
                  <dt>Type:</dt>
                  <dd data-test="workflow-type">
                    {{#if @model.workflow.isSystem}}
                      <span class="badge badge-warning">System</span>
                    {{else}}
                      <span class="badge badge-primary">Custom</span>
                    {{/if}}
                  </dd>
                  
                  <dt>Instances:</dt>
                  <dd data-test="workflow-instances-count">
                    {{#if @model.workflow.workflowInstances}}
                      {{@model.workflow.workflowInstances.length}}
                    {{else}}
                      0
                    {{/if}}
                  </dd>
                  
                  <dt>Created:</dt>
                  <dd data-test="workflow-created">
                    {{format-date date=@model.workflow.dateCreated}}
                  </dd>
                  
                  <dt>Modified:</dt>
                  <dd data-test="workflow-modified">
                    {{format-date date=@model.workflow.dateModified}}
                  </dd>
                </dl>
              </div>
            </div>

            {{!-- Workflow Statistics --}}
            {{#if @model.workflow.workflowNodes}}
              <div class="box box-success">
                <div class="box-header with-border">
                  <h3 class="box-title">Workflow Statistics</h3>
                </div>
                <div class="box-body">
                  <dl class="dl-horizontal">
                    <dt>Nodes:</dt>
                    <dd data-test="workflow-nodes-count">{{@model.workflow.workflowNodes.length}}</dd>
                    
                    <dt>Transitions:</dt>
                    <dd data-test="workflow-transitions-count">
                      {{#if @model.workflow.workflowTransitions}}
                        {{@model.workflow.workflowTransitions.length}}
                      {{else}}
                        0
                      {{/if}}
                    </dd>
                    
                    <dt>Rules:</dt>
                    <dd data-test="workflow-rules-count">
                      {{#if @model.workflow.workflowRules}}
                        {{@model.workflow.workflowRules.length}}
                      {{else}}
                        0
                      {{/if}}
                    </dd>
                  </dl>
                </div>
              </div>
            {{/if}}

            {{!-- Quick Actions --}}
            <div class="box box-default">
              <div class="box-header with-border">
                <h3 class="box-title">Quick Actions</h3>
              </div>
              <div class="box-body">
                <div class="btn-group-vertical btn-block">
                  {{#if this.canDesignWorkflow}}
                    <button 
                      type="button" 
                      class="btn btn-info"
                      {{on "click" this.designWorkflow}}
                      data-test="quick-design-btn">
                      <i class="fa fa-sitemap"></i> Open Designer
                    </button>
                  {{/if}}

                  {{#if this.canMonitorWorkflow}}
                    <button 
                      type="button" 
                      class="btn btn-default"
                      {{on "click" this.viewInstances}}
                      data-test="quick-instances-btn">
                      <i class="fa fa-list"></i> View Instances
                    </button>
                  {{/if}}

                  <button 
                    type="button" 
                    class="btn btn-default"
                    {{on "click" this.duplicateWorkflow}}
                    data-test="quick-duplicate-btn">
                    <i class="fa fa-copy"></i> Duplicate Workflow
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{!-- /.box-body --}}
    </div>
    {{!-- /.box --}}
  </div>
  {{!-- /.col --}}
</div>
{{!-- /.row --}}
