<div class="row workflows-create">
  <div class="col-md-12">
    <div class="box box-primary">
      <div class="box-header with-border">
        <h3 class="box-title">Create New Workflow</h3>
        
        <div class="box-tools pull-right">
          <button 
            type="button" 
            class="btn btn-default"
            {{on "click" this.cancelCreate}}
            data-test="cancel-create-btn">
            <i class="fa fa-times"></i> Cancel
          </button>
        </div>
      </div>
      {{!-- /.box-header --}}
      
      <div class="box-body">
        {{#if this.errors.length}}
          <div class="alert alert-danger" data-test="error-messages">
            <h4><i class="icon fa fa-ban"></i> Error!</h4>
            <ul>
              {{#each this.errors as |error|}}
                <li data-test="error-message">{{error}}</li>
              {{/each}}
            </ul>
          </div>
        {{/if}}

        <Workflow::WorkflowForm 
          @workflow={{@model.workflow}}
          @project={{@model.project}}
          @isEditing={{false}}
          @isLoading={{this.isLoading}}
          @errors={{this.errors}}
          @onSave={{this.saveWorkflow}}
          @onCancel={{this.cancelCreate}}
          @onFieldChange={{this.updateField}}
          @onValidateName={{this.validateWorkflowName}}
          @canEdit={{this.canCreateWorkflow}}
          data-test="workflow-create-form" />
      </div>
      {{!-- /.box-body --}}
    </div>
    {{!-- /.box --}}
  </div>
  {{!-- /.col --}}
</div>
{{!-- /.row --}}
