{{#if this.model}}
  <AccessControl @aclContext="wiki.read">
    <div class="wiki-detail box box-primary">
      <div class="box-header with-border">
        {{#if (eq this.model.createdUser this.currentUser.user.id)}}
          {{#if (eq this.model.locked "0")}}
            <a href="javascript:void(0);" {{on "click" (fn this.lockWiki "unlock")}}>
              <AppUi::Icon @name="unlock" class="lock" @label={{t "views.app.wiki.lock"}} {{tooltip (t "views.app.wiki.lock")}} />
            </a>
          {{else}}
            <a href="javascript:void(0);" {{on "click" (fn this.lockWiki "lock")}}>
              <AppUi::Icon @name="lock" class="lock" @label={{t "views.app.wiki.unlock"}} {{tooltip (t "views.app.wiki.unlock")}} />
            </a>
          {{/if}}
        {{else}}
          {{#if (eq this.model.locked "0")}}<AppUi::Icon @name="unlock" class="disabled" />{{else}}<AppUi::Icon @name="lock" class="disabled" />{{/if}}
        {{/if}}
        <h2 class="box-title">{{this.model.name}} - </h2>
        {{#if this.model.parentId}}
          {{#if this.wikiList}}
            <a href="javascript:void(0);" {{on "click" (fn this.loadWiki this.model.projectId (get-wiki this.model this.wikiList))}}>{{get-wiki this.model this.wikiList}}</a>
          {{/if}}
        {{/if}}
        <span class="path-seperator"></span> {{this.model.name}}
        <span class="wiki-upvotes">
          {{this.model.vote.length}}
          {{#if this.iVoted}}
            <AppUi::Icon @name="heart" @label={{t "views.app.wiki.voted"}} {{tooltip (t "views.app.wiki.voted")}} />
          {{else}}
            <a href="javascript:void(0);" {{on "click" (fn this.upvote this.model.id)}}>
              <AppUi::Icon @name="heart-o" @label={{t "views.app.wiki.upvote"}} {{tooltip (t "views.app.wiki.upvote")}} />
            </a>
          {{/if}}
        </span>
        <div class="box-tools pull-right">
          <span class="modified-by">{{t "global.form.modified" user=this.model.modifiedUserName date=(format-date date=this.model.dateModified format='MMM Do \'YY, h:mm a')}}</span>
        </div>

      </div>
      {{!-- /.box-header --}}

      <div class="box-body">

        <div class="wiki-page-contents ql-container ql-snow">
          <div class="note-editor wiki-default-page">
            {{safe-html this.model.markUp}}
          </div>
        </div>
      </div>

      {{!-- /.box-body --}}

      <div class="box-footer">
        {{#if (eq this.model.locked "0")}}
          <AppUi::Button type="button" class="btn btn-primary" @onClick={{this.edit}} @aclContext="wiki.update"><AppUi::Icon @name="pencil" /> {{t "global.form.edit"}}</AppUi::Button>
          <AppUi::Button type="button" class="btn btn-default" @onClick={{this.delete}} @aclContext="wiki.delete"><AppUi::Icon @name="trash" /> {{t "global.form.delete"}}</AppUi::Button>
        {{/if}}

        <div class="pull-right">
          {{t "views.app.wiki.tags"}}<span class="colon"></span>
          {{#if this.model.tag.length}}
            {{#each this.model.tag as |tags|}}
              <span class="label label-primary"><AppUi::Icon @name="tag" /> {{tags.tag}}</span>
            {{/each}}
          {{else}}
            <span class="disabled-text">{{t "global.noentry"}}</span>
          {{/if}}
        </div>

      </div>
    </div>
  </AccessControl>

  <div class="clearfix"></div>

  <AccessControl @aclContext="wiki.read">
    {{!-- Issue Files--}}
    <div class="box box-info wiki-files-section">

      <div class="box-header with-border">

        <h3 class="box-title">{{t "views.app.wiki.page.files"}}</h3>

        <div class="box-tools pull-right">
        </div>

      </div>

      <div class="box-body no-padding">

        <div class="box-footer">
          <ul class="attachments clearfix">
            {{#each this.model.files as |file|}}
              <li>
                {{#if (not-eq file.fileThumbnail '0')}}
                  <span class="attachment-icon has-img">
                    <img src="{{file.fileThumbnail}}" alt="{{file.name}}"s>
                  </span>
                {{else}}
                  <AppLayouts::AttachmentIcon @mime={{file.fileMime}}/>
                {{/if}}
                <div class="attachment-info">
                  <div class="attachment-name clearfix">
                    <a href="#" {{on "click" (prevent-default this.previewFile file)}}><AppUi::Icon @name="paperclip" /><span class="attachment-file-name">{{file.name}}</span></a>
                  </div>
                  <div class="attachment-additional">
                    <span class="attachment-size">
                      {{file-size file.fileSize}}
                      <a href="#" {{on "click" (prevent-default this.deleteFile file)}} class="btn btn-default btn-xs pull-right"><AppUi::Icon @name="trash-o" /></a>
                      <a href="#" {{on "click" (prevent-default this.downloadFile file)}} class="btn btn-default btn-xs pull-right"><AppUi::Icon @name="cloud-download" /></a>
                    </span>
                  </div>
                </div>
              </li>
            {{/each}}
          </ul>
          <div class="filePreviewModal">
            {{#if this.filePreviewDialog}}
              <AppUi::Modal
                  @title="views.app.wiki.page.file.preview"
                  @closeLabel="global.form.close"
                  @onClose={{this.removeModal}}>
                <iframe title="{{t "views.app.wiki.page.file.preview"}}" id="file_preview"></iframe>
              </AppUi::Modal>
            {{/if}}
          </div>

        </div>
        <FormFields::FieldUpload
            @label={{t "views.app.wiki.page.selectfile"}}
            @uploadFile={{this.uploadFile}}
        />

      </div>
    </div>
  </AccessControl>

{{else}}
  <div class="wiki-page-empty">

    <div class="callout callout-danger">
      <h4>
        <AppUi::Icon @name="exclamation-triangle" /> {{t "views.app.wiki.notfound"}}
      </h4>
      {{t "views.app.wiki.page.empty"}}
    </div>
  </div>

{{/if}}
