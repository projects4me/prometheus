<div class="wiki-page-body">
  <div class="wiki-page-empty">
    <div class="wiki-no-home">
      <AppUi::Icon @name="file-text-o" />
      <div class="clearfix"></div>
      <h3>{{t "views.app.wiki.welcome"}}</h3>
      <div class="clearfix"></div>
      {{safe-html (t "views.app.wiki.nohome")}}
      <div class="clearfix"></div>
      <a href="#" class="btn btn-primary margin-bottom" {{on "click" (prevent-default this.create)}}><AppUi::Icon @name="plus" /> {{t "views.app.wiki.create.page"}}</a>
    </div>
  </div>
</div>
