<div class="board row">

  {{!-- Board panel: full width when no issue open, col-8 expanded, or collapsed strip --}}
  <div class={{this.boardColumnClass}}>

    {{#if (and this.selectedIssue this.isBoardCollapsed)}}
      <div class="board-collapsed-strip" role="button" {{on "click" this.toggleBoardCollapse}} title={{t "views.app.board.expandBoard"}}>
        <i class="fa fa-chevron-right board-strip-icon"></i>
        <span class="board-strip-label">{{t "views.app.board.taskBoard"}}</span>
      </div>

    {{else}}
      {{#if this.selectedIssue}}
        <button
          class="board-collapse-btn"
          type="button"
          title={{t "views.app.board.collapseBoard"}}
          {{on "click" this.toggleBoardCollapse}}
        >
          <i class="fa fa-chevron-left"></i>
        </button>
      {{/if}}

      <AppUi::TaskBoard
        @milestones={{this.milestoneList}}
        @statuses={{this.statuses}}
        @statusClass={{this.statusClass}}
        @backlog={{this.backlog}}
        @group="milestones"
        @scroll={{true}}
        @scrollSensitivity={{200}}
        @scrollSpeed={{10}}
        @sort={{true}}
        @forceFallback={{true}}
        @disableSortable={{false}}
        @dragClass="curr-item"
        @chosenClass="curr-item"
        @updateIssue={{this.updateIssue}}
        @openIssue={{this.openIssue}}
        @selectIssue={{this.selectIssue}}
        @savedSearches={{this.savedSearches}}
        @applySearch={{this.applySearch}}
        @paramsQuery={{this.query}}
        @selectedSearchId={{this.searchId}}
        @validateField={{this.validateField}}
        @selectStatic={{this.selectStatic}}
        @selectRelated={{this.selectRelated}}
        @issueTypes={{this.projectController.issuetypes}}
        @save={{this.save}}
        @message={{this.message}}
        @membersList={{this.projectController.membersList}}
        @search={{this.search}}
        @markMilestoneAsComplete={{this.markMilestoneAsComplete}}
        @getMilestoneProgress={{this.getMilestoneProgress}}
        @getCompletedIssuesCount={{this.getCompletedIssuesCount}}
      />
    {{/if}}

  </div>

  {{!-- Issue detail panel --}}
  {{#if this.selectedIssue}}
    <div class="{{this.issueColumnClass}} issue-details-container">
      {{#if this.isLoadingIssueDetails}}
        <div class="box box-primary">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.board.issue.loading"}}</h3>
          </div>
          <div class="box-body flex-row flex-jc-c flex-ai-c">
            <div class="dot-pulse"></div>
          </div>
        </div>
      {{else if this.selectedIssueDetails}}
        <div class="box">
          <div class="box-body {{if this.isBoardCollapsed "box-body--board-collapsed"}}">
            <Issue::IssueDetails
              @issue={{this.selectedIssueDetails}}
              @activities={{null}}
              @selectStatic={{this.selectStatic}}
              @projectController={{this}}
              @issueTypes={{this.issueTypes}}
              @s_id={{null}}
              @projectController={{this.projectController}}
              @scrollAndHighlight={{this.scrollAndHighlight}}
              @quickView={{not this.isBoardCollapsed}}
              @closeIssueDetails={{this.closeIssueDetails}}
              @postUpdateAssignee={{this.postUpdateAssignee}}
            />
          </div>
        </div>
      {{/if}}
    </div>
  {{/if}}

</div>