<div class="row issues">
  <div class="col-md-{{if this.selectedIssue '8' '12'}}">

    <div class="box box-primary list-view">
      <div class="box-header with-border">
        <div class="search">
          {{!-- Saved Searches Dropdown --}}
          <AppUi::Dropdown @isPrimary={{true}}>
            <:button>
              {{t "views.app.issue.list.savedsearch.label"}}
            </:button>
            <:content>
              {{#each this.savedsearches as |search|}}
                <div {{on "click" (fn this.toggleSearch search)}} class="{{if (call (fn this.isSearchActive search)) 'active' ''}}">
                  {{search.name}}
                  {{#if (call (fn this.isSearchActive search))}}
                    <i class="fa fa-check pull-right"></i>
                  {{/if}}
                </div>
              {{/each}}
            </:content>
          </AppUi::Dropdown>
          {{!-- End Saved Searches Dropdown --}}             
          <div class="has-feedback">
            <FormFields::FieldText
              data-toggle="collapse"
              data-target=".list-view-filters"
              @focusIn={{fn this.openFilters}}
              @insert-newline={{this.filter}}
              @value={{this.query}}
              @name="query"
              @readonly="readonly"
              @placeholder={{concat (t "global.form.search") " " (t "global.module.plural.issue") " .."}}
              @aclContext="App.Project.Issue.List.SearchIssue"
            />
            <span class="glyphicon glyphicon-search form-control-feedback"></span>
          </div>
          <AppUi::Button type="button" class="btn btn-primary" @onClick={{this.searchByRules}}  @aclContext="App.Project.Issue.Read">{{t "global.form.search"}}</AppUi::Button>
          <AppUi::Button type="button" class="btn" @onClick={{this.clearSearch}}>{{t "global.form.clear"}}</AppUi::Button>
                 
        </div>
        <div class="list-view-filters collapse">
          {{query-builder module="issue" query=this.query}}
          <AppUi::Button type="button" class="btn btn-primary pull-right" @onClick={{this.showSaveSearchDialog}} @aclContext="App.Project.Issue.List.SavedSearch.Create">{{t "global.form.savesearch"}}</AppUi::Button>
          {{#if this.saveSearchDialog}}
            {{#bootstrap-modal
                title="global.form.savesearch"
                confirmLabel="global.form.save"
                closeLabel="global.form.cancel"
                confirm=(action "saveSearch")
                close="removeSaveSearchDialog"}}

              <div class="ember-view">
                <label>{{t "views.app.issue.list.savedsearch.query"}}</label>
                <span>{{this.query}}</span>
              </div>

              <FormFields::FieldText
                @placeholder={{t "views.app.issue.list.savedsearch.inputname"}}
                @label={{t "views.app.issue.list.savedsearch.name"}}
                @value={{this.newSavedsearch.name}}
                @aclContext="App.Project.Issue.List.SavedSearch.Create.Name"
              />

            {{/bootstrap-modal}}
          {{/if}}

        </div>

      </div>
      {{!-- /.box-header --}}
      <div class="box-body no-padding">
        <div class="list-controls">

          <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
            <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContext="App.Project.Issue.List.SelectAllIssues"/>
          </span>
          <div class="btn-group">
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="App.Project.Issue.Delete"><i class="fa fa-trash-o"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.massupdate"}}" @onClick={{this.showMassUpdateDialog}} @aclContext="App.Project.Issue.Edit"><i class="fa fa-pencil"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.export"}}" @onClick={{this.showExportDialog}}><i class="fa fa-download"></i></AppUi::Button>
          </div>
          <div class="pull-right">
            <span class="list-view-count">{{t "views.app.issue.list.selectedCount" count=this.checkboxCount}}</span>
            {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
            {{#if this.model.meta.links.next}}+{{/if}}
            <div class="btn-group">
              {{#if this.model.meta.links.prev}}
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="App.Project.Issue.Read"><i class="fa fa-chevron-left"></i></AppUi::Button>
              {{else}}
                <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}}"><i class="fa fa-chevron-left"></i></AppUi::Button>
              {{/if}}
              {{#if this.model.meta.links.next}}
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="App.Project.Issue.Read"><i class="fa fa-chevron-right"></i></AppUi::Button>
              {{else}}
                <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
              {{/if}}
            </div>

          </div>
        </div>

        <div class="table-responsive issue-list">
          <table class="table table-hover table-striped">
            <thead>
              <tr>
                <th class="select-box"></th>
                <th data-sort="Issue.issueNumber">{{t "views.app.issue.list.overview"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Issue.issueNumber')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                <th data-sort="Issue.assignee">{{t "views.app.issue.list.assignee"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Issue.assignee')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                <th data-sort="issuetype.name">{{t "views.app.issue.list.issuetype"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'issuetype.name')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                <th data-sort="issuemilestone.name">{{t "views.app.issue.list.milestone"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'issuemilestone.name')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                <th data-sort="Issue.startDate">{{t "views.app.issue.list.startDate"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Issue.startDate')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                <th data-sort="Issue.endDate">{{t "views.app.issue.list.endDate"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Issue.endDate')}}><i class="fa fa-sort"></i></AppUi::Button></th>                
              </tr>
            </thead>

            <tbody>
              {{#if this.model.length}}
                {{#each this.model as |issue|}}
                  <tr class="issue" data-issue-id={{issue.id}}>
                    <td class="select-box">
                      <FormFields::FieldCheckbox @select={{action this.select}} @data-select={{issue.id}} @aclContext="App.Project.Issue.List.SelectIssue"/>
                    </td>
                    <td class="issue-overview">
                      <li class="issue-block-container">
                        <div class="issue-block">
                          <div data-field="issue.priority" data-toggle="tooltip" data-priority="{{issue.priority}}" title="{{t (concat "views.app.issue.lists.priority." issue.priority)}}" class="priority"><AppUi::PriorityIcon @priority={{issue.priority}}/></div>
                          <div class="data-block">
                            <span class="subject"><LinkTo data-field="issue.number" @route="app.project.issue.page" @disabledClass="navigate-issue-quick-view" @disabled={{true}} @model={{issue.issueNumber}} {{on "click" (fn this.selectIssue issue)}}>{{issue.issueNumber}}</LinkTo> - <span data-field="issue.subject"> {{issue.subject}} </span></span>
                            <span data-field="issue.status" class="badge {{issue.status}}">{{t (concat "views.app.issue.lists.status." issue.status)}}</span>
                          </div>
                        </div>
                      </li>
                    </td>
                    <td class="issue-assignee">
                      <span><img class="img-circle user-img" src="{{this.apiHost}}/userimage/get/{{issue.assignedTo.id}}" alt="{{issue.assignedTo.name}}" title="{{issue.assignedTo.name}}"></span>
                      <span data-field="issue.assignee">{{issue.assignedTo.name}}</span>
                    </td>
                    <td data-field="issuetype.name" class="issue-type">{{issue.issuetype.name}}</td>
                    <td data-field="issue.milestone" class="issue-milestone"><a href="#">{{issue.issuemilestone.name}}</a></td>
                    <td data-field="issue.startDate" class="issue-start">{{format-date date=issue.startDate}}</td>
                    <td data-field="issue.endDate" class="issue-end">{{format-date date=issue.endDate}}</td>
                    <td class="pull-right list-item-actions">
                      <div class="btn-group">
                        {{!-- Conversation Button --}}
                        {{#if issue.conversationRoomId}}
                          <AppUi::Button type="button" class="btn btn-box-tool" data-toggle="tooltip" title="{{t "views.app.issue.list.openConversation"}}">
                            <LinkTo @route="app.project.conversation" @query={{hash c_id=issue.conversationRoomId}}>
                              <i class="fa fa-comments-o"></i>
                            </LinkTo>
                          </AppUi::Button>
                        {{else}}
                          <AppUi::Button {{on "click" (fn this.routeToIssueComments issue)}} type="button" class="btn btn-box-tool btn-comment-add" data-toggle="tooltip" title="{{t "views.app.issue.list.startConversation"}}">
                            <i class="fa fa-plus fa-comments-plus"></i>
                            <i class="fa fa-comments-o"></i>
                          </AppUi::Button>
                        {{/if}}  

                        {{!-- More Actions Button --}}
                        <AppUi::Button type="button" class="btn btn-box-tool dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                          <i class="fa fa-ellipsis-v"></i>
                        </AppUi::Button>

                        {{!-- More Actions Dropdown --}}
                        <ul class="dropdown-menu" role="menu">
                          <li>
                            <AppUi::Button data-btn="delete" type="button" @onClick={{fn this.deleteModel issue "issueNumber"}} class="btn btn-box-tool" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="App.Project.Issue.Delete">
                              <i class="fa fa-trash"></i> {{t "global.form.delete"}}
                            </AppUi::Button>
                          </li>
                        </ul>
                      </div>
                    </td>                    
                  </tr>
                {{/each}}
              {{else}}
              <tr>
                <td colspan="100%">
                  <Exceptions::NothingFound 
                    @description={{t "views.app.user.page.latestIssues.noIssues"}}
                  />
                </td>
              </tr>
              {{/if}}
            </tbody>
          </table>
          {{!-- /.table --}}
        </div>

      </div>
      {{!-- /.box-body --}}
      <div class="box-footer no-padding">
        <div class="list-controls">

          <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
            <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContext="App.Project.Issue.List.SelectAllIssues"/>
          </span>
          <div class="btn-group">
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="App.Project.Issue.Delete"><i class="fa fa-trash-o"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.share"}}"><i class="fa fa-share-alt"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-btn="mass-update-issues" title="{{t "global.form.massupdate"}}" @onClick={{this.showMassUpdateDialog}} @aclContext="App.Project.Issue.Edit"><i class="fa fa-pencil"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.discuss"}}"><i class="fa fa-comments-o"></i></AppUi::Button>
            <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.export"}}" @onClick={{this.showExportDialog}}><i class="fa fa-download"></i></AppUi::Button>
          </div>
          <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.refresh"}}" @onClick={{this.reloadPage}} @aclContext="App.Project.Issue.List.ReloadPage"><i class="fa fa-refresh"></i></AppUi::Button>
          <div class="pull-right">
            <span class="list-view-count">{{t "views.app.issue.list.selectedCount" count=this.checkboxCount}}</span>
            {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
            {{#if this.model.meta.links.next}}+{{/if}}
            <div class="btn-group">
              {{#if this.model.meta.links.prev}}
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="App.Project.Issue.Read"><i class="fa fa-chevron-left"></i></AppUi::Button>
              {{else}}
                <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}}"><i class="fa fa-chevron-left"></i></AppUi::Button>
              {{/if}}
              {{#if this.model.meta.links.next}}
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="App.Project.Issue.Read"><i class="fa fa-chevron-right"></i></AppUi::Button>
              {{else}}
                <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
              {{/if}}
            </div>
          </div>

        </div>
      </div>
    </div>
    {{!-- /. box --}}
  </div>
  {{!-- /.col --}}

  {{#if this.selectedIssue}}
    <div class="col-md-4 issue-details-container">
      {{#if this.isLoadingIssueDetails}}
        <div class="box box-primary">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.board.issue.loading"}}</h3>
          </div>
          <div class="box-body flex-row flex-jc-c flex-ai-c">
            <div class="dot-pulse"></div>
          </div>
        </div>
      {{else if this.selectedIssueDetails}}
        <div class="box">
          <div class="box-body">
            <Issue::IssueDetails 
              @issue={{this.selectedIssueDetails}}
              @activities={{null}}
              @selectStatic={{this.selectStatic}}
              @projectController={{this.projectController}}
              @issueTypes={{this.issueTypes}}
              @issueStatuses={{this.issueStatuses}}
              @s_id={{null}}
              @scrollAndHighlight={{this.scrollAndHighlight}}
              @quickView={{true}}
              @closeIssueDetails={{this.closeIssueDetails}}
            />
          </div>
        </div>
      {{/if}}
    </div>
  {{/if}}

    {{!-- Modals --}}
  {{#if this.exportDialog}}
    {{#bootstrap-modal
        title="global.form.export"
        confirmLabel="global.form.export"
        closeLabel="global.form.cancel"
        confirm=(action "exportModules")
        close=(action "removeExportDialog")}}
        
        <div class="form-group">
          <FormFields::FieldRelateMulti
            @options={{get-relationships "issue" this.store}}
            @placeholder={{t "views.app.module.list.export.selectRelationship.placeholder"}}
            @selected={{this.exportRelationships}}
            @onchange={{fn this.selectStatic this 'exportRelationships'}}
            @relateType="relate-simple"
            @label={{t "views.app.module.list.export.selectRelationship.label" moduleName=(lowercase (t "global.module.plural.issue"))}}
            @aclContext="App.Project.Export.Relationships"
            @closeOnSelect={{false}}
          />
        </div>
    {{/bootstrap-modal}}
  {{/if}}
  {{#if this.massUpdateDialog}}
    {{#bootstrap-modal
        title="global.form.massupdate"
        confirmLabel="global.form.save"
        closeLabel="global.form.cancel"
        confirm=(action "massUpdateIssue")
        close=(action "removeMassUpdateDialog")}}

        <div class="form-group">
          <FormFields::FieldRelate
            @placeholder={{t "views.app.issue.create.status"}}
            @label={{t "views.app.issue.create.status"}}
            @value={{this.massUpdateModel.statusId}}
            @options={{this.statusOptions}}
            @selected={{find-by "value" this.massUpdateModel.statusId this.statusOptions}}
            @searchField="label"
            @onchange={{action "selectRelated" this.massUpdateModel 'statusId'}}
            @relateType="relate-simple"
            @data-field="issue.status"
            @aclContext="App.Project.Issue.Create.Status"
          />

          <FormFields::FieldRelate
            @placeholder={{t "views.app.issue.create.priority"}}
            @label={{t "views.app.issue.create.priority"}}
            @value={{this.massUpdateModel.priority}}
            @options={{this.priorityOptions}}
            @selected={{find-by "value" this.massUpdateModel.priority this.priorityOptions}}
            @searchField="label"
            @onchange={{action "selectRelated" this.massUpdateModel 'priority'}}
            @relateType="relate-issuepriority"
            @data-field="issue.priority"
            @aclContext="App.Project.Issue.Create.Priority"
          />

          <FormFields::FieldRelate
            @placeholder={{t "views.app.issue.create.selectmilestone"}}
            @label={{t "views.app.issue.create.milestone"}}
            @value={{this.massUpdateModel.milestoneId}}
            @options={{this.milestoneOptions}}
            @selected={{find-by "value" this.massUpdateModel.milestoneId this.milestoneOptions}}
            @searchField="label"
            @onchange={{action "selectRelated" this.massUpdateModel 'milestoneId'}}
            @relateType="relate-simple"
            @data-field="issue.milestone"
            @aclContext="App.Project.Issue.Create.Milestone"
          />          
        </div>
     {{/bootstrap-modal}}
  {{/if}}
  {{!-- /.col --}}
</div>
