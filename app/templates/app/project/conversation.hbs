  <div class="row conversation-wrapper">
    <AccessControl @aclContext="conversationroom.read">
      <div class="col-md-3">
        <QuickList
          @title={{t "views.app.conversation.browser.title"}}
          @items={{this.listedConversations}}
          @hasNext={{this.hasNext}}
          @isLoading={{this.isListLoading}}
          @error={{this.listError}}
          @onRetry={{this.refreshList}}
          @activeId={{this.selectedConversationId}}
          @page={{this.page}}
          @limit={{this.pageSize}}
          @onPage={{this.changePage}}
          @sortOptions={{this.sortOptions}}
          @sort={{this.sort}}
          @order={{this.listOrder}}
          @onSort={{this.sortList}}
          @groupOptions={{this.groupOptions}}
          @groupBy={{this.group}}
          @onGroup={{this.groupList}}
          data-conversation-browser
        >
          <:actions>
            <AccessControl @aclContext="conversationroom.create">
              <button type="button" class="btn btn-primary btn-sm" {{on "click" this.showDialog}} data-btn="addConversation">
                <i class="fa fa-plus"></i> {{t "views.app.conversation.browser.new"}}
              </button>
            </AccessControl>
          </:actions>
          <:search>
            {{#if this.querySchema}}
              <div class="box-body" data-conversation-search>
                <EzSearchCompact
                  @schema={{this.querySchema}}
                  @query={{this.query}}
                  @savedSearches={{this.ezSavedSearches}}
                  @activeSavedSearchId={{this.searchId}}
                  @onSavedSearchChange={{this.selectSavedSearch}}
                  @onApply={{this.applyQuery}}
                  @onSave={{this.showEzSaveSearchDialog}}
                  @onUpdateSavedSearch={{this.updateEzSavedSearch}}
                  @aclContext="conversationroom.read"
                />
              </div>
            {{/if}}
          </:search>
          <:item as |conversation Item|>
            <Item @route="app.project.conversation.page" @model={{conversation.id}} @query={{this.linkQuery}} data-conversation={{conversation.id}}>
              <:leading>
                <i class="fa {{if (eq conversation.roomType "vote") "fa-thumbs-o-up" "fa-comment-o"}}" data-conversation-type={{conversation.roomType}}></i>
              </:leading>
              <:primary>
                <span data-conversation-subject>{{conversation.subject}}</span>
              </:primary>
              <:secondary>
                {{#if (eq conversation.roomType "discussion")}}
                  {{#if conversation.issue.issueNumber}}
                    <span data-conversation-issue>#{{conversation.issue.issueNumber}} · {{conversation.issue.subject}}</span><br>
                  {{/if}}
                {{/if}}
                {{if conversation.createdBy.name conversation.createdBy.name (t "views.app.conversation.browser.unknownUser")}} · {{format-date-time date=conversation.dateModified humanize=true}}
                {{#let (get this.threadCounts.byRoom conversation.id) as |counts|}}
                  {{#if counts}}
                    <br>
                    {{#if (eq conversation.roomType "vote")}}
                      <span data-conversation-votes>{{t "views.app.conversation.browser.votes" agree=counts.agreeCount disagree=counts.disagreeCount}}</span>
                    {{else}}
                      <span data-conversation-comments><i class="fa fa-comment-o"></i> {{counts.commentCount}}</span>
                    {{/if}}
                  {{/if}}
                {{/let}}
              </:secondary>
            </Item>
          </:item>
          <:empty>
            <p class="quick-list__state quick-list__state--empty" data-test-quick-list-empty>
              <i class="fa fa-info-circle"></i> {{t "views.app.conversation.browser.empty"}}
              {{#if this.isSearching}}
                <button type="button" class="btn btn-link quick-list__state-action" {{on "click" this.clearListSearch}} data-test-quick-list-clear-search>
                  {{t "components.quickList.clearSearch"}}
                </button>
              {{/if}}
            </p>
          </:empty>
        </QuickList>
        {{#if this.saveSearchDialog}}
          {{#bootstrap-modal
              title="global.form.savesearch"
              confirmLabel="global.form.save"
              closeLabel="global.form.cancel"
              confirm=this.saveEzSearch
              close=this.removeSaveSearchDialog}}

            <div class="ember-view">
              <label>{{t "views.app.issue.list.savedsearch.query"}}</label>
              <span data-save-search-query>{{this.saveSearchQuery}}</span>
            </div>

            <FormFields::FieldText
              @placeholder={{t "views.app.issue.list.savedsearch.inputname"}}
              @label={{t "views.app.issue.list.savedsearch.name"}}
              @value={{this.newSavedsearch.name}}
            />

          {{/bootstrap-modal}}
        {{/if}}
      </div>

      <div class="col-md-9">
        {{outlet}}
      </div>
    </AccessControl>
  </div>

  {{#if this.addConversationDialog}}
      {{#bootstrap-modal
        title="views.app.conversation.create"
        confirmLabel="global.form.save"
        closeLabel="global.form.cancel"
        confirm=this.addConversation
        close=this.removeModal}}
        <div class="box-body">
          <FormFields::FieldText
              @placeholder={{t "views.app.conversation.new.subject"}}
              @label={{t "views.app.conversation.new.subject"}}
              @value={{this.newConversation.subject}}
              @mask="alphanumeric"
              @data-field="newConversation.subject"
              @focus-out={{fn (mut this.showSubjectError) true}}
              @v-focus={{this.showSubjectError}}
              @v-model={{this.newConversation}}
              @v-field='subject'
              @v-output='message'
              @aclContext='conversationroom.create'
          />

          <div data-field="newConversation.description" class="form-field ember-view">
            <AppUi::ToastUi
                @usersList={{this.membersList}}
                @contents={{readonly this.newConversation.description}}
                @initialValue={{this.newConversation.description}}
                @editType='wysiwyg'
                @hide={{array 'footer'}}
                @onContentChange={{fn (mut this.newConversation.description)}}
            />
            <span class="highlight"></span>
            <span class="bar"></span>
            <FormFields::Label
              @label={{t "views.app.conversation.new.description"}}
              @data-field="newConversation.description"
            />
            <span class="count pull-right"></span>
          </div>

          <FormFields::FieldRelate
              @placeholder={{t "views.app.conversation.new.type"}}
              @label={{t "views.app.conversation.new.type"}}
              @value={{this.newConversation.roomType}}
              @options={{this.roomTypes}}
              @selected={{find-by "value" this.newConversation.roomType this.roomTypes}}
              @searchField="label"
              @onchange={{this.selectNewType}}
              @relateType="relate-simple"
              @data-field="newConversation.roomType"
              @focus-out={{fn (mut this.showTypeError) true}}
              @v-focus={{this.showTypeError}}
              @v-model={{this.newConversation}}
              @v-field='roomType'
              @v-output='message'
              @aclContext='conversationroom.create'
          />

          <FormFields::FieldRelate
              @placeholder={{t "views.app.conversation.linkIssuePlaceholder"}}
              @label={{t "views.app.conversation.linkIssue"}}
              @search={{perform this.linkIssueSearch}}
              @searchEnabled={{true}}
              @selected={{this.newConversationLinkedIssue}}
              @onchange={{this.setNewConversationLinkedIssue}}
              @disabled={{not (eq this.newConversation.roomType "discussion")}}
              @allowClear={{true}}
              @relateType="relate-issue"
              @data-field="conversation.linkedIssue"
              @aclContext='conversationroom.create'
          />

        </div>
      {{/bootstrap-modal}}

    {{/if}}
