<section class="content-header">
  <h1>
    {{t "global.module.plural.project"}}
  </h1>
  <BreadCrumb/>
</section>


<section class="content">
  <div class="row module projects project">
    <div class="col-md-12">

      <AccessControl @aclContext="App.Project.List">
        <div class="box box-primary list-view">
          <div class="box-header with-border">

            <div class="search">
              {{!-- Saved Searches Dropdown --}}
              <AppUi::Dropdown @isPrimary={{true}}>
                <:button>
                  {{t "views.app.project.list.savedsearch.label"}}
                </:button>
                <:content>
                  {{#each this.savedsearches as |search|}}
                    <div {{on "click" (fn this.toggleSearch search)}} class="{{if (call (fn this.isSearchActive search)) 'active' ''}}">
                      {{search.name}}
                      {{#if (call (fn this.isSearchActive search))}}
                        <i class="fa fa-check pull-right"></i>
                      {{/if}}
                    </div>
                  {{/each}}
                </:content>
              </AppUi::Dropdown>
              {{!-- End Saved Searches Dropdown --}}
              <div class="has-feedback">
                <FormFields::FieldText
                  data-toggle="collapse"
                  data-target=".list-view-filters"
                  @focusIn={{fn this.openFilters}}
                  @insert-newline={{this.filter}}
                  @value={{this.query}}
                  @name="query"
                  @readonly="readonly"
                  @placeholder={{concat (t "global.form.search") " " (t "global.module.plural.project") " .."}}
                  @aclContext="App.Project.List.SearchProject"
                />
                <span class="glyphicon glyphicon-search form-control-feedback"></span>
              </div>
              <AppUi::Button type="button" class="btn btn-primary" @onClick={{this.searchByRules}} @aclContext="App.Project.Read">{{t "global.form.search"}}</AppUi::Button>
              <AppUi::Button type="button" class="btn" @onClick={{this.clearSearch}}>{{t "global.form.clear"}}</AppUi::Button>
            </div>
            <div class="list-view-filters collapse">
              {{query-builder module="project" query=this.query}}
              <AppUi::Button type="button" class="btn btn-primary pull-right" @onClick={{this.showSaveSearchDialog}} @aclContext="App.Project.List.SavedSearch.Create">{{t "global.form.savesearch"}}</AppUi::Button>
              {{#if this.saveSearchDialog}}
                {{#bootstrap-modal
                    title="global.form.savesearch"
                    confirmLabel="global.form.save"
                    closeLabel="global.form.cancel"
                    confirm=(action "saveSearch")
                    close="removeSaveSearchDialog"}}

                  <div class="ember-view">
                    <label>{{t "views.app.project.list.savedsearch.query"}}</label>
                    <span>{{this.query}}</span>
                  </div>

                  <FormFields::FieldText
                    @placeholder={{t "views.app.project.list.savedsearch.inputname"}}
                    @label={{t "views.app.project.list.savedsearch.name"}}
                    @value={{this.newSavedsearch.name}}
                    @aclContex="App.Project.List.SavedSearch.Create.Name"
                  />

                {{/bootstrap-modal}}
              {{/if}}
            </div>
            {{!-- /.box-tools --}}
          </div>
          {{!-- /.box-header --}}
          <div class="box-body no-padding">
            <div class="list-controls">
              {{!-- Check all button --}}
              <span class="btn btn-default btn-sm checkbox-toggle">
                <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContex="App.Project.List.SelectAllProjects"/>
              </span>            <div class="btn-group">
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="App.Project.Delete"><i class="fa fa-trash-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.massupdate"}}" @aclContext="App.Project.Edit"><i class="fa fa-pencil"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.export"}}" @onClick={{this.showExportDialog}}><i class="fa fa-download"></i></AppUi::Button>
              </div>
              <div class="pull-right">
                <span class="list-view-count">{{t "global.list.selectedCount" count=this.checkboxCount}}</span>
                {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
                {{#if this.model.meta.links.next}}+{{/if}}
                <div class="btn-group">
                  {{#if this.model.meta.links.prev}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="App.Project.Read"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}}"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{/if}}
                  {{#if this.model.meta.links.next}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="App.Project.Read"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{/if}}
                </div>
                {{!-- /.btn-group --}}
              </div>
              {{!-- /.pull-right --}}
            </div>
            <div class="table-responsive list-view">
              <table class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th class="select-box"></th>
                    <th data-sort="Project.name">{{t "views.app.project.list.name"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Project.name')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    <th data-sort="manager.name">{{t "views.app.project.list.manager"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'manager.name')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    <th data-sort="Project.status">{{t "views.app.project.list.status"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Project.status')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    <th data-sort="Project.dateModified">{{t "views.app.project.list.date"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'Project.dateModified')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    <th>{{t "views.app.project.list.members"}}</th>
                  </tr>
                </thead>

                <tbody>
                  {{#if this.model.length}}
                    {{#each this.model as |project|}}
                      <tr data-project-id={{project.id}}>
                        <td class="select-box">
                          <FormFields::FieldCheckbox @select={{action this.select}} @data-select={{project.id}} @aclContex="App.Project.List.SelectProject"/>
                        </td>
                        
                        <td class="project-name"><LinkTo @route="app.project" @model={{project.shortCode}}>{{project.name}}</LinkTo></td>
                        <td class="project-manager"><LinkTo @route="app.user.page" @model={{project.manager.id}}>{{project.manager.name}}</LinkTo></td>
                        <td class="project-status"><span class="badge {{project.status}}">{{t (concat "views.app.project.lists.status." project.status)}}</span></td>
                        <td class="project-date">{{format-date date=project.dateModified}}</td>
                        <td class="project-members"><Project::MemberAvatars @members={{project.members}} /></td>
                      </tr>
                    {{/each}}
                  {{else}}
                    <tr>
                      <td colspan="100%">
                        <Exceptions::NothingFound 
                          @description={{t "views.app.user.page.latestProjects.noProject"}}
                        />
                      </td>
                    </tr>
                  {{/if}}
                </tbody>
              </table>
              {{!-- /.table --}}
            </div>
            {{!-- /.mail-box-messages --}}
          </div>
          {{!-- /.box-body --}}
          <div class="box-footer no-padding">
            <div class="list-controls">

              <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
                <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContex="App.Project.List.SelectAllProjects"/>
              </span>
              <div class="btn-group">
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="App.Project.Delete"><i class="fa fa-trash-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.massupdate"}}" @aclContext="App.Project.Edit"><i class="fa fa-pencil"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.discuss"}}"><i class="fa fa-comments-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.export"}}" @onClick={{this.showExportDialog}}><i class="fa fa-download"></i></AppUi::Button>
              </div>
              <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.refresh"}}" @onClick={{this.reloadPage}}><i class="fa fa-refresh"></i></AppUi::Button>
              <div class="pull-right">
                <span class="list-view-count">{{t "global.list.selectedCount" count=this.checkboxCount}}</span>
                {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
                {{#if this.model.meta.links.next}}+{{/if}}
                <div class="btn-group">
                  {{#if this.model.meta.links.prev}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="App.Project.Read"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}}"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{/if}}
                  {{#if this.model.meta.links.next}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="App.Project.Read"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{/if}}
                </div>
              </div>

            </div>
          </div>

          {{!-- Modals --}}
          {{#if this.exportDialog}}
            {{#bootstrap-modal
                title="global.form.export"
                confirmLabel="global.form.export"
                closeLabel="global.form.cancel"
                confirm=(action "exportModules")
                close=(action "removeExportDialog")}}
                
                <div class="form-group">
                  <FormFields::FieldRelateMulti
                    @options={{get-relationships "project" this.store}}
                    @placeholder={{t "views.app.module.list.export.selectRelationship.placeholder"}}
                    @selected={{this.exportRelationships}}
                    @onchange={{fn this.selectStatic this 'exportRelationships'}}
                    @label={{t "views.app.module.list.export.selectRelationship.label" moduleName=(lowercase (t "global.module.plural.project"))}}
                    @relateType="relate-simple"
                    @aclContext="App.Project.Export.Relationships"
                    @closeOnSelect={{false}}
                  />
                </div>
            {{/bootstrap-modal}}
          {{/if}}

        </div>
      </AccessControl>
      {{!-- /. box --}}
    </div>
    {{!-- /.col --}}
  </div>
  {{!-- /.row --}}
</section>
