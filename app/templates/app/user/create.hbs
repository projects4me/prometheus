<div class="user-create">
  <section class="content-header">
    <h1>
      {{t "views.app.user.create.title"}}
    </h1>
    <BreadCrumb/>
  </section>

  <section class="content">

    <div class="row">
      <AccessControl @aclContext="user.create">
        <div class="col-md-8">

          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
                {{t "views.app.user.create.userInfo" }}
              </h3>
            </div>

            <div class="form box-body no-padding">
              <div class="user-header flex-row flex-ai-c">
                <User::Edit::ProfilePicture
                  @model={{this.model}}
                  @uploadImage={{this.uploadImage}}
                  @cropImageSrc={{this.cropImageSrc}}
                  @onApplyCrop={{this.applyCrop}}
                  @onCancelCrop={{this.cancelCrop}}
                />

                <div class="user-cv-basic-info">
                  <FormFields::FieldText 
                    @placeholder={{t "views.app.user.create.nameplaceholder" }}
                    @label={{t "views.app.user.create.name" }} 
                    @type="text" 
                    @value={{this.model.name}} 
                    @data-field="user.name"
                    @lengthRequired={{false}}
                    @validate={{action this.validateField "userCreate" (hash name="name" value=this.model.name)}}
                    @message={{this.message.userCreate.name}}
                    {{autofocus}} 
                  />

                  <FormFields::FieldText 
                    @placeholder={{t "views.app.user.create.emailplaceholder" }}
                    @label={{t "views.app.user.create.email" }}
                    @type="text" 
                    @value={{this.model.email}}
                    @data-field="user.email" 
                    @lengthRequired={{false}} 
                    @mask="email"
                    @validate={{action this.validateField "userCreate" (hash name="email" value=this.model.email)}}
                    @message={{this.message.userCreate.email}}     
                  />
                  <p class="help-block email-password-hint">
                    <i class="fa fa-info-circle"></i>
                    {{t "views.app.user.create.emailPasswordHint"}}
                  </p>

                  <FormFields::FieldDate 
                    @placeholder={{t "views.app.user.create.dobplaceholder" }}
                    @label={{t "views.app.user.create.dateofbirth" }} 
                    @value="{{readonly this.model.dateOfBirth}}"
                    @update={{action "selectStatic" this.model 'dateOfBirth' }} 
                    @mask="alphanumeric"
                    @data-field="user.dateOfBirth" 
                    @format="DD-MM" 
                    @singleDatePicker={{true}}
                    @showDropdowns={{true}} 
                    @positionX="right" 
                    @positionY="down" 
                    @autoApply={{true}} 
                    @minDate="01-01"
                    @startDate="01-01"
                    @parentEl='[data-field="user.dateOfBirth"]'
                    @endDate="31-12"
                    @maxDate="31-12"
                    @validate={{action this.validateField "userCreate" (hash name="dateOfBirth" value=this.model.dateOfBirth)}}
                    @message={{this.message.userCreate.dateOfBirth}}     
                  />
                </div>
              </div>


            </div>
          </div>

        <AccessControl @aclContext="membership.create">
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
                {{t "views.app.user.create.membership.title"}}
              </h3>
            </div>

            <div class="box-body">
              <FormFields::FieldRelate
                @placeholder={{t "views.app.user.create.membership.projectplaceholder"}}
                @label={{t "views.app.user.create.membership.project"}}
                @options={{this.projectsList}}
                @selected={{this.selectedProject}}
                @onchange={{fn (mut this.selectedProject)}}
                @relateType="relate-simple"
                @searchEnabled={{false}}
                @data-field="user.membership.project"
              />

              <FormFields::FieldRelate
                @placeholder={{t "views.app.user.create.membership.roleplaceholder"}}
                @label={{t "views.app.user.create.membership.role"}}
                @options={{this.rolesList}}
                @selected={{this.selectedRole}}
                @onchange={{fn (mut this.selectedRole)}}
                @relateType="relate-simple"
                @searchEnabled={{false}}
                @data-field="user.membership.role"
              />
            </div>
          </div>
        </AccessControl>          

        </div>
      </AccessControl>      

      <div class="col-md-4">
        <AccessControl @aclContext="user.create">
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
                {{t "views.app.user.create.language"}}
              </h3>
            </div>

            <div class="box-body">
              <AppUi::Language
                @placeholder={{t "views.app.user.create.languageplaceholder"}}
                @label={{t "views.app.user.create.languagelabel"}}
                @value={{this.model.language}}
                @onchange={{action "selectRelated" this.model 'language'}}
                @model={{this.model}}
                @data-field="user.language"
                @validate={{action this.validateField "userCreate" (hash name="language" value=this.model.language)}}
                @message={{this.message.language}}
                @disabled={{true}}
              />
            </div>
          </div>
        </AccessControl>

        <AccessControl @aclContext="user.create">
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
                {{t "views.app.user.create.timezone"}}
              </h3>
            </div>

            <div class="box-body">
              <User::Create::Timezones
                @value={{this.model.timezone}}
                @model={{this.model}}
                @selectRelated={{this.selectRelated}}
                @validate={{action this.validateField "userCreate" (hash name="timezone" value=this.model.timezone)}}
                @message={{this.message.timezone}}
              />
            </div>
            
          </div>
        </AccessControl>
      </div>

    <div class="col-sm-12">
      <AppUi::Button type="button" data-btn="save" class="btn btn-primary" @onClick={{fn this.save "userCreate"}} @disableOnSuccess={{true}} @aclContext="user.create">{{t "global.form.save"}}</AppUi::Button>
      <AppUi::Button type="button" data-btn="cancel" class="btn btn-default" @onClick={{this.cancel}}>{{t "global.form.cancel"}}</AppUi::Button>
    </div>
        
    </div>

  </section>
</div>