<div class="user-page">

  <section class="content-header">
    <h1>
      {{t "views.app.user.page.title"}}
    </h1>

    <BreadCrumb/>
  </section>

  <section class="content">

    <div class="row">
      <div class="col-md-3 col-sm-3">

        <AccessControl @aclContext="App.User.Read"> 
          {{!-- User profile info section starts--}}
          <div class="box box-primary">
            <div class="box-body box-profile">
              <User::Edit::ProfilePicture
                @model={{this.model}}
                @uploadImage={{this.uploadImage}}
                @cropImageSrc={{this.cropImageSrc}}
                @onApplyCrop={{this.applyCrop}}
                @onCancelCrop={{this.cancelCrop}}
              />

              <div class="user-info">
                  <h3 class="user-name flex-row flex-ai-c">
                    <AppUi::InlineEditable
                      @value={{this.model.name}}
                      @onSave={{fn this.saveModelAttribute this.model "name"}}
                      @aclContext="App.User.Management"
                      @validate={{fn this.validateInlineField "userPage" "name"}}
                      @message={{this.message.userPage.name}}
                      @onClearMessage={{fn this.clearFieldMessage "userPage" "name"}}
                    >
                      <:display>{{this.model.name}}</:display>
                      <:edit as |f|>
                        <FormFields::FieldText
                          @value={{f.value}}
                          @type="text"
                          @onInput={{f.update}}
                          @validate={{fn this.validateField "userPage" (hash name="name" model=(hash name=f.value))}}
                          @message={{f.message}}
                          @data-field="user-page.name"
                          @lengthRequired={{false}}
                          autofocus
                          {{on "keydown" f.onKeydown}}
                        />
                      </:edit>
                    </AppUi::InlineEditable>
                  </h3>
                  <span class="user-designation flex-row flex-ai-c">
                    <AppUi::InlineEditable
                      @value={{this.model.title}}
                      @onSave={{fn this.saveModelAttribute this.model "title"}}
                      @aclContext="App.User.Management"
                      @label={{t "views.app.user.create.designation"}}
                      @validate={{fn this.validateInlineField "userPage" "title"}}
                      @message={{this.message.userPage.title}}
                      @onClearMessage={{fn this.clearFieldMessage "userPage" "title"}}
                    >
                      <:display>{{this.model.title}}</:display>
                      <:edit as |f|>
                        <FormFields::FieldText
                          @value={{f.value}}
                          @type="text"
                          @onInput={{f.update}}
                          @validate={{fn this.validateField "userPage" (hash name="title" model=(hash title=f.value))}}
                          @message={{f.message}}
                          @data-field="user-page.title"
                          @lengthRequired={{false}}
                          autofocus
                          {{on "keydown" f.onKeydown}}
                        />
                      </:edit>
                    </AppUi::InlineEditable>
                  </span>
              </div>

              <UserProfile::SocialLinks
                @user={{this.model}}
                @redirect={{fn this.redirectToSocialLink}}
              />

              <div class="user-dob">    
                <i class="fa fa-birthday-cake"></i>
                <span class="user-meta-label">{{t "views.app.user.create.dateofbirth"}}:</span>
                <AppUi::InlineEditable
                  @value={{this.model.dateOfBirth}}
                  @onSave={{fn this.saveModelAttribute this.model "dateOfBirth"}}
                  @aclContext="App.User.Management"
                  @validate={{fn this.validateInlineField "userPage" "dateOfBirth"}}
                  @message={{this.message.userPage.dateOfBirth}}
                  @onClearMessage={{fn this.clearFieldMessage "userPage" "dateOfBirth"}}
                  @submitOnEnter={{false}}
                >
                  <:display>
                    <span class="user-meta-value">{{or this.model.dateOfBirth "-"}}</span>
                  </:display>
                  <:edit as |f|>
                    <FormFields::FieldDate
                      @placeholder={{t "views.app.user.create.dobplaceholder"}}
                      @value="{{readonly f.value}}"
                      @update={{f.updateDirect}}
                      @validate={{fn this.validateField "userPage" (hash name="dateOfBirth" model=(hash dateOfBirth=f.value))}}
                      @message={{f.message}}
                      @mask="alphanumeric"
                      @data-field="user-page.dateOfBirth"
                      @format="DD-MM"
                      @singleDatePicker={{true}}
                      @showDropdowns={{true}}
                      @positionX="right"
                      @positionY="down"
                      @autoApply={{true}}
                      @minDate="01-01"
                      @startDate={{if f.value f.value "01-01"}}
                      @parentEl='[data-field="user-page.dateOfBirth"]'
                      @endDate="31-12"
                      @maxDate="31-12"
                    />
                  </:edit>
                </AppUi::InlineEditable>
              </div>

              <div class="user-language">
                <i class="fa fa-language"></i>
                <span class="user-meta-label">{{t "views.app.user.create.language"}}:</span>
                <span class="user-meta-value">{{or this.userLanguageLabel "-"}}</span>
              </div>

              <div class="user-timezone">
                <i class="fa fa-clock-o"></i>
                <span class="user-meta-label">{{t "views.app.user.create.timezone"}}:</span>
                <AppUi::InlineEditable
                  @value={{this.model.timezone}}
                  @onSave={{fn this.saveModelAttribute this.model "timezone"}}
                  @aclContext="App.User.Management"
                  @validate={{fn this.validateInlineField "userPage" "timezone"}}
                  @message={{this.message.userPage.timezone}}
                  @onClearMessage={{fn this.clearFieldMessage "userPage" "timezone"}}
                  @submitOnEnter={{false}}
                >
                  <:display>
                    <span class="user-meta-value">{{or this.userTimezoneLabel "-"}}</span>
                  </:display>
                  <:edit as |f|>
                    <User::Create::Timezones
                      @value={{f.value}}
                      @model={{f.model}}
                      @selectRelated={{this.selectRelated}}
                      @validate={{fn this.validateField "userPage" (hash name="timezone" model=(hash timezone=f.value))}}
                      @message={{f.message}}
                      @data-field="user-page.timezone"
                    />
                  </:edit>
                </AppUi::InlineEditable>
              </div>

            </div>
          </div>
        </AccessControl>  
      {{!-- User profile info section ends--}}

        <AccessControl @aclContext="App.User.Read.Skills">
          {{!-- User Skills section starts --}}
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">{{t "views.app.user.page.skills"}}</h3>
            </div>

            <div class="box-body">
                
              <div class="user-skills">
                {{#each (get-user-skills skillsString=this.model.skills) as |skill|}}
                  <span class="label label-primary skill-item">
                    {{skill}}
                  </span>                
                {{/each}}
              </div>

            </div>
          </div>
          {{!-- User Skills section ends --}}
        </AccessControl>
        
        <AccessControl @aclContext="App.User.Read.Education">
          {{!-- User Education Section starts --}}
            <div class="box box-primary">
              <div class="box-header with-border">
                <h3 class="box-title"> {{t "views.app.user.page.education"}} </h3>
              </div>

              <div class="box-body">
                <div class="user-education">
                  <i class="fa fa-graduation-cap"></i>
                  <span class="education"> {{this.model.education}} </span>
                </div>
              </div>

            </div>
          {{!-- User Education Section ends --}}
        </AccessControl>
        
      </div>

      <div class="col-md-9">

        <AccessControl @aclContext="App.User.Read.Statistics.Read">
          {{!-- User Stats Section starts --}}
          <div class="row">
            <div class="col-md-3">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">{{t "views.app.user.page.stats.projects"}}</h3>
                </div>
                <div class="box-body">
                  <Charts::OpenClosedChart
                    class="user-stats-card"
                    @openCount={{this.model.openClosedProject.openProjects}}
                    @closedCount={{this.model.openClosedProject.closedProjects}}
                    @for="projects"
                  />
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">{{t "views.app.user.page.stats.issues"}}</h3>
                </div>
                <div class="box-body">
                  <Charts::OpenClosedChart
                    class="user-stats-card"
                    @openCount={{this.model.openClosedIssue.openIssues}}
                    @closedCount={{this.model.openClosedIssue.closedIssues}}
                    @for="issues"
                  />
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">
                    {{t "views.app.user.page.stats.timespent.label"}}
                    <span class="time-spent-sub-label">
                      ({{t "views.app.user.page.stats.timespent.sublabel"}})
                    </span>
                  </h3>
                </div>
                <div class="box-body">
                  <UserProfile::TimeSpent
                    @timeSpent={{this.model.timeSpent.totalMinutes}}
                  />
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">{{t "views.app.user.page.stats.collaboration"}}</h3>
                </div>
                <div class="box-body">
                  <UserProfile::Collaboration
                    @collaboration={{this.model.collaboration.collaboration}}
                  />
                </div>
              </div>
            </div>
          </div>
          {{!-- User Stats Section ends --}}
        </AccessControl>

      {{!-- User Latest Modules Sections --}}
        <div class="row">       
          <AccessControl @aclContext="App.User.Read.LatestProjects.Read">
            {{!-- User latest Projects Section starts --}}
            <div class="col-md-6">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title"> {{t "views.app.user.page.latestProjects.title"}} </h3>               
                </div>

                <div class="box-body">
                  <UserProfile::LatestProjects
                    @projects={{this.model.latestProjects}}
                  />
                </div>
              </div>
            </div>
          {{!-- User latest Projects Section ends --}}
          </AccessControl>

          <AccessControl @aclContext="App.User.Read.LatestIssues.Read">
            {{!-- User latest Issues Section starts --}}
            <div class="col-md-6">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title"> {{t "views.app.user.page.latestIssues.title"}} </h3>              
                </div>
                <div class="box-body">
                  <UserProfile::LatestIssues
                    @issues={{this.model.latestIssues}}
                  />
                </div>
              </div>
            </div>
            {{!-- User latest Issues Section ends --}}
          </AccessControl>

          <AccessControl @aclContext="App.User.Read.RecentActivities.Read">
            {{!-- User Recent Activities Section starts --}}
            <div class="col-md-8">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title"> {{t "views.app.user.page.recentActivities.title"}} </h3>              
                </div>
                <div class="box-body">
                  <UserProfile::RecentActivities
                    @activities={{this.model.recentActivities}}
                  />
                </div>
              </div>
            </div>
            {{!-- User Recent Activities Section ends --}}
          </AccessControl>
          
          <AccessControl @aclContext="App.User.Read.MostWorkedMembers.Read">
            {{!-- User Works most With Section starts --}}
            <div class="col-md-4">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title"> {{t "views.app.user.page.worksMostWith"}} </h3>              
                </div>
                <div class="box-body">
                  <UserProfile::CloseMembers
                    @users={{this.model.mostWorkedMembers}}
                  />
                </div>
              </div>
            </div>
            {{!-- User Works most With Section ends --}} 
          </AccessControl>                 

        </div>

      </div>

    </div>

  </section>

</div>