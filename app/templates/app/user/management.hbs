<section class="content-header">
  <h1>
    {{t "views.app.user.management.title"}}
  </h1>
  <BreadCrumb/>
</section>

<section class="content user-management">
  <div class="row module users">
    <div class="col-md-12">
      <AccessControl @aclContext="user.read">
        <div class="box box-primary list-view">
            <div class="box-header with-border">
              <div class="header">
                <div class="search">
                  <div class="has-feedback user-management-search">
                    <FormFields::FieldSearch
                      @placeholder={{t "views.app.user.management.search"}}
                      @data-module="user-management"
                      @searchFunction={{this.searchUserByName}}
                      @aclContext="user.read"
                    />
                  </div>
                </div>
                <AccessControl @aclContext="user.create">
                  <LinkTo @route="app.user.create" class="user-management-create">
                    <AppUi::Button type="button" class="btn btn-primary btn-sm" data-btn="create-user">
                      <i class="fa fa-plus" aria-hidden="true"></i>
                      {{t "views.nav.menu.user.create"}}
                    </AppUi::Button>
                  </LinkTo>
                </AccessControl>
              </div>
            </div>

            <div class="box-body no-padding">
              <div class="list-controls">
                <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
                  <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContext="user.update"/>
                </span>

                <div class="btn-group">
                  <AppUi::Button data-btn="delete" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="user.delete">
                    <i class="fa fa-trash-o" aria-hidden="true"></i>
                  </AppUi::Button>
                </div>
                <div class="user-mass-actions">
                  <FormFields::FieldSwitch
                    @callBack={{this.changeMultipleUserStatus}}
                    @aclContext="user.update"
                  />
                </div>

                <div class="pull-right">
                  <span class="list-view-count">{{t "views.app.issue.list.selectedCount" count=this.checkboxCount}}</span>
                  {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
                  {{#if this.model.meta.links.next}}+{{/if}}
                  <div class="btn-group">
                    {{#if this.model.meta.links.prev}}
                      <AppUi::Button data-btn="prev-record" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="user.read"><i class="fa fa-chevron-left"></i></AppUi::Button>
                    {{else}}
                      <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}} "><i class="fa fa-chevron-left"></i></AppUi::Button>
                    {{/if}}
                    {{#if this.model.meta.links.next}}
                      <AppUi::Button data-btn="next-record" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="user.read"><i class="fa fa-chevron-right"></i></AppUi::Button>
                    {{else}}
                      <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
                    {{/if}}
                  </div>
                </div>
              </div>

              <div class="table-responsive list-view users">
                <table class="table table-hover table-striped">
                  <thead>
                    <tr>
                      <th class="select-box"></th>
                      <th data-sort="User.name">{{t "views.app.user.management.list.profile"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'User.name')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                      <th data-sort="User.email">{{t "views.app.user.management.list.emailaddress"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'User.email')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                      <th data-sort="User.accountStatus">{{t "views.app.user.management.list.accountStatus"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'User.accountStatus')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                      <th data-sort="User.lastActivityAt">{{t "views.app.user.management.list.lastActivityAt"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'User.lastActivityAt')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                      <th data-sort="User.dateJoined">{{t "views.app.user.management.list.dateJoined"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData 'User.dateJoined')}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    </tr>
                  </thead>

                  <tbody>
                    {{#if this.model.length}}
                      {{#each this.model as |user|}}
                        <tr data-user-id={{user.id}}>
                          <td>
                            <FormFields::FieldCheckbox @select={{action this.select}} @data-select={{user.id}} @aclContext="user.update"/>
                          </td>

                          <td class="user-profile" data-user-field="profile">
                            <img class="user-img" src="{{this.apiHost}}/userimage/get/{{user.id}}" alt="user-img">

                            <div>
                              <LinkTo @route="app.user.page" @model={{user.id}}>
                                <div data-user-field="name">{{user.name}}</div>
                              </LinkTo>
                              <div class="title">{{user.title}}</div>
                            </div>
                          </td>

                          <td data-user-field="email">{{user.email}}</td>
                          <td data-user-field="account-status" class={{concat "account-status-" user.accountStatus}}>{{t (concat "views.app.user.accountStatus." user.accountStatus)}}</td>

                          <td data-user-field="last-activity-at">
                            {{#if user.lastActivityAt}}
                              {{format-date-time date=user.lastActivityAt humanize=true}}
                            {{else}}
                              {{t "views.app.user.management.list.noLastActivity"}}
                            {{/if}}
                          </td>
                          <td data-user-field="date-joined">
                            {{#if user.dateJoined}}
                              {{format-date date=user.dateJoined}}
                            {{else}}
                              {{t "views.app.user.management.list.notJoinedYet"}}
                            {{/if}}
                          </td>

                          <td class="pull-right actions">
                            <AppUi::Button data-btn="delete" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @onClick={{fn this.deleteModel user 'name'}} @aclContext="user.delete">
                              <i class="fa fa-trash-o" aria-hidden="true"></i>
                            </AppUi::Button>

                            <UserManagement::AccountStatus
                              @user={{user}}
                              @changeUserStatus={{action this.changeUserStatus user}}
                              @aclContext="user.update"
                              @switchSize="sm"
                            />
                          </td>
                        </tr>
                      {{/each}}
                    {{else}}
                      <tr>
                        <td colspan="100%">
                          <Exceptions::NothingFound
                            @description={{t "views.app.user.management.list.noUsersFound"}}
                          />
                        </td>
                      </tr>
                    {{/if}}
                  </tbody>
                </table>
              </div>
            </div>
            <div class="box-footer no-padding">
              <div class="list-controls">
                <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
                  <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContext="user.update"/>
                </span>
                <div class="btn-group">
                  <AppUi::Button data-btn="delete" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.form.delete"}}" @aclContext="user.delete">
                    <i class="fa fa-trash-o" aria-hidden="true"></i>
                  </AppUi::Button>
                </div>
                <div class="user-mass-actions">
                  <FormFields::FieldSwitch
                    @callBack={{this.changeMultipleUserStatus}}
                    @aclContext="user.update"
                  />
                </div>
                <div class="pull-right">
                  <span class="list-view-count">{{t "views.app.issue.list.selectedCount" count=this.checkboxCount}}</span>
                  {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
                  {{#if this.model.meta.links.next}}+{{/if}}
                  <div class="btn-group">
                    {{#if this.model.meta.links.prev}}
                      <AppUi::Button data-btn="prev-record" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="user.read"><i class="fa fa-chevron-left"></i></AppUi::Button>
                    {{else}}
                      <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}} "><i class="fa fa-chevron-left"></i></AppUi::Button>
                    {{/if}}
                    {{#if this.model.meta.links.next}}
                      <AppUi::Button data-btn="next-record" type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="user.read"><i class="fa fa-chevron-right"></i></AppUi::Button>
                    {{else}}
                      <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </AccessControl>
      </div>
  </div>
</section>
