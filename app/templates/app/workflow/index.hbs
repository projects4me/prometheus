<section class="content-header">
  <h1>
    {{t "global.module.plural.workflow"}}
    <small>{{t "views.app.workflow.list.subtitle"}}</small>
  </h1>
  <BreadCrumb/>
</section>

<section class="content">
  <div class="row module workflows workflows-list">
    <div class="col-md-12">
      <AccessControl @aclContext="workflow.read">
        <div class="box box-primary list-view">
          <div class="box-header with-border">
            <div class="search">
              <AppUi::Dropdown @isPrimary={{true}}>
                <:button>
                  {{t "views.app.workflow.list.savedsearch"}}
                </:button>
                <:content>
                  {{#each this.savedsearches as |search|}}
                    <div {{on "click" (fn this.toggleSearch search)}} class="{{if (call (fn this.isSearchActive search)) "active"}}">
                      {{search.name}}
                      {{#if (call (fn this.isSearchActive search))}}
                        <i class="fa fa-check pull-right"></i>
                      {{/if}}
                    </div>
                  {{/each}}
                </:content>
              </AppUi::Dropdown>
              <div class="has-feedback">
                <FormFields::FieldText
                  data-toggle="collapse"
                  data-target=".list-view-filters"
                  @focusIn={{fn this.openFilters}}
                  @insert-newline={{this.filter}}
                  @value={{this.query}}
                  @name="query"
                  @readonly="readonly"
                  @placeholder={{t "views.app.workflow.list.search"}}
                />
                <span class="glyphicon glyphicon-search form-control-feedback"></span>
              </div>
              <AppUi::Button type="button" class="btn btn-primary" data-btn="search" @onClick={{this.searchByRules}} @aclContext="workflow.read">{{t "global.form.search"}}</AppUi::Button>
              <AppUi::Button type="button" class="btn" data-btn="clear" @onClick={{this.clearSearch}}>{{t "global.form.clear"}}</AppUi::Button>
              <AccessControl @aclContext="workflow.create">
                <LinkTo @route="app.workflow.create" class="btn btn-default" data-btn="new-workflow">
                  <i class="fa fa-plus" aria-hidden="true"></i> {{t "views.app.workflow.list.new"}}
                </LinkTo>
              </AccessControl>
            </div>
            <div class="list-view-filters collapse">
              {{query-builder module="workflow" query=this.query}}
            </div>
          </div>

          <div class="box-body no-padding">
            <div class="list-controls">
              <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
                <FormFields::FieldCheckbox @select={{action this.selectAll}} @data-select="all" @aclContext="workflow.read"/>
              </span>
              <div class="btn-group">
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-btn="delete-workflows" title="{{t "global.form.delete"}}" @onClick={{this.deleteSelected}} @aclContext="workflow.delete"><i class="fa fa-trash-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-btn="activate-workflows" title="{{t "views.app.module.list.activation.activate"}}" @onClick={{fn this.setSelectedActive true}} @aclContext="workflow.update"><i class="fa fa-toggle-on"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-btn="deactivate-workflows" title="{{t "views.app.module.list.activation.deactivate"}}" @onClick={{fn this.setSelectedActive false}} @aclContext="workflow.update"><i class="fa fa-toggle-off"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-btn="export-workflows" title="{{t "views.app.module.list.export.label"}}" @onClick={{this.exportSelected}} @aclContext="workflow.read"><i class="fa fa-download"></i></AppUi::Button>
              </div>
              <div class="pull-right">
                <span class="list-view-count">{{t "global.list.selectedCount" count=this.checkboxCount}}</span>
                {{add (mult (sub this.page 1) 20) 1}}-{{add (mult (sub this.page 1) 20) this.model.length}} / {{add (mult (sub this.page 1) 20) this.model.length}}
                {{#if this.model.meta.links.next}}+{{/if}}
                <div class="btn-group">
                  {{#if this.model.meta.links.prev}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.prevPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.prev.href)}} @aclContext="workflow.read"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.prevPage"}}"><i class="fa fa-chevron-left"></i></AppUi::Button>
                  {{/if}}
                  {{#if this.model.meta.links.next}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{t "global.list.nextPage"}}" @onClick={{fn this.paginate (get-page this.model.meta.links.next.href)}} @aclContext="workflow.read"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{else}}
                    <AppUi::Button type="button" class="btn btn-default btn-sm disabled" data-toggle="tooltip" title="{{t "global.list.nextPage"}}"><i class="fa fa-chevron-right"></i></AppUi::Button>
                  {{/if}}
                </div>
              </div>
            </div>

            <div class="table-responsive list-view">
              <table class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th class="select-box"></th>
                    <th data-sort="Workflow.name">{{t "views.app.workflow.list.name"}} <AppUi::Button type="button" class="btn btn-box-tool" {{on "click" (fn this.sortData "Workflow.name")}}><i class="fa fa-sort"></i></AppUi::Button></th>
                    <th>{{t "views.app.workflow.list.trigger"}}</th>
                    <th>{{t "views.app.workflow.list.scope"}}</th>
                    <th>{{t "views.app.workflow.list.actors"}}</th>
                    <th>{{t "views.app.workflow.list.runs"}}</th>
                    <th>{{t "views.app.workflow.list.lastRun"}}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{#if this.rows.length}}
                    {{#each this.rows as |row|}}
                      <tr data-workflow-id={{row.workflow.id}}>
                        <td class="select-box">
                          <FormFields::FieldCheckbox @select={{action this.select}} @data-select={{row.workflow.id}} @aclContext="workflow.read"/>
                        </td>
                        <td class="workflow-cell" data-workflow-field="workflow">
                          <LinkTo @route="app.workflow.page" @model={{row.workflow.id}} data-workflow-field="name">{{row.workflow.name}}</LinkTo>
                          <span class="label {{if (eq row.workflow.status "Active") "label-success" (if (eq row.workflow.status "Disabled") "label-danger" "label-warning")}}" data-workflow-field="status">{{t (concat "views.app.workflow.status." row.workflow.status)}}</span>
                          <span class="workflow-description">{{row.workflow.description}}</span>
                        </td>
                        <td data-workflow-field="trigger">
                          {{#if row.trigger}}
                            <strong>{{row.trigger.entity}}</strong>{{#if row.trigger.event}} &middot; {{row.trigger.event}}{{/if}}
                          {{else}}
                            <em>{{t "views.app.workflow.list.noTrigger"}}</em>
                          {{/if}}
                        </td>
                        <td data-workflow-field="scope">
                          {{#if row.projects.length}}
                            {{join ", " row.projects}}
                          {{else}}
                            {{t "views.app.workflow.list.allProjects"}}
                          {{/if}}
                        </td>
                        <td class="workflow-actors" data-workflow-field="actors">
                          {{#each row.actors as |actor|}}
                            <span class="workflow-actor" data-workflow-actor>{{actor.label}}{{#if actor.isAgent}} <Agent::Badge />{{/if}}</span>
                          {{/each}}
                        </td>
                        <td data-workflow-field="runs">{{row.runStats.count}}</td>
                        <td data-workflow-field="last-run">
                          {{#if row.runStats.last}}
                            {{format-date-time date=row.runStats.last humanize=true}}
                          {{else}}
                            {{t "views.app.workflow.list.neverRun"}}
                          {{/if}}
                        </td>
                        <td class="actions">
                          <AccessControl @aclContext="workflow.update">
                            <LinkTo @route="app.workflow.page" @model={{row.workflow.id}} class="btn btn-default btn-sm" data-btn="edit" title={{t "global.form.edit"}}>
                              <i class="fa fa-pencil" aria-hidden="true"></i>
                            </LinkTo>
                          </AccessControl>
                        </td>
                      </tr>
                    {{/each}}
                  {{else}}
                    <tr>
                      <td colspan="100%">
                        <Exceptions::NothingFound @description={{t "views.app.workflow.list.noWorkflows"}} />
                      </td>
                    </tr>
                  {{/if}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </AccessControl>
    </div>
  </div>
</section>
