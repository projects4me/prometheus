<section class="content-header">
  <h1>
    {{t "global.module.plural.workflow"}}
    <small>{{t "views.app.workflow.list.subtitle"}}</small>
  </h1>
  <BreadCrumb/>
</section>

<section class="content">
  <div class="row module workflows workflows-list">
    <div class="col-md-12">
      <AccessControl @aclContext="workflow.read">
        <div class="box box-primary list-view">
          <AppUi::ListToolbar>
            <:search>
              {{#if this.querySchema}}
                <EzSearch
                  @schema={{this.querySchema}}
                  @query={{this.query}}
                  @savedSearches={{this.ezSavedSearches}}
                  @activeSavedSearchId={{this.searchId}}
                  @onSavedSearchChange={{this.selectSavedSearch}}
                  @onApply={{this.applyQuery}}
                  @aclContext="workflow.read"
                />
              {{/if}}
            </:search>
            <:actions>
              <AccessControl @aclContext="workflow.create">
                <LinkTo @route="app.workflow.create" class="btn btn-default" data-test-list-create>
                  <i class="fa fa-plus" aria-hidden="true"></i> {{t "views.app.workflow.list.new"}}
                </LinkTo>
              </AccessControl>
            </:actions>
            <:selection>
              <span class="btn btn-default btn-sm checkbox-toggle" {{tooltip (t "global.list.selectAll")}}>
                <FormFields::FieldCheckbox @select={{this.selectAll}} @data-select="all" @aclContext="workflow.read"/>
              </span>
              <div class="btn-group">
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-test-list-action="delete" aria-label={{t "global.form.delete"}} {{tooltip (t "global.form.delete")}} @onClick={{this.deleteSelected}} @aclContext="workflow.delete"><i class="fa fa-trash-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-test-list-action="activate" aria-label={{t "views.app.module.list.activation.activate"}} {{tooltip (t "views.app.module.list.activation.activate")}} @onClick={{fn this.setSelectedActive true}} @aclContext="workflow.update"><i class="fa fa-toggle-on"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-test-list-action="deactivate" aria-label={{t "views.app.module.list.activation.deactivate"}} {{tooltip (t "views.app.module.list.activation.deactivate")}} @onClick={{fn this.setSelectedActive false}} @aclContext="workflow.update"><i class="fa fa-toggle-off"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-test-list-action="export" aria-label={{t "views.app.module.list.export.label"}} {{tooltip (t "views.app.module.list.export.label")}} @onClick={{this.exportSelected}} @aclContext="workflow.read"><i class="fa fa-download"></i></AppUi::Button>
              </div>
            </:selection>
            <:pager>
              <span class="list-view-count">{{t "global.list.selectedCount" count=this.checkboxCount}}</span>
              <AppUi::Pager @offset={{this.offset}} @limit={{this.pageSize}} @count={{this.model.length}} @hasMore={{if this.model.meta.links.next true false}} @onPageChange={{this.changeOffset}} />
            </:pager>
          </AppUi::ListToolbar>

          <div class="box-body no-padding">
            <AppUi::DataTable @columns={{this.columns}} @rows={{this.rows}} @sort={{this.sort}} @order={{this.order}} @selectable={{true}} @onSort={{this.sortData}} @onSelect={{this.selectRow}}>
              <:cell as |row column|>
                {{#if (eq column.key "workflow")}}
                  <LinkTo @route="app.workflow.page" @model={{row.id}} data-test-workflow-name>{{row.workflow.name}}</LinkTo>
                  <span class="label {{if (eq row.workflow.status "Active") "label-success" (if (eq row.workflow.status "Disabled") "label-danger" "label-warning")}}" data-test-workflow-status>{{t (concat "views.app.workflow.status." row.workflow.status)}}</span>
                  <span class="workflow-description">{{row.workflow.description}}</span>
                {{else if (eq column.key "trigger")}}
                  {{#if row.trigger}}
                    <strong>{{row.trigger.entity}}</strong>{{#if row.trigger.event}} &middot; {{row.trigger.event}}{{/if}}
                  {{else}}
                    <em>{{t "views.app.workflow.list.noTrigger"}}</em>
                  {{/if}}
                {{else if (eq column.key "scope")}}
                  {{#if row.projects.length}}
                    {{join ", " row.projects}}
                  {{else}}
                    {{t "views.app.workflow.list.allProjects"}}
                  {{/if}}
                {{else if (eq column.key "actors")}}
                  {{#each row.actors as |actor|}}
                    <span class="workflow-actor" data-test-workflow-actor>{{actor.label}}{{#if actor.isAgent}} <Agent::Badge />{{/if}}</span>
                  {{/each}}
                {{else if (eq column.key "runs")}}
                  {{row.runStats.count}}
                {{else if (eq column.key "last-run")}}
                  {{#if row.runStats.last}}
                    {{format-date-time date=row.runStats.last humanize=true}}
                  {{else}}
                    {{t "views.app.workflow.list.neverRun"}}
                  {{/if}}
                {{/if}}
              </:cell>
              <:rowActions as |row|>
                <AccessControl @aclContext="workflow.update">
                  <LinkTo @route="app.workflow.page" @model={{row.id}} class="btn btn-default btn-sm" data-test-row-action="edit" title={{t "global.form.edit"}}>
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                  </LinkTo>
                </AccessControl>
              </:rowActions>
              <:empty>
                <Exceptions::NothingFound @description={{t "views.app.workflow.list.noWorkflows"}} />
              </:empty>
            </AppUi::DataTable>
          </div>
        </div>
      </AccessControl>
    </div>
  </div>
</section>
