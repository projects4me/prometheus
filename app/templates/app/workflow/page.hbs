<section class="workflow-editor" data-workflow-editor>
  <AccessControl @aclContext="workflow.read">
    {{#if this.model.workflow}}
      <div class="row">
        <div class="col-md-12">
          <Workflow::HeaderBox
            @workflow={{this.model.workflow}}
            @statusOptions={{this.statusOptions}}
            @projectOptions={{this.projectOptions}}
            @selectedScope={{this.selectedScope}}
            @onStatusChange={{this.changeStatus}}
            @onScopeChange={{this.changeScope}}
            @onSave={{this.save}}
            @onShowRuns={{this.showRuns}}
            @onShowTestRun={{this.showTestRun}}
          />
        </div>
      </div>
      <div class="row">
        <div class="col-md-2">
          <Workflow::NodePalette @disabled={{this.isGraphLocked}} @onAdd={{this.addNode}} />
        </div>
        <div class="col-md-7">
          <Workflow::FlowCanvas
            @graph={{this.model.graph}}
            @selectedNode={{this.selectedNode}}
            @locked={{this.isGraphLocked}}
            @trace={{this.trace}}
            @onAdd={{this.addNode}}
            @onMove={{this.moveNode}}
            @onSelect={{this.selectNode}}
            @onConnect={{this.connect}}
            @onRemoveEdge={{this.removeEdge}}
          />
        </div>
        <div class="col-md-3">
          <Workflow::PropertiesBox
            @node={{this.selectedNode}}
            @locked={{this.isGraphLocked}}
            @onRemove={{this.removeNode}}
          />
        </div>
      </div>
      {{#if this.runSession.panel}}
        <div class="row">
          <div class="col-md-4">
            {{#if (eq this.runSession.panel "runs")}}
              <Workflow::RunsBox @runs={{this.runSession.runs}} @selected={{this.runSession.shownRun}} @onSelect={{this.selectRun}} @onClose={{this.closePanel}} />
            {{else}}
              <Workflow::TestRunBox @running={{this.runSession.isBusy}} @onRun={{this.runTest}} @onClose={{this.closePanel}} />
            {{/if}}
          </div>
          <div class="col-md-8">
            {{#if this.runSession.shownRun}}
              <Workflow::RunStepsBox
                @steps={{this.runSession.runSteps}}
                @status={{this.runSession.shownRun.status}}
                @error={{this.runSession.shownRun.error}}
                @test={{this.runSession.shownRun.test}}
              />
            {{/if}}
          </div>
        </div>
      {{/if}}
    {{/if}}
  </AccessControl>
</section>
