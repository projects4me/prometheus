{{#if this.model.notFound}}
  <Errors::404/>
{{else if this.model.failed}}
  <Errors::500/>
{{else}}
  <section class="content-header">
    <h1>
      <small><LinkTo @route="app.workspace" @model={{this.model.workspace.shortCode}}>{{this.model.workspace.name}}</LinkTo></small>
    </h1>
    <BreadCrumb/>
  </section>

  <section class="content">
  <div class="workspace">
    <div class="row">

      <div class="col-md-8">

        {{!-- The workspace details --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="primary" class="workspace-details">
            <:header>
              <h2 class="box-title">
                <span class="workspace-name">{{this.model.workspace.name}}</span>
                -
                <span class="workspace-shortcode">({{this.model.workspace.shortCode}})</span>
              </h2>
            </:header>
            <:tools>
              <AccessControl @aclContext="workspace.update">
                <LinkTo @route="app.workspaces.edit" @model={{this.model.workspace.shortCode}} data-btn="settings" class="btn btn-default btn-sm">{{t "views.app.workspace.detail.settings"}}</LinkTo>
              </AccessControl>
            </:tools>
            <:body>
              <div class="row project-manager-row">
                <div class="project-manager-col">
                  <div class="project-manager workspace-creator">
                    <AppUi::Avatar @user={{this.model.workspace.createdBy}} @size="l" @minSize="m" />
                    <LinkTo @route="app.user.page" @model={{this.model.workspace.createdBy.id}} class="users-list-name">{{this.model.workspace.createdBy.name}}</LinkTo>
                    <span class="users-list-date">{{t "views.app.workspace.detail.createdBy"}}</span>
                  </div>
                </div>
                <div class="project-manager-details">
                  <h4>{{t "views.app.workspace.detail.description"}}</h4>
                  <p class="workspace-description">{{this.model.workspace.description}}</p>
                </div>
              </div>
              <div class="row workspace-facts">
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.projects"}}</h4>
                  <p class="workspace-project-count">{{this.model.workspace.projectCount}}</p>
                </div>
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.members"}}</h4>
                  <p class="workspace-member-count">{{this.model.workspace.memberCount}}</p>
                </div>
              </div>
            </:body>
          </AppUi::Box>
        </AccessControl>

        {{!-- The projects of the workspace --}}
        <AccessControl @aclContext="project.read">
          <AppUi::Box @variant="info" @noPadding={{true}} class="workspace-projects">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.projects"}}</h3>
            </:header>
            <:body>
              <AppUi::DataTable @columns={{this.columns}} @rows={{this.model.projects}} @sort={{this.sort}} @order={{this.order}} @onSort={{this.sortData}}>
                <:cell as |project column|>
                  {{#if (eq column.key "name")}}
                    <span data-project-id={{project.id}}>
                      <LinkTo @route="app.project.index" @model={{project.shortCode}} data-test-project-name>{{project.name}}</LinkTo>
                      <span class="text-muted">({{project.shortCode}})</span>
                    </span>
                  {{else if (eq column.key "openIssueCount")}}
                    <span data-test-project-open-issues>{{project.openIssueCount}}</span>
                  {{else if (eq column.key "activeMilestoneName")}}
                    {{#if project.activeMilestoneName}}
                      <LinkTo @route="app.project.board" @model={{project.shortCode}} data-test-project-milestone>{{project.activeMilestoneName}}</LinkTo>
                    {{else}}
                      <span data-test-project-milestone>&ndash;</span>
                    {{/if}}
                  {{else if (eq column.key "repository")}}
                    <span data-test-project-repository>{{or (get this.model.repositoryNames project.id) "–"}}</span>
                  {{else if (eq column.key "manager")}}
                    {{#if project.manager.id}}
                      <span data-test-project-manager>
                        <AppUi::Avatar @user={{project.manager}} @size="s" />
                        <LinkTo @route="app.user.page" @model={{project.manager.id}}>{{project.manager.name}}</LinkTo>
                      </span>
                    {{else}}
                      <span data-test-project-manager>&ndash;</span>
                    {{/if}}
                  {{/if}}
                </:cell>
                <:empty>
                  <Exceptions::NothingFound @description={{t "views.app.workspace.detail.noProjects"}} />
                </:empty>
              </AppUi::DataTable>
            </:body>
            <:bottom>
              {{#if (or (gt this.offset 0) this.model.hasNextProjects)}}
                <div class="box-footer no-padding" data-workspace-projects-pagination>
                  <AppUi::Pager
                    @offset={{this.offset}}
                    @limit={{this.pageSize}}
                    @hasMore={{this.model.hasNextProjects}}
                    @count={{this.model.projects.length}}
                    @onPageChange={{this.changeOffset}}
                  />
                </div>
              {{/if}}
            </:bottom>
          </AppUi::Box>
        </AccessControl>

      </div>

      <div class="col-md-4">

        {{!-- The members of the workspace's projects, read-only --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="warning" @noPadding={{true}} class="workspace-members">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.members"}} ({{this.model.workspace.memberCount}})</h3>
            </:header>
            <:body>
              <ul class="users-list clearfix">
                {{#if this.members.length}}
                  {{#each this.members as |member|}}
                    <li data-member-id={{member.id}} class="member-item">
                      <div class="member-avatar-wrap">
                        <AppUi::Avatar @user={{member}} @size="ml" />
                      </div>
                      <LinkTo @route="app.user.page" @model={{member.id}} class="users-list-name">{{member.name}}</LinkTo>
                    </li>
                  {{/each}}
                {{else}}
                  <Exceptions::NothingFound @description={{t "views.app.workspace.detail.noMembers"}} />
                {{/if}}
              </ul>
              <div class="box-footer text-center" data-members-manage>
                <LinkTo @route="app.workspaces.edit" @model={{this.model.workspace.shortCode}} data-test-manage-members>{{t "views.app.workspace.detail.manageMembers"}}</LinkTo>
              </div>
              {{#if this.hasMembersPages}}
                <div class="box-footer no-padding" data-members-pagination>
                  <AppUi::Pager
                    @offset={{this.membersOffset}}
                    @limit={{this.membersPageSize}}
                    @hasMore={{this.hasMoreMembers}}
                    @count={{this.members.length}}
                    @disabled={{this.isMembersLoading}}
                    @onPageChange={{this.loadMembers}}
                  />
                </div>
              {{/if}}
            </:body>
          </AppUi::Box>
        </AccessControl>

      </div>
    </div>
  </div>
  </section>
{{/if}}
