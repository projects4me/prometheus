{{#if this.model.notFound}}
  <Errors::404/>
{{else if this.model.failed}}
  <Errors::500/>
{{else}}
  <section class="content-header">
    <h1>
      <small><LinkTo @route="app.workspace" @model={{this.model.workspace.shortCode}}>{{this.model.workspace.name}}</LinkTo></small>
    </h1>
    <BreadCrumb/>
  </section>

  <section class="content">
  <div class="workspace">
    <div class="row">

      <div class="col-md-8">

        {{!-- The workspace details --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="primary" class="workspace-details">
            <:header>
              <h2 class="box-title">
                <span class="workspace-name">{{this.model.workspace.name}}</span>
                -
                <span class="workspace-shortcode">({{this.model.workspace.shortCode}})</span>
              </h2>
            </:header>
            <:tools>
              <AccessControl @aclContext="workspace.update">
                <LinkTo @route="app.workspace.settings" @model={{this.model.workspace.shortCode}} data-btn="settings" class="btn btn-default btn-sm">{{t "views.app.workspace.detail.settings"}}</LinkTo>
              </AccessControl>
            </:tools>
            <:body>
              <div class="row project-manager-row">
                <div class="project-manager-col">
                  <div class="project-manager workspace-creator">
                    <AppUi::Avatar @user={{this.model.workspace.createdBy}} @size="l" @minSize="m" />
                    <LinkTo @route="app.user.page" @model={{this.model.workspace.createdBy.id}} class="users-list-name">{{this.model.workspace.createdBy.name}}</LinkTo>
                    <span class="users-list-date">{{t "views.app.workspace.detail.createdBy"}}</span>
                  </div>
                </div>
                <div class="project-manager-details">
                  <h4>{{t "views.app.workspace.detail.description"}}</h4>
                  <p class="workspace-description">{{this.model.workspace.description}}</p>
                </div>
              </div>
              <div class="row workspace-facts">
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.projects"}}</h4>
                  <p class="workspace-project-count">{{this.model.workspace.projectCount}}</p>
                </div>
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.members"}}</h4>
                  <p class="workspace-member-count">{{this.model.workspace.memberCount}}</p>
                </div>
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.crossProjectLinks"}}</h4>
                  <p class="workspace-cross-project-links">
                    <span data-test-cross-project-links>{{this.model.workspace.crossProjectLinkCount}}</span>
                    <span class="text-muted" data-test-cross-project-blocking>{{t "views.app.workspace.detail.blocking" count=this.model.workspace.crossProjectBlockingCount}}</span>
                  </p>
                </div>
                <div class="col-xs-6">
                  <h4>{{t "views.app.workspace.detail.environment"}}</h4>
                  <p class="workspace-environment-fact" data-test-environment-fact>
                    {{#if this.runtimeName}}
                      <i class="fa fa-circle {{if this.model.workspace.runtimeOnline "text-green" "text-muted"}}" data-test-environment-dot aria-hidden="true"></i>
                      {{#if this.model.workspace.runtimeOnline}}
                        {{t "views.app.workspace.detail.runtimeOnline" name=this.runtimeName}}
                      {{else}}
                        {{t "views.app.workspace.detail.runtimeOffline" name=this.runtimeName}}
                      {{/if}}
                    {{else}}
                      {{t "views.app.workspace.detail.noRuntime"}}
                    {{/if}}
                  </p>
                </div>
              </div>
            </:body>
          </AppUi::Box>
        </AccessControl>

        {{!-- The projects of the workspace --}}
        <AccessControl @aclContext="project.read">
          <AppUi::Box @variant="info" @noPadding={{true}} class="workspace-projects">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.projects"}}</h3>
            </:header>
            <:body>
              <AppUi::DataTable @columns={{this.columns}} @rows={{this.model.projects}} @sort={{this.sort}} @order={{this.order}} @onSort={{this.sortData}}>
                <:cell as |project column|>
                  {{#if (eq column.key "name")}}
                    <span data-project-id={{project.id}}>
                      <LinkTo @route="app.project.index" @model={{project.shortCode}} data-test-project-name>{{project.name}}</LinkTo>
                      <span class="text-muted">({{project.shortCode}})</span>
                    </span>
                  {{else if (eq column.key "openIssueCount")}}
                    <span data-test-project-open-issues>{{project.openIssueCount}}</span>
                  {{else if (eq column.key "activeMilestoneName")}}
                    {{#if project.activeMilestoneName}}
                      <LinkTo @route="app.project.board" @model={{project.shortCode}} data-test-project-milestone>{{project.activeMilestoneName}}</LinkTo>
                    {{else}}
                      <span data-test-project-milestone>&ndash;</span>
                    {{/if}}
                  {{else if (eq column.key "repository")}}
                    <span data-test-project-repository>{{or (get this.model.repositoryNames project.id) "–"}}</span>
                  {{else if (eq column.key "manager")}}
                    {{#if project.manager.id}}
                      <span data-test-project-manager>
                        <AppUi::Avatar @user={{project.manager}} @size="s" />
                        <LinkTo @route="app.user.page" @model={{project.manager.id}}>{{project.manager.name}}</LinkTo>
                      </span>
                    {{else}}
                      <span data-test-project-manager>&ndash;</span>
                    {{/if}}
                  {{/if}}
                </:cell>
                <:empty>
                  <Exceptions::NothingFound @description={{t "views.app.workspace.detail.noProjects"}} />
                </:empty>
              </AppUi::DataTable>
            </:body>
            <:bottom>
              {{#if (or (gt this.offset 0) this.model.hasNextProjects)}}
                <div class="box-footer no-padding" data-workspace-projects-pagination>
                  <AppUi::Pager
                    @offset={{this.offset}}
                    @limit={{this.pageSize}}
                    @hasMore={{this.model.hasNextProjects}}
                    @count={{this.model.projects.length}}
                    @onPageChange={{this.changeOffset}}
                  />
                </div>
              {{/if}}
            </:bottom>
          </AppUi::Box>
        </AccessControl>

        {{!-- The activities recorded for the workspace --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="primary" class="workspace-activities">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.activities"}}</h3>
            </:header>
            <:body>
              {{#if this.hasActivities}}
                <AppUi::Timeline @activities={{this.activityGroups}} @dataKey="data" as |key|>
                  {{date-format key "Do MMM. YYYY"}}
                </AppUi::Timeline>
                {{#if this.hasMoreActivities}}
                  <div class="text-center" data-test-activities-more>
                    <button type="button" class="btn btn-default btn-sm" disabled={{this.isActivitiesLoading}} {{on "click" this.loadMoreActivities}}>{{t "views.app.workspace.detail.loadMore"}}</button>
                  </div>
                {{/if}}
              {{else if this.isActivitiesLoading}}
                <AppUi::Loader />
              {{else}}
                <AppUi::EmptyState @icon="fa-clock-o" @message={{t "views.app.workspace.detail.noActivities"}} />
              {{/if}}
            </:body>
          </AppUi::Box>
        </AccessControl>

      </div>

      <div class="col-md-4">

        {{!-- The members of the workspace's projects, read-only --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="warning" @noPadding={{true}} class="workspace-members">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.members"}} ({{this.model.workspace.memberCount}})</h3>
            </:header>
            <:body>
              <ul class="users-list clearfix">
                {{#if this.members.length}}
                  {{#each this.members as |member|}}
                    <li data-member-id={{member.id}} class="member-item">
                      <div class="member-avatar-wrap">
                        <AppUi::Avatar @user={{member}} @size="ml" />
                      </div>
                      <LinkTo @route="app.user.page" @model={{member.id}} class="users-list-name">{{member.name}}</LinkTo>
                    </li>
                  {{/each}}
                {{else}}
                  <Exceptions::NothingFound @description={{t "views.app.workspace.detail.noMembers"}} />
                {{/if}}
              </ul>
              <div class="box-footer text-center" data-members-manage>
                <LinkTo @route="app.workspaces.edit" @model={{this.model.workspace.shortCode}} data-test-manage-members>{{t "views.app.workspace.detail.manageMembers"}}</LinkTo>
              </div>
              {{#if this.hasMembersPages}}
                <div class="box-footer no-padding" data-members-pagination>
                  <AppUi::Pager
                    @offset={{this.membersOffset}}
                    @limit={{this.membersPageSize}}
                    @hasMore={{this.hasMoreMembers}}
                    @count={{this.members.length}}
                    @disabled={{this.isMembersLoading}}
                    @onPageChange={{this.loadMembers}}
                  />
                </div>
              {{/if}}
            </:body>
          </AppUi::Box>
        </AccessControl>

        {{!-- The environment of the workspace: its runtime and what runs in it --}}
        <AccessControl @aclContext="workspace.read">
          <AppUi::Box @variant="info" @noPadding={{true}} class="workspace-environment">
            <:header>
              <h3 class="box-title">{{t "views.app.workspace.detail.environment"}}</h3>
            </:header>
            <:body>
              <table class="table">
                <tbody>
                  <tr>
                    <td>{{t "views.app.workspace.detail.runtime"}}</td>
                    <td class="text-right" data-test-env-runtime>
                      {{#if this.runtimeName}}
                        <i class="fa fa-circle {{if this.model.workspace.runtimeOnline "text-green" "text-muted"}}" data-test-env-dot aria-hidden="true"></i>
                        {{this.runtimeName}}
                      {{else}}
                        {{t "views.app.workspace.detail.noRuntime"}}
                      {{/if}}
                    </td>
                  </tr>
                  <tr>
                    <td>{{t "views.app.workspace.detail.runsInProgress"}}</td>
                    <td class="text-right" data-test-env-runs>{{this.model.workspace.runsInProgress}}</td>
                  </tr>
                  <tr>
                    <td>{{t "views.app.workspace.detail.repositories"}}</td>
                    <td class="text-right" data-test-env-repositories>{{t "views.app.workspace.detail.repositoriesValue" total=this.model.workspace.repositoryCount project=this.model.workspace.projectRepositoryCount rest=this.workspaceRepositoryCount}}</td>
                  </tr>
                  <tr>
                    <td>{{t "views.app.workspace.detail.agents"}}</td>
                    <td class="text-right" data-test-env-agents>{{this.model.workspace.agentCount}}</td>
                  </tr>
                  <tr>
                    <td>{{t "views.app.workspace.detail.toolServers"}}</td>
                    <td class="text-right" data-test-env-toolservers>{{this.model.workspace.toolserverCount}}</td>
                  </tr>
                  <tr>
                    <td>{{t "views.app.workspace.detail.skills"}}</td>
                    <td class="text-right" data-test-env-skills>{{this.model.workspace.skillCount}}</td>
                  </tr>
                </tbody>
              </table>
            </:body>
            <:bottom>
              <div class="box-footer text-center" data-test-env-links>
                <LinkTo @route="app.workspaces.edit" @model={{this.model.workspace.shortCode}} data-test-env-link-environment>{{t "views.app.workspace.detail.environmentLink"}}</LinkTo>
                |
                <LinkTo @route="app.agent" data-test-env-link-agents>{{t "views.app.workspace.detail.agentsLink"}}</LinkTo>
              </div>
            </:bottom>
          </AppUi::Box>
        </AccessControl>

      </div>
    </div>
  </div>
  </section>
{{/if}}
