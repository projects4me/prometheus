<AppUi::Box @variant="info" class="workspace-environment-runtime">
  <:header>
    <h3 class="box-title">{{t "views.app.workspace.settings.environment.runtimeTitle"}}</h3>
  </:header>
  <:body>
    <p data-test-environment-runtime>
      {{#if this.runtimeName}}
        <AppUi::Icon @name="circle" class="{{if this.model.runtimeOnline "text-green" "text-muted"}}" data-test-environment-dot />
        <strong>{{this.runtimeName}}</strong>
        <span class="text-muted">({{this.runtimeKind}}, {{if this.model.runtimeOnline (t "views.app.workspace.settings.environment.online") (t "views.app.workspace.settings.environment.offline")}})</span>
      {{else}}
        {{t "views.app.workspace.detail.noRuntime"}}
      {{/if}}
    </p>

    {{#if this.canBind}}
      <div class="workspace-environment-bind">
        <FormFields::FieldRelate
          @renderInPlace={{true}}
          @placeholder={{t "views.app.workspace.settings.environment.runtimePlaceholder"}}
          @label={{t "views.app.workspace.settings.environment.runtimeLabel"}}
          @value={{this.selectedRuntimeId}}
          @options={{this.runtimeOptions}}
          @selected={{this.selectedRuntime}}
          @searchField="label"
          @onchange={{this.selectRuntime}}
          @relateType="relate-simple"
          @data-field="workspace.runtime"
        />

        {{#each this.runtimeErrors as |message|}}
          <div class="alert alert-danger" data-test-environment-error>{{message}}</div>
        {{/each}}

        <button type="button" class="btn btn-primary" data-btn="save-runtime" disabled={{this.saveDisabled}} {{on "click" this.bind}}>
          {{t "views.app.workspace.settings.environment.save"}}
        </button>
        {{#if this.isBound}}
          <button type="button" class="btn btn-default" data-btn="unbind-runtime" disabled={{this.saving}} {{on "click" this.unbind}}>
            {{t "views.app.workspace.settings.environment.unbind"}}
          </button>
        {{/if}}
      </div>
    {{/if}}
  </:body>
</AppUi::Box>

<AppUi::Box @variant="warning" class="workspace-environment-repositories" @noPadding={{true}}>
  <:header>
    <h3 class="box-title">{{t "views.app.workspace.settings.environment.repositoriesTitle"}}</h3>
  </:header>
  <:body>
    <AppUi::DataTable @columns={{this.columns}} @rows={{this.rows}}>
      <:cell as |repository column|>
        {{#if (eq column.key "name")}}
          <span data-repository-id={{repository.id}}>{{repository.name}}</span>
        {{else if (eq column.key "url")}}
          <span data-test-repository-url>{{repository.url}}</span>
        {{else if (eq column.key "baseBranch")}}
          <code data-test-repository-branch>{{repository.baseBranch}}</code>
        {{else if (eq column.key "project")}}
          <span data-test-repository-project>{{repository.project}}</span>
        {{/if}}
      </:cell>
      <:empty>
        <Exceptions::NothingFound @description={{t "views.app.workspace.settings.environment.empty"}} />
      </:empty>
    </AppUi::DataTable>
  </:body>
</AppUi::Box>
