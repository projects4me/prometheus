<div class="col-lg-10 col-md-12 col-sm-12 col-xs-12 role-details">
  <div class="role-details__toolbar">
    <AppUi::Button
      data-btn="close-role"
      type="button"
      class="btn btn-box-tool"
      data-toggle="tooltip"
      title={{t "global.form.close"}}
      @onClick={{this.closeRoleDetail}}
    >
      <i class="fa fa-times"></i>
    </AppUi::Button>
  </div>

  <div class="field-group">
    <FormFields::FieldText @placeholder={{t "views.app.role.create.nameplaceholder" }}
      @label={{t "views.app.role.create.name" }} @value={{this.model.name}} @data-field="role.name" @validate={{action
      this.validateField "roleCreate" (hash name="name" value=this.model.name)}}
      @message={{this.message.roleCreate.name}} @allowInlineEdit={{true}} @onBlur={{fn this.editRole 'name' }}
      @reset={{fn this.resetModelAttributes this.model}} @save={{fn this.editRole 'name' }} />

    <FormFields::FieldTextArea @placeholder={{t "views.app.role.create.descriptionplaceholder" }}
      @label={{t "views.app.role.create.description" }} @value={{this.model.description}} @data-field="role.description"
      @validate={{action this.validateField "roleCreate" (hash name="description" value=this.model.description)}}
      @message={{this.message.roleCreate.description}} @allowInlineEdit={{true}} @onBlur={{fn
      this.editRole 'description' }} @reset={{fn this.resetModelAttributes this.model}} @save={{fn
      this.editRole 'description' }} />
  </div>

  {{!-- Role members (inline, project-members pattern) --}}
  <AccessControl @aclContext="role.read">
    <div class="box box-warning role-members" data-role="role-members">
      <div class="box-header with-border box-header-flex box-header-no-content">
        <h3 class="box-title">{{t "views.app.role.tabs.user.members"}}</h3>
        <AppUi::DottedAddButton
          @title={{t "views.app.role.tabs.user.add"}}
          @onClick={{this.showAddUserroleDialog}}
          @class="pull-right"
          @aclContext="userrole.create"
          @data-add="userrole"
        />
      </div>
      <div class="box-body no-padding">
        <ul class="users-list clearfix" data-role="user-userroles">
          {{#if this.userroles.length}}
            {{#each this.userroles as |userrole|}}
              <li data-role-userrole-id={{userrole.id}} class="member-item">
                <AppUi::Button
                  data-btn="delete"
                  data-delete-member
                  type="button"
                  class="btn btn-box-tool"
                  data-toggle="tooltip"
                  title={{t "views.app.role.tabs.user.removeMember"}}
                  @onClick={{fn this.deleteUserrole userrole}}
                  @aclContext="userrole.delete"
                >
                  <i class="fa fa-times"></i>
                </AppUi::Button>

                <div class="member-avatar-wrap">
                  <img
                    src="{{this.apiHost}}/userimage/get/{{userrole.user.id}}"
                    alt="{{userrole.user.name}}"
                  >
                </div>
                <LinkTo @route="app.user.page" @model={{userrole.user.id}} class="users-list-name">
                  {{userrole.user.name}}
                </LinkTo>
              </li>
            {{/each}}
          {{else}}
            <Exceptions::NothingFound
              @description={{t "views.app.role.tabs.user.noMembers"}}
            />
          {{/if}}
        </ul>

        {{#if this.addUserroleDialog}}
          {{#bootstrap-modal
            title="views.app.role.tabs.user.userrole.title"
            confirmLabel="global.form.save"
            closeLabel="global.form.cancel"
            confirm=(action "addUserrole")
            close=(action "removeModal")
          }}
          <div class="box-body">
            <FormFields::FieldRelate
              @searchEnabled={{true}}
              @searchField="label"
              @placeholder={{t "views.app.role.tabs.user.userrole.selectuser"}}
              @label={{t "views.app.role.tabs.user.userrole.user"}}
              @value={{this.newUserrole.userId}}
              @data-field="userrole.user"
              @options={{this.usersList}}
              @onchange={{action "selectRelated" this.newUserrole 'userId'}}
              @selected={{find-by "value" this.newUserrole.userId this.usersList}}
              @relateType="relate-user"
              @validate={{action this.validateField "userroleCreate" (hash name="userId" value=this.newUserrole.userId model=this.newUserrole)}}
              @message={{this.message.userroleCreate.userId}}
              @aclContext="userrole.create"
            />
          </div>
          {{/bootstrap-modal}}
        {{/if}}
      </div>
    </div>
  </AccessControl>

  {{!-- Role permissions (flat Actions / Fields) --}}
  <div class="box box-info role-permissions-section" data-role="role-permissions">
    <div class="box-header with-border box-header-flex box-header-no-content">
      <h3 class="box-title">{{t "views.app.role.tabs.permission.title"}}</h3>
    </div>
    <div class="box-body">
      <Role::Permissions
        @permissionsByModule={{this.permissions}}
        @permissionsState={{this.permissionsState}}
        @updatePermission={{this.updatePermission}}
      />
    </div>
  </div>
</div>
