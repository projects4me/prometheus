<div class="role-details">

  {{!-- Role record: avatar block, name, description and facts --}}
  <div class="box box-primary role-record" data-role="role-record">
    <div class="box-header with-border box-header-flex box-header-no-content">
      <h3 class="box-title">{{t "views.app.role.record.title"}}</h3>
      <div class="box-tools pull-right">
        <AppUi::Button
          type="button"
          class="btn btn-box-tool"
          data-btn="delete-role"
          data-toggle="tooltip"
          title={{t "views.app.role.tabs.permission.deleteRole"}}
          @onClick={{fn this.deleteRole this.model}}
          @aclContext="role.delete"
        >
          <i class="fa fa-trash"></i>
        </AppUi::Button>
      </div>
    </div>
    <div class="box-body">
      <div class="role-record__identity">
        <span class="role-record__initials role-record__initials--{{this.facts.tier}}" aria-hidden="true" data-role-field="initials">{{this.facts.initials}}</span>
        <div class="role-record__heading">
          <h3 class="role-record__name" data-role-field="name">
            <AppUi::InlineEditable
              @value={{this.model.name}}
              @onSave={{fn this.saveModelAttribute this.model "name"}}
              @aclContext="role.update"
              @validate={{fn this.validateInlineField "roleCreate" "name"}}
              @message={{this.message.roleCreate.name}}
              @onClearMessage={{fn this.clearFieldMessage "roleCreate" "name"}}
            >
              <:display>{{this.model.name}}</:display>
              <:edit as |f|>
                <FormFields::FieldText
                  @value={{f.value}}
                  @type="text"
                  @placeholder={{t "views.app.role.create.nameplaceholder"}}
                  @onInput={{f.update}}
                  @validate={{fn this.validateField "roleCreate" (hash name="name" model=(hash name=f.value))}}
                  @message={{f.message}}
                  @data-field="role.name"
                  @lengthRequired={{false}}
                  autofocus
                  {{on "keydown" f.onKeydown}}
                />
              </:edit>
            </AppUi::InlineEditable>
          </h3>
          <div class="role-record__caption text-muted" data-role-field="audit">
            {{#if this.model.dateCreated}}
              {{t "views.app.role.record.created" date=(moment-format this.model.dateCreated "DD MMM YYYY") name=this.model.createdUserName}}
            {{/if}}
            {{#if this.model.dateModified}}
              · {{t "views.app.role.record.modified" date=(moment-format this.model.dateModified "DD MMM YYYY")}}
            {{/if}}
          </div>
        </div>
      </div>

      <div class="role-record__description" data-role-field="description">
        <AppUi::InlineEditable
          @value={{this.model.description}}
          @onSave={{fn this.saveModelAttribute this.model "description"}}
          @aclContext="role.update"
          @label={{t "views.app.role.record.description"}}
          @validate={{fn this.validateInlineField "roleCreate" "description"}}
          @message={{this.message.roleCreate.description}}
          @onClearMessage={{fn this.clearFieldMessage "roleCreate" "description"}}
          @submitOnEnter={{false}}
        >
          <:display><p class="role-record__description-text">{{this.model.description}}</p></:display>
          <:edit as |f|>
            <FormFields::FieldTextArea
              @value={{f.value}}
              @placeholder={{t "views.app.role.create.descriptionplaceholder"}}
              @onInput={{f.update}}
              @validate={{fn this.validateField "roleCreate" (hash name="description" model=(hash description=f.value))}}
              @message={{f.message}}
              @data-field="role.description"
              autofocus
              {{on "keydown" f.onKeydown}}
            />
          </:edit>
        </AppUi::InlineEditable>
      </div>

      <div class="role-record__facts row">
        <div class="col-sm-4" data-role-fact="access">
          <h4>{{t "views.app.role.record.access"}}</h4>
          {{#if this.facts.known}}
            <span class="label role-record__granted role-record__granted--{{this.facts.tier}}" data-role-field="granted">{{t "views.app.role.browser.granted" percent=this.facts.granted}}</span>
            {{#if this.facts.denied}}
              <span class="label label-danger" data-role-field="denied">{{t "views.app.role.browser.denied" percent=this.facts.denied}}</span>
            {{/if}}
          {{else}}
            <span class="text-muted">{{t "views.app.role.card.accessUnknown"}}</span>
          {{/if}}
        </div>
        <div class="col-sm-4" data-role-fact="members">
          <h4>{{t "views.app.role.record.members"}}</h4>
          <span data-role-field="members">{{this.userroles.length}}</span>
        </div>
        <div class="col-sm-4" data-role-fact="actions">
          <h4>{{t "views.app.role.record.actions"}}</h4>
          <span data-role-field="actions">{{t "views.app.role.record.actionsOf" allowed=this.facts.allowed total=this.facts.total}}</span>
        </div>
      </div>
    </div>
  </div>

  {{!-- Role members (inline, project-members pattern) --}}
  <AccessControl @aclContext="role.read">
    <div class="box box-warning role-members" data-role="role-members">
      <div class="box-header with-border box-header-flex box-header-no-content">
        <h3 class="box-title">{{t "views.app.role.tabs.user.members"}}</h3>
        <AppUi::DottedAddButton
          @title={{t "views.app.role.tabs.user.add"}}
          @onClick={{this.showAddUserroleDialog}}
          @class="pull-right"
          @aclContext="userrole.create"
          @data-add="userrole"
        />
      </div>
      <div class="box-body no-padding">
        <ul class="users-list clearfix" data-role="user-userroles">
          {{#if this.userroles.length}}
            {{#each this.previewUserroles as |userrole|}}
              <li data-role-userrole-id={{userrole.id}} class="member-item">
                <AppUi::Button
                  data-btn="delete"
                  data-delete-member
                  type="button"
                  class="btn btn-box-tool"
                  data-toggle="tooltip"
                  title={{t "views.app.role.tabs.user.removeMember"}}
                  @onClick={{fn this.deleteUserrole userrole}}
                  @aclContext="userrole.delete"
                >
                  <i class="fa fa-times"></i>
                </AppUi::Button>

                <div class="member-avatar-wrap">
                  <img
                    src="{{this.apiHost}}/userimage/get/{{userrole.user.id}}"
                    alt="{{userrole.user.name}}"
                  >
                </div>
                <LinkTo @route="app.user.page" @model={{userrole.user.id}} class="users-list-name">
                  {{userrole.user.name}}
                </LinkTo>
              </li>
            {{/each}}
          {{else}}
            <Exceptions::NothingFound
              @description={{t "views.app.role.tabs.user.noMembers"}}
            />
          {{/if}}
        </ul>

        {{#if this.showViewAllMembers}}
          <div class="box-footer text-center">
            <a
              href="javascript:void(0)"
              class="uppercase"
              data-btn="view-all-members"
              {{on "click" this.showViewAllMembersDialog}}
            >
              {{t "views.app.role.tabs.user.viewallmembers"}}
            </a>
          </div>
        {{/if}}

        {{#if this.addUserroleDialog}}
          {{#bootstrap-modal
            title="views.app.role.tabs.user.userrole.title"
            confirmLabel="global.form.save"
            closeLabel="global.form.cancel"
            confirm=(action "addUserrole")
            close=(action "removeModal")
            disableSaveBtn=(or this.isAddingUserroles (not this.usersList.length))
          }}
          <div class="form-group" data-role="add-userrole-form">
            {{#if this.usersList.length}}
              <FormFields::FieldRelateMulti
                @searchEnabled={{true}}
                @searchField="label"
                @placeholder={{t "views.app.role.tabs.user.userrole.selectuser"}}
                @label={{t "views.app.role.tabs.user.userrole.user"}}
                @data-field="userrole.user"
                @options={{this.usersList}}
                @selected={{this.selectedUsers}}
                @onchange={{action "selectStatic" this 'selectedUsers'}}
                @relateType="relate-user"
                @closeOnSelect={{false}}
                @aclContext="userrole.create"
              />
            {{else}}
              <div data-role="add-userrole-empty">
                <Exceptions::NothingFound
                  @description={{t "views.app.role.tabs.user.userrole.noEligibleUsers"}}
                />
              </div>
            {{/if}}
          </div>
          {{/bootstrap-modal}}
        {{/if}}

        {{#if this.viewAllMembersDialog}}
          {{#bootstrap-modal
            title="views.app.role.tabs.user.viewallmembers"
            closeLabel="global.form.close"
            close=(action "removeViewAllMembersModal")
          }}
            <div class="role-members-view-all" data-role="role-members-view-all">
              <div class="role-members-view-all__search">
                <div class="input-group">
                  <span class="input-group-addon">
                    <i class="fa fa-search" aria-hidden="true"></i>
                  </span>
                  <Input
                    data-field="search role members"
                    @value={{this.membersSearchQuery}}
                    name="membersQuery"
                    class="form-control"
                    autocomplete="off"
                    placeholder={{t "views.app.role.tabs.user.search"}}
                  />
                </div>
              </div>
              <ul class="role-members-view-all__list" data-role="role-members-view-all-list">
                {{#if this.filteredModalUserroles.length}}
                  {{#each this.filteredModalUserroles as |userrole|}}
                    <li
                      data-role-userrole-id={{userrole.id}}
                      class="role-members-view-all__item"
                    >
                      <img
                        class="role-members-view-all__avatar"
                        src="{{this.apiHost}}/userimage/get/{{userrole.user.id}}"
                        alt="{{userrole.user.name}}"
                      >
                      <div class="role-members-view-all__info">
                        <LinkTo
                          @route="app.user.page"
                          @model={{userrole.user.id}}
                          class="role-members-view-all__name"
                        >
                          {{userrole.user.name}}
                        </LinkTo>
                        {{#if userrole.user.email}}
                          <span class="role-members-view-all__email">
                            {{userrole.user.email}}
                          </span>
                        {{/if}}
                      </div>
                    </li>
                  {{/each}}
                {{else}}
                  <Exceptions::NothingFound
                    @description={{t "views.app.role.tabs.user.noMembersMatch"}}
                  />
                {{/if}}
              </ul>
            </div>
          {{/bootstrap-modal}}
        {{/if}}
      </div>
    </div>
  </AccessControl>

  {{!-- Role permissions (flat Actions / Fields) --}}
  <div class="box box-info role-permissions-section" data-role="role-permissions">
    <div class="box-header with-border box-header-flex box-header-no-content">
      <h3 class="box-title">{{t "views.app.role.tabs.permission.title"}}</h3>
    </div>
    <div class="box-body">
      <Role::Permissions
        @permissionsByModule={{this.permissions}}
        @permissionsState={{this.permissionsState}}
      />
    </div>
    <div class="box-footer">
      <AppUi::Button type="button" data-btn="save" class="btn btn-primary" @onClick={{this.savePermissions}}>
        {{t "views.app.role.tabs.permission.save"}}
      </AppUi::Button>
    </div>
  </div>
</div>
