<section class="content-header">
  <h1>{{t "views.nav.menu.settings.label"}}</h1>
  <BreadCrumb/>
</section>

<section class="content settings">
  <div class="row">
    <div class="col-md-3">
      <div class="box box-primary settings-nav" data-settings-nav>
        <div class="box-header with-border">
          <h3 class="box-title">{{t "views.nav.menu.settings.label"}}</h3>
        </div>
        <div class="box-body">
          {{#each this.model as |group|}}
            <div class="settings-nav__group" data-settings-group={{group.key}}>{{t group.label}}</div>
            <ul class="nav nav-pills nav-stacked">
              {{#each group.items as |item|}}
                <li class={{if (is-active-route item.route) "active"}} data-settings-item={{item.name}}>
                  <LinkTo @route={{item.route}}>
                    <i class="fa fa-{{item.icon}}"></i> {{t item.label}}
                  </LinkTo>
                </li>
              {{/each}}
            </ul>
          {{/each}}
        </div>
      </div>
    </div>
    <div class="col-md-9 settings-content">
      {{outlet}}
    </div>
  </div>
</section>
