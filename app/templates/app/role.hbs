<div class="roles">
  <section class="content-header">
    <h1> {{t "global.module.plural.role"}} </h1>
    <BreadCrumb/>
  </section>

  <section class="content">
    <div class="row">
      <div class="col-md-3">
        <QuickList
          @title={{t "global.module.plural.role"}}
          @items={{this.listedRoles}}
          @hasNext={{this.hasNext}}
          @isLoading={{this.isListLoading}}
          @error={{this.listError}}
          @onRetry={{this.reloadList}}
          @activeId={{this.selectedRoleId}}
          @page={{this.page}}
          @limit={{this.pageSize}}
          @onPage={{this.changePage}}
          @sortOptions={{this.sortOptions}}
          @sort={{this.sort}}
          @order={{this.listOrder}}
          @onSort={{this.sortList}}
          @groupOptions={{this.groupOptions}}
          @groupBy={{this.group}}
          @onGroup={{this.groupList}}
          class="role-browser"
          data-role-browser
        >
          <:actions>
            <AccessControl @aclContext="role.create">
              <button type="button" class="btn btn-primary btn-sm" {{on "click" this.showAddRoleDialog}} data-btn="role-add">
                <i class="fa fa-plus"></i> {{t "views.app.role.browser.new"}}
              </button>
            </AccessControl>
          </:actions>
          <:search>
            {{#if this.querySchema}}
              <div class="box-body role-search" data-role-search>
                <EzSearchCompact
                  @schema={{this.querySchema}}
                  @query={{this.query}}
                  @savedSearches={{this.ezSavedSearches}}
                  @activeSavedSearchId={{this.searchId}}
                  @onSavedSearchChange={{this.selectSavedSearch}}
                  @onApply={{this.applyQuery}}
                  @onSave={{this.showEzSaveSearchDialog}}
                  @onUpdateSavedSearch={{this.updateEzSavedSearch}}
                  @aclContext="role.read"
                />
              </div>
            {{/if}}
          </:search>
          <:item as |role Item|>
            {{#let (get this.rowsById role.id) as |row|}}
              <Item @route="app.role.page" @model={{role.id}} class="role-row role-row--{{row.tier}}" data-role={{role.id}}>
                <:leading>
                  <span class="role-row__initials" aria-hidden="true" data-role-field="initials">{{row.initials}}</span>
                </:leading>
                <:primary>
                  <span class="role-row__name" data-role-field="name">{{role.name}}</span>
                  {{#if row.loaded}}
                    <span class="role-row__access" data-role-field="coverage">
                      <span class="role-row__granted" title={{t "views.app.role.card.accessGranted" percent=row.granted}} data-role-field="granted">{{t "views.app.role.browser.granted" percent=row.granted}}</span>
                      {{#if row.denied}}
                        <span class="role-row__denied" title={{t "views.app.role.card.accessDenied" percent=row.denied}} data-role-field="denied">{{t "views.app.role.browser.denied" percent=row.denied}}</span>
                      {{/if}}
                    </span>
                  {{/if}}
                </:primary>
                <:secondary>
                  <div class="role-row__description {{unless row.description "role-row__description--empty"}}" data-role-field="description">
                    {{if row.description row.description (t "views.app.role.card.noDescription")}}
                  </div>
                  <div class="role-row__footer">
                    <span class="role-row__members" data-role-field="members">
                      {{#if row.members.length}}
                        <Project::MemberAvatars @members={{row.members}} @maxVisible={{2}} />
                      {{else}}
                        {{t "views.app.role.card.noMembers"}}
                      {{/if}}
                    </span>
                    {{#if row.modified}}
                      <span class="role-row__modified" data-role-field="dateModified">{{date-format row.modified "DD MMM YYYY"}}</span>
                    {{/if}}
                  </div>
                </:secondary>
              </Item>
            {{/let}}
          </:item>
        </QuickList>

        {{#if this.addRoleDialog}}
          {{#bootstrap-modal
            title="views.app.role.create.title"
            confirmLabel="global.form.save"
            closeLabel="global.form.cancel"
            confirm=this.addRole
            close=this.removeModal
          }}
            <div class="box-body">
              <FormFields::FieldText
                @placeholder={{t "views.app.role.create.nameplaceholder"}}
                @label={{t "views.app.role.create.name"}}
                @value={{this.newRole.name}}
                @data-field="role.name"
                @validate={{fn this.validateField "roleCreate" (hash name="name" value=this.newRole.name model=this.newRole)}}
                @message={{this.message.roleCreate.name}}
              />

              <FormFields::FieldTextArea
                @placeholder={{t "views.app.role.create.descriptionplaceholder"}}
                @label={{t "views.app.role.create.description"}}
                @value={{this.newRole.description}}
                @data-field="role.description"
                @validate={{fn this.validateField "roleCreate" (hash name="description" value=this.newRole.description model=this.newRole)}}
                @message={{this.message.roleCreate.description}}
              />
            </div>
          {{/bootstrap-modal}}
        {{/if}}

        {{#if this.saveSearchDialog}}
          {{#bootstrap-modal
              title="global.form.savesearch"
              confirmLabel="global.form.save"
              closeLabel="global.form.cancel"
              confirm=this.saveEzSearch
              close=this.removeSaveSearchDialog}}

            <div class="ember-view">
              <label>{{t "views.app.issue.list.savedsearch.query"}}</label>
              <span data-save-search-query>{{this.saveSearchQuery}}</span>
            </div>

            <FormFields::FieldText
              @placeholder={{t "views.app.issue.list.savedsearch.inputname"}}
              @label={{t "views.app.issue.list.savedsearch.name"}}
              @value={{this.newSavedsearch.name}}
            />

          {{/bootstrap-modal}}
        {{/if}}
      </div>

      <div class="col-md-9">
        {{outlet}}
      </div>
    </div>
  </section>
</div>
