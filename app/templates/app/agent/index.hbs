<section class="content-header">
  <h1>
    {{t "global.module.plural.agent"}}
    <small>{{t "views.app.agent.list.subtitle"}}</small>
  </h1>
  <BreadCrumb/>
</section>

<section class="content">
  <div class="row module agents agents-list">
    <div class="col-md-12">
      <AccessControl @aclContext="agent.read">
        <div class="box box-primary list-view">
          <AppUi::ListToolbar>
            <:search>
              {{#if this.querySchema}}
                <EzSearch
                  @schema={{this.querySchema}}
                  @query={{this.query}}
                  @savedSearches={{this.ezSavedSearches}}
                  @activeSavedSearchId={{this.searchId}}
                  @onSavedSearchChange={{this.selectSavedSearch}}
                  @onApply={{this.applyQuery}}
                  @aclContext="agent.read"
                />
              {{/if}}
            </:search>
            <:selection>
              <span class="btn btn-default btn-sm checkbox-toggle" data-toggle="tooltip" title="{{t "global.list.selectAll"}}">
                <FormFields::FieldCheckbox @select={{this.selectAll}} @data-select="all" @aclContext="agent.read"/>
              </span>
              <div class="btn-group">
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-test-list-action="delete" title="{{t "global.form.delete"}}" @onClick={{this.deleteSelected}} @aclContext="agent.delete"><i class="fa fa-trash-o"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-test-list-action="activate" title="{{t "views.app.module.list.activation.activate"}}" @onClick={{fn this.setSelectedActive true}} @aclContext="agent.update"><i class="fa fa-toggle-on"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-test-list-action="deactivate" title="{{t "views.app.module.list.activation.deactivate"}}" @onClick={{fn this.setSelectedActive false}} @aclContext="agent.update"><i class="fa fa-toggle-off"></i></AppUi::Button>
                <AppUi::Button type="button" class="btn btn-default btn-sm" data-toggle="tooltip" data-test-list-action="export" title="{{t "views.app.module.list.export.label"}}" @onClick={{this.exportSelected}} @aclContext="agent.read"><i class="fa fa-download"></i></AppUi::Button>
              </div>
            </:selection>
            <:pager>
              <span class="list-view-count">{{t "global.list.selectedCount" count=this.checkboxCount}}</span>
              <AppUi::Pager @offset={{this.offset}} @limit={{this.pageSize}} @count={{this.model.length}} @hasMore={{if this.model.meta.links.next true false}} @onPageChange={{this.changeOffset}} />
            </:pager>
          </AppUi::ListToolbar>

          <div class="box-body no-padding">
            <AppUi::DataTable @columns={{this.columns}} @rows={{this.model}} @sort={{this.sort}} @order={{this.order}} @selectable={{true}} @onSort={{this.sortData}} @onSelect={{this.selectRow}}>
              <:cell as |agent column|>
                {{#if (eq column.key "agent")}}
                  <AppUi::Avatar @user={{agent.user}} @size="m" />
                  <div>
                    <LinkTo @route="app.agent.page" @model={{agent.id}} data-test-agent-name>{{agent.name}}</LinkTo>
                    {{#if agent.isActive}}
                      <span class="label label-success" data-test-agent-status>{{t "views.app.agent.status.active"}}</span>
                    {{else}}
                      <span class="label label-danger" data-test-agent-status>{{t "views.app.agent.status.disabled"}}</span>
                    {{/if}}
                    <span class="agent-purpose">{{agent.purpose}}</span>
                  </div>
                {{else if (eq column.key "sponsor")}}
                  {{#if agent.sponsor.id}}
                    <LinkTo @route="app.user.page" @model={{agent.sponsor.id}}>{{agent.sponsor.name}}</LinkTo>
                  {{else}}
                    <em>{{t "views.app.agent.autonomous"}}</em>
                  {{/if}}
                {{else if (eq column.key "projects")}}
                  {{#each (call (fn this.projectsOf agent)) as |project|}}
                    <span class="label label-default">{{project.name}}</span>
                  {{/each}}
                {{else if (eq column.key "grants")}}
                  &mdash;
                {{else if (eq column.key "last-active")}}
                  {{#if agent.user.lastActivityAt}}
                    {{format-date-time date=agent.user.lastActivityAt humanize=true}}
                  {{else}}
                    {{t "views.app.user.management.list.noLastActivity"}}
                  {{/if}}
                {{else}}
                  {{get agent column.key}}
                {{/if}}
              </:cell>
              <:rowActions as |agent|>
                <AccessControl @aclContext="agent.update">
                  <LinkTo @route="app.agent.edit" @model={{agent.id}} class="btn btn-default btn-sm" data-test-row-action="edit" title={{t "global.form.edit"}}>
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                  </LinkTo>
                </AccessControl>
              </:rowActions>
              <:empty>
                <Exceptions::NothingFound @description={{t "views.app.agent.list.noAgents"}} />
              </:empty>
            </AppUi::DataTable>
          </div>
        </div>
      </AccessControl>
    </div>
  </div>
</section>
