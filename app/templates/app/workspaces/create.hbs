<section class="content-header">
  <h1>
    {{t "views.app.workspace.create.header"}}
  </h1>
  <BreadCrumb/>
</section>

<section class="content">
  <div class="row">
    <AccessControl @aclContext="workspace.create">
      <div class="col-md-8">
        <Workspace::DetailsForm
          @model={{this.model}}
          @message={{this.message}}
          @validateField={{this.validateField}}
          @usersList={{this.usersList}}
          @selectRelated={{fn this.selectRelated this.model 'managerId'}}
          @aclContext="workspace.create"
          @onSave={{fn this.save "workspaceCreate"}}
          @onCancel={{this.cancel}}
        />
      </div>
    </AccessControl>
  </div>
</section>
