<div class="interval-selector">
  <div class="days">
    <label for="days-input">{{t "views.app.components.intervalselector.days"}}</label>
    <Input 
      @type="number" 
      @value={{this.days}} 
      min="0" 
      max="99" 
      id="days-input"
      {{on "input" this.updateDays}}
    />
  </div>

  <div class="hours">
    <label for="hours-input">{{t "views.app.components.intervalselector.hours"}}</label>
    <Input 
      @type="number" 
      @value={{this.hours}} 
      min="0" 
      max="8" 
      id="hours-input"
      {{on "input" this.updateHours}}
    />
  </div>

  <div class="minutes">
    <label for="minutes-input">{{t "views.app.components.intervalselector.minutes"}}</label>
    <Input 
      @type="number" 
      @value={{this.minutes}} 
      min="0" 
      max="60" 
      step="5" 
      id="minutes-input"
      {{on "input" this.updateMinutes}}
    />
  </div>
</div>
