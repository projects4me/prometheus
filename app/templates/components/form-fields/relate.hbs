<div class="input-group select-input">
  {{#power-select
      class="form-control"
      options=this.options
      placeholder=this.placeholder
      selected=this.selected
      searchField=this.searchField
      onChange=this.onchange
      matcher=this.matcher
      onblur=this.focus-out
  as |data|}}
    {{component this.relateType data=data}}
  {{/power-select}}
</div>
<span class="highlight"></span>
<span class="bar"></span>
<label class="floating-label">{{this.label}}</label>
<span class="count pull-right">{{#if this.length}}{{this.value.length}}/{{this.length}}{{/if}}</span>
{{#if this.v-focus}}
  <span class="error text-red">
    {{v-get this.v-model this.v-field this.v-output}}
  </span>
{{/if}}