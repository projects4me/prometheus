{{#each-in this.options as |idx option|}}

  <div class="radio radio-primary">
    {{!--input type="radio" name="{{elementId}}-option" value="{{option.value}}" --}}
    {{input
        type="radio"
        value=option.value
        change=this.changed
        name=(concat this.elementId "-option")}}

    <label>
      {{option.label}}
    </label>
  </div>

{{/each-in}}