{{!-- Detail template for text input field--}}
<label>{{t this.definition.label}}:</label>
{{#if this.definition.help}}<i data-toggle="tooltip" data-placement="top" title="{{t this.definition.help}}" class="fa fa-question-circle"></i>{{/if}}
<div class="clearfix"></div>
<div class="fieldValue">
  {{get-prop this.model this.definition.fieldName}}
</div>
