<div class="row">
  <div class="col-md-6 app-updates">
    <div class="content">
      <h2>
        {{t "views.signin.workspaceTitle"}}
      </h2>
      <img src="/img/pm.png" alt="Project Management">
    </div>
  </div>

  <div class="col-md-6">
    <div class="login-container">
      <div class="login-box">
        <div class="login-logo">
          <a><img alt="{{t "application"}}" src="/img/reset-password.png">
            <div class="clearfix"></div>{{safe-html (t "views.signin.resetPassword.title")}}
          </a>
        </div>
        <div class="login-box-body" data-reset-password-box>
          <p class="title">{{t "views.signin.resetPassword.message"}}</p>

          <FormFields::FieldText
            @placeholder={{t "views.signin.resetPassword.password"}}
            @type="password"
            @value={{this.password}}
            @data-field="user.password"
            @lengthRequired={{false}}
            @validate={{action this.validateField "resetPassword" (hash name="password" value=this.password model=(hash password=this.password passwordConfirmation=this.passwordConfirmation))}}
            @message={{this.message.resetPassword.password}}
          />

          <FormFields::FieldText
            @placeholder={{t "views.signin.resetPassword.confirm"}}
            @type="password"
            @value={{this.passwordConfirmation}}
            @data-field="user.confirmPassword"
            @lengthRequired={{false}}
            @validate={{action this.validateField "resetPassword" (hash name="passwordConfirmation" value=this.passwordConfirmation model=(hash password=this.password passwordConfirmation=this.passwordConfirmation))}}
            @message={{this.message.resetPassword.passwordConfirmation}}
          />

          <div class="text-center">
            <AppUi::Button
              data-reset-password-btn
              type="button"
              data-btn="save"
              class="btn btn-primary"
              @onClick={{this.updateUserPassword}}
            >
              {{t "views.signin.resetPassword.changePassword"}}
            </AppUi::Button>

            <LinkTo @route="signin" class="btn btn-default" data-back-to-signin>
              <i class="fa fa-angle-left" aria-hidden="true"></i>
              {{t "views.signin.forgetPassword.backToSignin"}}
            </LinkTo>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>