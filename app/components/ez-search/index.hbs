<div class="ez-search" data-ez-search {{did-update this.onActiveChange @activeSavedSearchId @savedSearches}} ...attributes>
  <div class="search ez-search-toolbar">
    <div class="ez-search-saved" data-ez-saved>
      <AppUi::Dropdown @isPrimary={{true}}>
        <:button>
          <i class="fa fa-bookmark visible-xs-inline"></i>
          <span class="sr-only visible-xs-inline">{{t "views.app.issue.list.savedsearch.label"}}</span>
          {{#if this.pickedSearch}}
            <span class="hidden-xs ez-search-saved-name" title={{this.pickedSearch.name}} data-ez-saved-name>{{this.pickedSearch.name}}</span>
            {{#if this.isEdited}}
              <span class="hidden-xs ez-search-saved-edited" data-ez-saved-edited>&middot; {{t "components.ezSearch.savedSearch.edited"}}</span>
            {{/if}}
          {{else}}
            <span class="hidden-xs">{{t "views.app.issue.list.savedsearch.label"}}</span>
          {{/if}}
        </:button>
        <:content>
          {{#if this.isEdited}}
            {{#if @onUpdateSavedSearch}}
              <button type="button" data-ez-saved-update {{on "click" this.updateSaved}}>{{t "components.ezSearch.savedSearch.update" name=this.pickedSearch.name}}</button>
            {{/if}}
            {{#if @onSave}}
              <button type="button" data-ez-saved-save-new {{on "click" this.save}}>{{t "components.ezSearch.savedSearch.saveAsNew"}}</button>
            {{/if}}
            <button type="button" data-ez-saved-revert {{on "click" this.revert}}>{{t "components.ezSearch.savedSearch.revert"}}</button>
          {{/if}}
          {{#each this.searches as |item|}}
            <button type="button" class={{if item.active "active"}} data-ez-saved-item {{on "click" (fn this.pickSaved item.search)}}>
              {{item.search.name}}
              {{#if item.active}}
                <i class="fa fa-check pull-right"></i>
              {{/if}}
            </button>
          {{/each}}
        </:content>
      </AppUi::Dropdown>
    </div>

    <div class="ez-search-field" {{did-update this.reload @query}}>
      {{! A new loadId remounts the bar so a load drops its unparsed draft and errors. }}
      {{#each (array this.loadId) key="@identity"}}
        <EzSearch::SearchBar
          @tree={{this.tree}}
          @schema={{@schema}}
          @onChange={{this.onTreeChange}}
          @onErrors={{this.onBarErrors}}
          @onRun={{this.apply}}
          @placeholder={{t "global.form.search"}}
        />
      {{/each}}
      {{#each this.storedMessages as |message|}}
        <span class="error text-red ez-search-error" data-ez-stored-error>{{message}}</span>
      {{/each}}
    </div>

    <button
      type="button"
      class="btn btn-default ez-search-builder {{if this.builderOpen 'active'}}"
      title={{t "components.ezSearch.builderToggle"}}
      aria-pressed={{if this.builderOpen "true" "false"}}
      data-ez-builder-toggle
      {{on "click" this.toggleBuilder}}
    >
      <i class="fa fa-sliders"></i>
      <span class="hidden-xs">{{t "components.ezSearch.builderToggle"}}</span>
    </button>

    <div class="ez-search-actions">
      <AppUi::Button
        class="btn btn-primary"
        @onClick={{this.apply}}
        @aclContext={{@aclContext}}
        disabled={{this.hasErrors}}
        data-ez-search-apply
      >{{t "global.form.search"}}</AppUi::Button>
      <AppUi::Button class="btn btn-default" @onClick={{this.clear}} data-ez-search-clear>{{t "global.form.clear"}}</AppUi::Button>
    </div>
  </div>

  {{#if this.builderOpen}}
    <div class="ez-search-builder-area">
      <EzSearch::Panel @tree={{this.tree}} @schema={{@schema}} @onChange={{this.onTreeChange}} />
      {{#if @onSave}}
        <div class="ez-search-save text-right">
          <button type="button" class="btn btn-primary" data-ez-save {{on "click" this.save}}>{{t "global.form.savesearch"}}</button>
        </div>
      {{/if}}
    </div>
  {{/if}}
</div>
