<div class="info-box bg-green" data-milestone-id={{@milestone.id}} data-milestone={{concat @milestone.name " | " @milestone.startDate}}>
  <span class="info-box-icon"><AppUi::Icon @name="check" /></span>

  <div class="info-box-content" data-milestone-status={{@milestone.status}}>
    <span class="info-box-text">{{t (concat "views.app.milestone.lists.status." @milestone.status)}}</span>
    {{yield}}
  </div>
</div>
