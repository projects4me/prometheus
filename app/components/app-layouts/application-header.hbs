<header class="main-header">
   {{!-- Logo --}}
<LinkTo @route="app.index" class="logo">
  <span class="logo-mini"><img alt="{{t "application"}}" src="/img/app/logo-256.png"></span>
  <span class="logo-lg"><img alt="{{t "application"}}" src="/img/app/logo-256.png">{{safe-html (t "views.app.application.header.title")}}</span>
</LinkTo>

{{!-- He ader Navbar --}}
<nav class="navbar navbar-static-top" role="navigation">
  {{!-- Sidebar toggle button--}}
  <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button" title="{{t "views.app.togglenav"}}">
    <span class="sr-only">{{t "views.app.togglenav"}}</span>
  </a>
  <div class="global-search">

    <PowerSelect
      @placeholder={{t "global.form.searchPlaceholder"}}
      @searchEnabled={{true}}
      @search={{perform this.search}}
      @onChange={{this.itemSelected}} as |issue|>
      <i class="fa fa-tasks"></i> <strong>#{{issue.number}}</strong> - {{issue.name}}
    </PowerSelect> 
  </div>

  {{!-- Navbar Right Menu --}}
  <div class="navbar-custom-menu">
    <ul class="nav navbar-nav">

      {{!-- Create Modules e.g. Project,Issue,Conversation --}}
      <li>
        <div class="create-modules">
          <button class="create-module-btn btn btn-primary" {{on "click" this.toggleCreateDropdown}}>{{t "global.form.new"}}<i class="fa fa-caret-down"></i>
          <div class="create-module-dropdown-content {{if this.isCreateDropdownOpen 'show'}}"  {{on "click" (fn (mut this.isCreateDropdownOpen) false)}}>
            <LinkTo @route="app.project.issue.create" @model={{this.trackedProject.shortCode}} class="{{if (not this.trackedProject.shortCode) 'pointer-none'}}">{{t "global.module.singular.issue"}}</LinkTo>
            <LinkTo @route="app.project.conversation" @model={{this.trackedProject.shortCode}} class="{{if (not this.trackedProject.shortCode) 'pointer-none'}}">{{t "global.module.singular.conversation"}}</LinkTo>
            <LinkTo @route="app.projects.create">{{t "global.module.singular.project"}}</LinkTo>
          </div>            
          </button>          
        </div>
      </li>

      {{!-- Notifications Menu --}}
      <li class="dropdown notifications-menu">
        {{!-- Add a button to toggle the sidebar instead of dropdown --}}
        <AppUi::Button type="button" class="toggle-notifications-sidebar" @onClick={{this.toggleNotificationsSidebar}}>
          <i class="fa {{if this.notifications.hasUnreadNotifications 'fa-bell notification-bell-unread' 'fa-bell-o'}}"></i>
        </AppUi::Button>
      </li>


      {{!-- User Account Menu --}}
      <li class="dropdown user user-menu">
        {{!-- Menu Toggle Button --}}
        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
          {{!-- The user image in the navbar--}}
          <img src="{{this.apiHost}}/userimage/get/{{this.currentUser.user.id}}" class="user-image" alt="{{this.currentUser.user.name}}">
          {{!-- hidden-xs hides the username on small devices so only the image appears. --}}
          <span id="user-name" class="hidden-xs">{{this.currentUser.user.name}}</span>

        </a>
        <ul class="dropdown-menu">
          {{!-- The user image in the menu --}}
          <li class="user-header">
            <img src="{{this.apiHost}}/userimage/get/{{this.currentUser.user.id}}" class="img-circle" alt="{{this.currentUser.user.name}}">

            <p>
              {{this.currentUser.user.name}} - {{this.currentUser.user.title}}
              <small>{{t "views.app.member"}}{{format-date date=this.currentUser.user.dateCreated format='MMM YYYY'}}</small>
            </p>
          </li>
          {{!-- Menu Footer--}}
          <li class="user-footer">
            <div class="pull-left">
              <LinkTo @route="app.user.page" @model={{this.currentUser.user.id}} class="btn btn-default btn-flat" {{action "viewProfile"}}>{{t "views.app.profile"}}</LinkTo>
            </div>
            <div class="pull-right">
              {{#if this.session.isAuthenticated}}
                <div id="btn-signout">
                  <a class="btn btn-default btn-flat" href="javascript:void(0);" {{action 'signOut'}}>{{t "global.form.signout"}}</a>
                </div>
              {{else}}
                <div id="btn-signin">
                  <a class="btn btn-default btn-flat" href="javascript:void(0)" {{action 'signIn'}}>{{t "global.form.signin"}}</a>
                </div>
              {{/if}}
            </div>
          </li>
        </ul>
      </li> 
    </ul>
  </div>
</nav>
</header>