<header class="main-header">
   {{!-- Logo --}}
<LinkTo @route="app.index" class="logo">
  <span class="logo-mini"><img alt="{{t "application"}}" src="/img/app/logo-256.png"></span>
  <span class="logo-lg"><img alt="{{t "application"}}" src="/img/app/logo-256.png">{{safe-html (t "views.app.application.header.title")}}</span>
</LinkTo>

{{!-- He ader Navbar --}}
<nav class="navbar navbar-static-top" role="navigation">
  {{!-- Sidebar toggle button--}}
  <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button" title="{{t "views.app.togglenav"}}">
    <span class="sr-only">{{t "views.app.togglenav"}}</span>
  </a>
  <AppLayouts::ProjectSwitcher @projects={{@projects}} />
  <div class="global-search">

    <AppUi::Select
      @placeholder={{t "global.form.searchPlaceholder"}}
      @searchEnabled={{true}}
      @search={{perform this.search}}
      @noMatchesMessage={{if this.searchFailed (t "views.app.application.header.searchFailed")}}
      @afterOptionsComponent={{if this.semanticUnavailable (component "app-layouts/global-search-note")}}
      @dropdownClass="global-search-dropdown"
      @onChange={{this.itemSelected}} as |issue|>
      <span data-test-global-search-option={{issue.number}}>
        <i class="fa fa-tasks"></i> <strong>#{{issue.number}}</strong> - {{issue.name}}
      </span>
      {{#if issue.snippet.length}}
        <span class="global-search-snippet" data-test-global-search-snippet>
          {{~#each issue.snippet as |part|~}}
            {{~#if part.match}}<mark>{{part.text}}</mark>{{else}}{{part.text}}{{/if~}}
          {{~/each~}}
        </span>
      {{/if}}
    </AppUi::Select>
  </div>

  {{!-- Navbar Right Menu --}}
  <div class="navbar-custom-menu">
    <ul class="nav navbar-nav">

      {{!-- Create Modules e.g. Project,Issue,Conversation --}}
      <li>
        <div class="create-modules">
          <button type="button" class="create-module-btn btn btn-primary" {{on "click" this.toggleCreateDropdown}}><i class="fa fa-plus visible-xs-inline"></i><span class="create-module-label hidden-xs">{{t "global.form.new"}}</span><i class="fa fa-caret-down hidden-xs"></i>
          <div class="create-module-dropdown-content {{if this.isCreateDropdownOpen 'show'}}">
            <LinkTo {{on "click" this.closeCreateDropdown}} @route="app.project.issue.create" @model={{this.trackedProject.shortCode}} class="{{if (not this.trackedProject.shortCode) 'pointer-none'}}"><i class="fa fa-fw fa-tasks"></i> {{t "global.module.singular.issue"}}</LinkTo>
            <LinkTo {{on "click" this.closeCreateDropdown}} @route="app.project.conversation" @model={{this.trackedProject.shortCode}} class="{{if (not this.trackedProject.shortCode) 'pointer-none'}}"><i class="fa fa-fw fa-comments"></i> {{t "global.module.singular.conversation"}}</LinkTo>
            <LinkTo {{on "click" this.closeCreateDropdown}} @route="app.projects.create"><i class="fa fa-fw fa-briefcase"></i> {{t "global.module.singular.project"}}</LinkTo>
          </div>            
          </button>          
        </div>
      </li>

      {{!-- Notifications Menu --}}
      <li class="dropdown notifications-menu">
        {{!-- Add a button to toggle the sidebar instead of dropdown --}}
        <AppUi::Button type="button" class="toggle-notifications-sidebar" @onClick={{this.toggleNotificationsSidebar}}>
          <i class="fa {{if this.notifications.hasUnreadNotifications 'fa-bell notification-bell-unread' 'fa-bell-o'}} {{if this.notifications.isBellRinging 'notification-bell-ring'}}"></i>
        </AppUi::Button>
      </li>


      {{!-- User Account Menu --}}
      <li class="dropdown user user-menu">
        {{!-- Menu Toggle Button --}}
        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
          {{!-- The user image in the navbar--}}
          <span class="header-avatar-status header-user-avatar-wrap"><AppUi::Avatar @user={{this.currentUser.user}} @size="s" class="header-user-avatar" /><i class="header-status-dot" aria-hidden="true"></i></span>
        </a>
        <ul class="dropdown-menu">
          {{!-- The user image in the menu --}}
          <li class="user-header">
            <span class="header-avatar-status header-menu-avatar-wrap"><AppUi::Avatar @user={{this.currentUser.user}} @size="l" class="header-menu-avatar" /><i class="header-status-dot" aria-hidden="true"></i></span>

            <p>
              {{this.currentUser.user.name}} - {{this.currentUser.user.title}}
              <small>{{t "views.app.member"}}{{format-date date=this.currentUser.user.dateCreated format='MMM YYYY'}}</small>
            </p>
          </li>
          <li class="user-status-row">
            <span class="user-status-label"><i class="header-status-dot header-status-dot-inline" aria-hidden="true"></i>{{t "views.app.online"}}</span>
            <span class="user-status-hint text-muted">{{t "views.app.visibleToTeam"}}</span>
          </li>
          {{!-- Menu Footer--}}
          <li class="user-footer">
            <div class="pull-left">
              <LinkTo @route="app.user.page" @model={{this.currentUser.user.id}} class="btn btn-default btn-flat" {{on "click" this.viewProfile}}>{{t "views.app.profile"}}</LinkTo>
            </div>
            <div class="pull-right">
              {{#if this.session.isAuthenticated}}
                <div id="btn-signout">
                  <a class="btn btn-default btn-flat" href="javascript:void(0);" {{on "click" this.signOut}}>{{t "global.form.signout"}}</a>
                </div>
              {{else}}
                <div id="btn-signin">
                  <a
                    class="btn btn-default btn-flat {{unless this.isHeaderSignInEnabled 'disabled'}}"
                    href="javascript:void(0)"
                    aria-disabled={{if this.isHeaderSignInEnabled "false" "true"}}
                    tabindex={{if this.isHeaderSignInEnabled "0" "-1"}}
                    {{on "click" this.signIn}}
                  >{{t "global.form.signin"}}</a>
                </div>
              {{/if}}
            </div>
          </li>
        </ul>
      </li> 
    </ul>
  </div>
</nav>
</header>