<AppUi::Modal
  @title="views.app.user.profilePicture.cropTitle"
  @confirmLabel="global.form.apply"
  @closeLabel="global.form.cancel"
  @confirm={{this.apply}}
  @onClose={{this.cancel}}
>
  <div class="profile-picture-cropper-body">
    <img
      class="profile-picture-cropper-img"
      src={{@imageSrc}}
      alt="crop-preview"
      {{initialize-cropper onInit=this.setCropper}}
    >
  </div>
</AppUi::Modal>
