<div class="pagination-container {{@containerClass}}" data-pagination-container>
  <div class="pagination-data-container">
    {{yield}}
  </div>

  <div class="pagination-footer" data-pagination-footer>
    <div class="pagination-controls">
      {{! Previous Page Button }}
      <button
        type="button"
        class="pagination-btn pagination-prev
          {{if this.isPreviousDisabled 'disabled'}}"
        data-pagination-prev
        {{on "click" this.goToPreviousPage}}
        disabled={{this.isPreviousDisabled}}
        title={{t (if @previousButtonTitle @previousButtonTitle "views.components.pagination.previousPage")}}
        data-btn="previous"
      >
        <i class="fa fa-caret-left"></i>
      </button>

      {{#if this.showPageInfo}}
        <div class="pagination-info" data-pagination-info>
          {{#if (has-block "center")}}
            <span class="pagination-text">{{yield to="center"}}</span>
          {{else}}
            <span class="pagination-text">{{this.centerText}}</span>
          {{/if}}
        </div>
      {{/if}}

      <button
        type="button"
        class="pagination-btn pagination-next
          {{if this.isNextDisabled 'disabled'}}"
        data-pagination-next
        {{on "click" this.goToNextPage}}
        disabled={{this.isNextDisabled}}
        title={{t (if @nextButtonTitle @nextButtonTitle "views.components.pagination.nextPage")}}
        data-btn="next"
      >
        <i class="fa fa-caret-right"></i>
      </button>
    </div>

    {{! Loading Indicator }}
    {{#if this.isLoading}}
      <div class="pagination-loading" data-pagination-loading>
        <i class="fa fa-spinner fa-spin"></i>
        <span>{{@loadingText}}</span>
      </div>
    {{/if}}
  </div>
</div>