<AppUi::Icon @name="exclamation-triangle" class="bg-red" />

<div class="timeline-item">
  <span class="time" data-activity="dateCreated"><AppUi::Icon @name="clock-o" /> {{@activity.createdSince}} {{t "global.ago"}}</span>
  <h3 class="timeline-header" data-activity="activityInfo">
    <a href="javascript:void(0);">
      {{t (concat "global.module.singular." @activity.relatedActivityModule)}}
    </a>
    {{t (concat "views.app.activity.related." @activity.relatedActivity)}}
  </h3>
  <div class="timeline-body" data-activity="description">
    {{safe-html @activity.description}}
  </div>
</div>
