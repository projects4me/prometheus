<AppUi::Icon @name="bell-o" class="bg-aqua" />

<div class="timeline-item">
  <span class="time" data-activity="dateCreated"><AppUi::Icon @name="clock-o" /> {{@activity.createdSince}} {{t "global.ago"}}</span>
  <h3 class="timeline-header"><a href="javascript:void(0)" data-activity="userName">{{@activity.createdUserName}}</a>{{t "views.app.activity.performedActivity"}}</h3>
  <div class="timeline-body" data-activity="description">
    {{safe-html @activity.description}}
  </div>
</div>
