<AppUi::Icon @name="briefcase" class="bg-green" />

<div class="timeline-item">
  <span class="time" data-activity="dateCreated"><AppUi::Icon @name="clock-o" /> {{@activity.createdSince}} {{t "global.ago"}}</span>
  <h3 class="timeline-header" data-activity="activityInfo">
    <LinkTo @route="app.user.page" data-activity="userName" @model={{@activity.createdUser}}>{{@activity.createdUserName}}</LinkTo>
    <Agent::UserTag @userId={{@activity.createdUser}} />
    {{t (concat "views.app.activity." @activity.type)}}
    {{t (concat "global.module.singular." @activity.relatedTo)}}
  </h3>
  <div class="timeline-body" data-activity="description">
    {{safe-html @activity.description}}
  </div>
</div>
