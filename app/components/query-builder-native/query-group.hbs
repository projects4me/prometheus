<div class="card border-secondary mb-3 query-group" data-test-query-group>
  <div class="card-header bg-light">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <i class="fas fa-layer-group text-secondary me-2"></i>
        <span class="fw-bold">{{t "views.components.queryBuilder.group.title"}}</span>
        
        {{!-- Condition Selector for multiple rules --}}
        {{#if (gt @group.rules.length 1)}}
          <div class="btn-group btn-group-sm ms-3" role="group">
            <button 
              type="button" 
              class="btn {{if (eq @group.condition 'AND') 'btn-success' 'btn-outline-success'}}"
              {{on "click" (fn this.updateCondition "AND")}}
            >
              AND
            </button>
            <button 
              type="button" 
              class="btn {{if (eq @group.condition 'OR') 'btn-warning' 'btn-outline-warning'}}"
              {{on "click" (fn this.updateCondition "OR")}}
            >
              OR
            </button>
          </div>
        {{/if}}
      </div>

      <button 
        type="button" 
        class="btn btn-sm btn-outline-danger"
        {{on "click" this.removeGroup}}
        title={{t "views.components.queryBuilder.group.removeGroup"}}
      >
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>

  <div class="card-body">
    {{#if @group.rules.length}}
      {{!-- Rules List --}}
      <div class="rules-container">
        {{#each @group.rules as |rule index|}}
          {{#if rule.condition}}
            {{!-- Nested Group --}}
            <QueryBuilderNative::QueryGroup 
              @group={{rule}}
              @filters={{@filters}}
              @onUpdate={{fn this.updateRule rule.id}}
              @onRemove={{fn this.removeRule rule.id}}
              @index={{index}}
            />
          {{else}}
            {{!-- Individual Rule --}}
            <QueryBuilderNative::QueryRule 
              @rule={{rule}}
              @filters={{@filters}}
              @onUpdate={{fn this.updateRule rule.id}}
              @onRemove={{fn this.removeRule rule.id}}
              @index={{index}}
              @showConnector={{and (gt @group.rules.length 1) (lt index (sub @group.rules.length 1))}}
              @connector={{@group.condition}}
            />
          {{/if}}
        {{/each}}
      </div>
    {{else}}
      {{!-- Empty Group State --}}
      <div class="text-center py-3">
        <i class="fas fa-plus-circle fa-2x text-muted mb-2"></i>
        <p class="text-muted mb-0">{{t "views.components.queryBuilder.group.emptyGroup"}}</p>
      </div>
    {{/if}}

    {{!-- Action Buttons --}}
    <div class="d-flex gap-2 mt-3 pt-3 border-top">
      <button 
        type="button" 
        class="btn btn-outline-primary btn-sm"
        {{on "click" this.addRule}}
      >
        <i class="fas fa-plus me-1"></i>
        {{t "views.components.queryBuilder.buttons.addRule"}}
      </button>
      
      <button 
        type="button" 
        class="btn btn-outline-secondary btn-sm"
        {{on "click" this.addNestedGroup}}
      >
        <i class="fas fa-layer-group me-1"></i>
        {{t "views.components.queryBuilder.group.addNestedGroup"}}
      </button>
    </div>
  </div>
</div>
