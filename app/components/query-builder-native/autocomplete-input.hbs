<div class="position-relative autocomplete-input">
  <textarea 
    class="form-control font-monospace {{unless @isValid 'is-invalid'}}"
    rows="4"
    placeholder={{@placeholder}}
    value={{@value}}
    id={{@id}}
    {{on "input" this.handleInput}}
    {{on "keydown" this.handleKeyDown}}
    {{on "focus" this.handleFocus}}
    {{on "blur" this.handleBlur}}
    data-test-query-textarea
  ></textarea>

  {{!-- Suggestions Dropdown --}}
  {{#if this.showSuggestions}}
    <div class="autocomplete-suggestions position-absolute w-100 mt-1" style="z-index: 1050;">
      <div class="list-group shadow-sm">
        {{#each this.suggestions as |suggestion index|}}
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{if (eq index this.selectedIndex) 'active'}}"
            {{on "click" (fn this.selectSuggestion suggestion)}}
          >
            <div class="d-flex align-items-center">
              {{#if (eq suggestion.type "field")}}
                <i class="fas fa-database text-primary me-2"></i>
              {{else if (eq suggestion.type "operator")}}
                <i class="fas fa-filter text-success me-2"></i>
              {{else if (eq suggestion.type "logical")}}
                <i class="fas fa-link text-warning me-2"></i>
              {{else if (eq suggestion.type "value")}}
                <i class="fas fa-quote-right text-info me-2"></i>
              {{/if}}
              
              <div>
                <div class="fw-bold">{{suggestion.value}}</div>
                {{#if suggestion.label}}
                  <small class="text-muted">{{suggestion.label}}</small>
                {{/if}}
              </div>
            </div>
            
            <span class="badge badge-secondary">{{t (concat "views.components.queryBuilder.autocomplete.suggestionTypes." suggestion.type)}}</span>
          </button>
        {{/each}}
        
        {{#unless this.suggestions.length}}
          <div class="list-group-item text-muted text-center">
            <i class="fas fa-search me-2"></i>
            {{t "views.components.queryBuilder.autocomplete.noSuggestions"}}
          </div>
        {{/unless}}
      </div>
    </div>
  {{/if}}

  {{!-- Validation feedback --}}
  {{#unless @isValid}}
    <div class="invalid-feedback">
      {{t "views.components.queryBuilder.autocomplete.invalidSyntax"}}
    </div>
  {{/unless}}
</div>

<style>
  .autocomplete-input .autocomplete-suggestions {
    max-height: 300px;
    overflow-y: auto;
  }
  
  .autocomplete-input .list-group-item {
    border-left: none;
    border-right: none;
    cursor: pointer;
  }
  
  .autocomplete-input .list-group-item:first-child {
    border-top-left-radius: 0.375rem;
    border-top-right-radius: 0.375rem;
  }
  
  .autocomplete-input .list-group-item:last-child {
    border-bottom-left-radius: 0.375rem;
    border-bottom-right-radius: 0.375rem;
  }
  
  .autocomplete-input .list-group-item:hover {
    background-color: var(--bs-light);
  }
  
  .autocomplete-input .list-group-item.active {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
  }
  
  .autocomplete-input textarea {
    resize: vertical;
    min-height: 100px;
  }
</style>
