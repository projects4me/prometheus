{{#each-in @lists as |key item|}}
  {{#if (object-empty item.nodes)}}
    <li class="wiki-list-no-parent">
      <a href="javascript:void(0);" {{on "click" (fn this.loadWiki item.name)}}>{{item.name}}</a>
    </li>
  {{else}}
    <li class="wiki-list-parent">
      <a href="javascript:void(0);" {{on "click" (fn this.loadWiki item.name)}}>{{item.name}}</a>
      <ul>
        <TreeList @lists={{item.nodes}} />
      </ul>
    </li>
  {{/if}}
{{/each-in}}
