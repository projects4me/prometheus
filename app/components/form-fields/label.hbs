<div data-form-field="label">
  <label class="floating-label">
  {{@label}}
  {{#if @required}}
    <span class="required">*</span>
  {{/if}}
  </label>

  {{!-- Field Label Information --}}
  {{#if @showFieldInfo}}
  <div>
    <i class="fa fa-info-circle" aria-hidden="true" data-label-info="btn" {{on "click" this.toggleInfo}}></i>
  </div>
  {{#unless this.isInfoHidden}}
  <div class="field-label-info" data-field-label="info">
    <i class="fa fa-caret-left" aria-hidden="true" data-field-label="caret"></i>
    <p>{{@info}}</p>
  </div>
  {{/unless}}
  {{/if}}
</div>