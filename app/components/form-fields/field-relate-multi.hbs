<AccessControl @aclContext={{@aclContext}}>
  <div data-field={{@data-field}} class="form-field ember-view">
    <div class="input-group multiselect-input">
      <PowerSelect
        @renderInPlace={{@renderInPlace}}
        @multiple={{true}}
        @class="form-control"
        @options={{@options}}
        @placeholder={{@placeholder}}
        @selected={{@selected}}
        @searchField={{@searchField}}
        @searchEnabled={{@searchEnabled}}
        @search={{@search}}
        @onChange={{@onchange}}
        @onKeydown={{this.handlePowerSelectKeydown}}
        @matcher={{@matcher}}
        @closeOnSelect={{@closeOnSelect}}
        @onFocus={{this.enableValidation}}
        @onBlur={{this.validate}}
        @onClose={{this.validate}} as |data|>
        {{component (concat 'related-fields/'@relateType) data=data}}
      </PowerSelect>
    </div>
    <span class="highlight"></span>
    <span class="bar"></span>

    <FormFields::Label
      @label={{@label}}
      @showFieldInfo={{@showFieldInfo}}
      @info={{@info}}
      @data-field={{@data-field}}
      @required={{@required}}
    />

    {{#if (and @message this.shouldValidate)}}
      <span class="error text-red" id={{@data-field}}>
        {{@message}}
      </span>
    {{/if}}
  </div>
</AccessControl>