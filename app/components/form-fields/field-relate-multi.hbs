<AccessControl @aclContext={{@aclContext}}>
  <div data-field={{@data-field}} class="form-field ember-view">
    <div class="input-group multiselect-input">
      <AppUi::Select
        @renderInPlace={{@renderInPlace}}
        @multiple={{true}}
        @options={{this.options}}
        @placeholder={{@placeholder}}
        @selected={{@selected}}
        @searchField={{@searchField}}
        @searchEnabled={{@searchEnabled}}
        @search={{this.search}}
        @onChange={{this.handleChange}}
        @onInput={{this.handleInput}}
        @onKeydown={{this.handleSelectKeydown}}
        @matcher={{this.matcher}}
        @closeOnSelect={{@closeOnSelect}}
        @initiallyOpened={{@initiallyOpened}}
        @onFocus={{this.enableValidation}}
        @onBlur={{this.validate}}
        @onClose={{this.handleClose}} as |data|>
        {{#if data.__create}}
          <span class="field-relate-multi-add" data-field-relate-multi-add>{{t "global.form.addText" text=data.text}}</span>
        {{else}}
          {{component (concat 'related-fields/'@relateType) data=data}}
        {{/if}}
      </AppUi::Select>
    </div>
    <span class="highlight"></span>
    <span class="bar"></span>

    <FormFields::Label
      @label={{@label}}
      @showFieldInfo={{@showFieldInfo}}
      @info={{@info}}
      @data-field={{@data-field}}
      @required={{@required}}
    />

    {{#if (and @message this.shouldValidate)}}
      <span class="error text-red" id={{@data-field}}>
        {{@message}}
      </span>
    {{/if}}
  </div>
</AccessControl>