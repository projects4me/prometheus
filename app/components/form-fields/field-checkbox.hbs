<AccessControl @aclContext={{@aclContext}}>
  {{#if @label}}
    <div class="checkbox checkbox-primary form-checkbox {{if this.isSmall "form-checkbox-sm"}}">
      <input
        type="checkbox"
        id={{this.inputId}}
        {{on "input" this.onSelect}}
        data-select={{@data-select}}
        checked={{@checked}}
        disabled={{@disabled}}
        ...attributes
      />
      <label for={{this.inputId}}>{{@label}}</label>
    </div>
  {{else}}
    <input
      type="checkbox"
      {{on "input" this.onSelect}}
      data-select={{@data-select}}
      checked={{@checked}}
      disabled={{@disabled}}
      ...attributes
    />
  {{/if}}
</AccessControl>
