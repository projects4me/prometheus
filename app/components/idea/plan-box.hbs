<div class="box box-success idea-plan" data-idea-plan>
  <div class="box-header with-border">
    <h3 class="box-title">{{t "views.app.idea.plan.title"}}</h3>
    {{#if this.selected}}
      <div class="box-tools pull-right">
        <span class="label {{this.statusClass}}" data-idea-plan-status>{{#if this.isCreating}}<i class="fa fa-spinner fa-spin" data-idea-plan-creating></i> {{/if}}{{t (concat "views.app.idea.plan.status." this.selected.status)}}</span>
      </div>
    {{/if}}
  </div>
  {{#if this.selected}}
    <div class="box-body">
      <ul class="nav nav-tabs" data-idea-plan-tabs>
        {{#each this.versions as |plan|}}
          <li class={{if (eq plan.id this.selected.id) "active"}}>
            <a href="#" {{on "click" (fn this.pick plan.version)}} data-idea-plan-version={{plan.version}}>v{{plan.version}}</a>
          </li>
        {{/each}}
      </ul>
      {{#if this.selected.error}}
        <div class="alert alert-danger idea-plan-error" data-idea-plan-error>{{this.selected.error}}</div>
      {{/if}}
      <p class="idea-plan-summary" data-idea-plan-summary>{{this.body.summary}}</p>
      {{#if this.screens.length}}
        <ul class="idea-plan-screens list-inline" data-idea-plan-screens>
          {{#each this.screens as |entry|}}
            {{#if entry.screen}}
              <Idea::MessageScreen @screen={{entry.screen}} />
            {{else}}
              <li class="text-muted" data-idea-plan-screen-missing={{entry.key}}><i class="fa fa-picture-o"></i> {{entry.key}}</li>
            {{/if}}
          {{/each}}
        </ul>
      {{/if}}
    </div>
    {{#if this.body.issues.length}}
      <ul class="list-unstyled idea-plan-issues" data-idea-plan-issues>
        {{#each this.body.issues as |issue|}}
          <li class="idea-plan-issue">
            <div class="idea-plan-issue-head clickable" role="button" tabindex="0" aria-expanded={{if (eq this.expandedKey issue.key) "true" "false"}} {{on "click" (fn this.toggle issue.key)}} {{on "keydown" (fn this.toggleOnKey issue.key)}} data-idea-plan-issue={{issue.key}}>
              <span class="subject"><i class="fa {{if (eq this.expandedKey issue.key) "fa-caret-down" "fa-caret-right"}}"></i> {{issue.subject}}</span>
              <span class="meta" data-idea-plan-issue-meta>
                <span class="project" data-idea-plan-issue-project>{{issue.projectLabel}}</span>
                <span>{{issue.type}}</span>
                <span class="priority-{{issue.priority}}" data-idea-plan-issue-priority><AppUi::PriorityIcon @priority={{issue.priority}} /> {{t (concat "views.app.issue.lists.priority." issue.priority)}}</span>
                <span data-idea-plan-issue-complexity><i class="fa {{if (eq issue.complexity "complex") "fa-cogs" "fa-cog"}}"></i> {{t (concat "views.app.idea.plan.complexities." issue.complexity)}}</span>
                <span title={{if issue.newMilestone (t "views.app.idea.plan.newMilestoneTitle")}} data-idea-plan-issue-milestone><i class="fa fa-flag-o"></i> {{issue.milestone}}{{if issue.newMilestone (t "views.app.idea.plan.newMilestone")}}</span>
                {{#if issue.dependsOn}}
                  <span data-idea-plan-issue-depends><i class="fa fa-level-up"></i> {{t "views.app.idea.plan.after" keys=issue.dependsOn}}</span>
                {{/if}}
                {{#if issue.screens}}
                  <span><i class="fa fa-picture-o"></i> {{issue.screens}}</span>
                {{/if}}
                {{#let (get this.createdIssues issue.key) as |created|}}
                  {{#if created.readable}}
                    <LinkTo @route="app.project.issue.page" @models={{array created.projectShortcode created.issueNumber}} data-idea-plan-issue-link>
                      <i class="fa fa-external-link"></i> {{created.projectShortcode}}-{{created.issueNumber}}
                    </LinkTo>
                  {{else if created}}
                    <span class="text-muted" data-idea-plan-issue-unreadable>{{created.projectShortcode}}-{{created.issueNumber}}</span>
                  {{else}}
                    <span class="text-muted">{{issue.key}}</span>
                  {{/if}}
                {{/let}}
              </span>
            </div>
            {{#if (eq this.expandedKey issue.key)}}
              <div class="idea-plan-description" data-idea-plan-issue-detail={{issue.key}} data-idea-plan-description>{{sanitize-html issue.description}}</div>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if this.canApprove}}
      <div class="box-footer">
        <AppUi::Button type="button" class="btn btn-success" @onClick={{this.askApprove}} @aclContext="ideaplan.update" disabled={{this.isApproving}} data-idea-plan-approve>
          {{t "views.app.idea.plan.approve" version=this.selected.version}}
        </AppUi::Button>
      </div>
    {{/if}}
  {{else}}
    <div class="box-body">
      <p class="text-muted text-center" data-idea-plan-empty>{{t "views.app.idea.plan.empty"}}</p>
    </div>
  {{/if}}

  {{#if this.showApproveModal}}
    {{#bootstrap-modal
      title="views.app.idea.plan.approveTitle"
      closeLabel="global.form.cancel"
      confirmLabel="views.app.idea.plan.approveConfirm"
      close=(action this.closeApprove)
      confirm=(action this.confirmApprove)
    }}
      <div class="alert alert-warning flex-row flex-ai-c" data-idea-plan-approve-confirm>
        <i class="fa fa-exclamation-triangle"></i>
        <p>{{t "views.app.idea.plan.approveMessage" version=this.selected.version}}</p>
      </div>
    {{/bootstrap-modal}}
  {{/if}}
</div>
