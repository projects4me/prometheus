<div class="box box-success idea-plan" data-idea-plan>
  <div class="box-header with-border">
    <h3 class="box-title">{{t "views.app.idea.plan.title"}}</h3>
    {{#if this.selected}}
      <span class="label pull-right {{this.statusClass}}" data-idea-plan-status>{{t (concat "views.app.idea.plan.status." this.selected.status)}}</span>
    {{/if}}
  </div>
  {{#if this.selected}}
    <div class="box-body">
      <ul class="nav nav-tabs" data-idea-plan-tabs>
        {{#each this.versions as |plan|}}
          <li class={{if (eq plan.id this.selected.id) "active"}}>
            <a href="#" {{on "click" (fn this.pick plan.version)}} data-idea-plan-version={{plan.version}}>v{{plan.version}}</a>
          </li>
        {{/each}}
      </ul>
      {{#if this.selected.error}}
        <div class="alert alert-danger idea-plan-error" data-idea-plan-error>{{this.selected.error}}</div>
      {{/if}}
      <p class="idea-plan-summary" data-idea-plan-summary>{{this.body.summary}}</p>
    </div>
    {{#if this.body.issues.length}}
      <div class="box-body no-padding">
        <ul class="issue-overview clearfix idea-plan-issues" data-idea-plan-issues>
          {{#each this.body.issues as |issue|}}
            <li>
              <div class="issue-block clickable" role="button" tabindex="0" aria-expanded={{if (eq this.expandedKey issue.key) "true" "false"}} {{on "click" (fn this.toggle issue.key)}} {{on "keydown" (fn this.toggleOnKey issue.key)}} data-idea-plan-issue={{issue.key}}>
                <div class="priority"><AppUi::PriorityIcon @priority={{issue.priority}} /></div>
                <div class="data-block">
                  <span class="subject">{{issue.subject}}</span>
                  <span class="description" data-idea-plan-issue-meta>
                    {{issue.project}} &middot; {{issue.type}} &middot;
                    <span data-idea-plan-issue-priority>{{t (concat "views.app.issue.lists.priority." issue.priority)}}</span>
                  </span>
                </div>
              </div>
              {{#if (eq this.expandedKey issue.key)}}
                <div class="idea-plan-issue-detail" data-idea-plan-issue-detail={{issue.key}}>
                  <dl class="dl-horizontal">
                    <dt>{{t "views.app.idea.plan.complexity"}}</dt>
                    <dd>{{issue.complexity}}</dd>
                    <dt>{{t "views.app.idea.plan.dependsOn"}}</dt>
                    <dd>{{issue.dependsOn}}</dd>
                  </dl>
                  <div class="idea-plan-description" data-idea-plan-description>{{sanitize-html issue.description}}</div>
                </div>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </div>
    {{/if}}
    {{#if this.canApprove}}
      <div class="box-footer">
        <AppUi::Button type="button" class="btn btn-success" @onClick={{this.askApprove}} @aclContext="ideaplan.update" data-idea-plan-approve>
          {{t "views.app.idea.plan.approve" version=this.selected.version}}
        </AppUi::Button>
      </div>
    {{/if}}
  {{else}}
    <div class="box-body">
      <p class="text-muted text-center" data-idea-plan-empty>{{t "views.app.idea.plan.empty"}}</p>
    </div>
  {{/if}}

  {{#if this.showApproveModal}}
    {{#bootstrap-modal
      title="views.app.idea.plan.approveTitle"
      closeLabel="global.form.cancel"
      confirmLabel="views.app.idea.plan.approveConfirm"
      close=(action this.closeApprove)
      confirm=(action this.confirmApprove)
    }}
      <div class="alert alert-warning flex-row flex-ai-c" data-idea-plan-approve-confirm>
        <i class="fa fa-exclamation-triangle"></i>
        <p>{{t "views.app.idea.plan.approveMessage" version=this.selected.version}}</p>
      </div>
    {{/bootstrap-modal}}
  {{/if}}
</div>
