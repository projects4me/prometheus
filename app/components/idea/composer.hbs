<div class="idea-composer {{if this.isDisabled "idea-composer-disabled"}}" data-idea-composer inert={{if this.isDisabled "inert"}}>
  <AppUi::ToastUi
    @editType="wysiwyg"
    @output="markdown"
    @clearEvent={{this.clearEvent}}
    @hide={{array "footer"}}
    @placeholder={{t "views.app.idea.conversation.placeholder"}}
    @onContentChange={{this.updateBody}}
    @onKeyboardSubmit={{this.handleKeyboardSubmit}}
    @onImage={{this.addImage}}
    @message={{this.imageError}}
    @data-field="idea.composer.image"
  />
  {{#if this.isUploading}}
    <span class="text-muted" data-idea-image-uploading>
      <i class="fa fa-spinner fa-spin"></i> {{t "views.app.idea.conversation.image.uploading"}}
    </span>
  {{/if}}
  <AppUi::Button
    type="button"
    class="btn btn-primary btn-sm"
    @onClick={{this.send}}
    @aclContext="ideamessage.create"
    disabled={{this.isSendDisabled}}
    data-idea-send
  >
    <i class="fa fa-paper-plane"></i> {{t "views.app.idea.conversation.send"}}
  </AppUi::Button>
</div>
