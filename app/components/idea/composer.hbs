<div class="idea-composer {{if this.isDisabled "idea-composer-disabled"}}" data-idea-composer>
  <AppUi::ToastUi
    @editType="wysiwyg"
    @output="markdown"
    @hide={{array "footer"}}
    @placeholder={{t "views.app.idea.conversation.placeholder"}}
    @onContentChange={{this.updateBody}}
    @onKeyboardSubmit={{this.handleKeyboardSubmit}}
  />
  <AppUi::Button
    type="button"
    class="btn btn-primary btn-sm"
    @onClick={{this.send}}
    @aclContext="ideamessage.create"
    disabled={{this.isDisabled}}
    data-idea-send
  >
    <i class="fa fa-paper-plane"></i> {{t "views.app.idea.conversation.send"}}
  </AppUi::Button>
</div>
