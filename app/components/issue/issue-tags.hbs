<div class="col-xs-6 col-md-4 issue-tags" data-test-issue-tags data-field="issue.tags" {{on-insert this.load}} {{on-update @issue.id this.load}}>
  <h4>{{t "views.app.issue.detail.tags.title"}}</h4>
  {{#if this.loadFailed}}
    <p class="text-danger" data-test-issue-tags-failed>{{t "views.app.issue.detail.tags.loadFailed"}}</p>
  {{else}}
    <p>
      {{#each this.taggedList as |tagged|}}
        <AppUi::Tag @colorKey={{tagged.tag.tag}} data-test-issue-tag={{tagged.tag.tag}}>
          <LinkTo
            @route="app.project.issue.index"
            @model={{this.shortcode}}
            @query={{hash query=(concat "((tag.tag : " tagged.tag.tag "))")}}
            data-test-issue-tag-link
          >{{tagged.tag.tag}}</LinkTo>
        </AppUi::Tag>
      {{else}}
        <span class="text-muted">-</span>
      {{/each}}
      {{#if this.canEdit}}
        <AppUi::Button class="btn btn-box-tool" @onClick={{this.openEdit}} aria-label={{t "views.app.issue.detail.tags.edit"}} data-test-issue-tags-add>
          <i class="fa fa-plus" title={{t "views.app.issue.detail.tags.edit"}}></i>
        </AppUi::Button>
      {{/if}}
    </p>
  {{/if}}
  {{#if this.editing}}
    <Tags::EditModal
      @projectId={{this.projectId}}
      @relatedTo="issue"
      @relatedId={{@issue.id}}
      @title="views.app.issue.detail.tags.modalTitle"
      @titleParams={{hash number=@issue.issueNumber}}
      @onClose={{this.closeEdit}}
      @onSaved={{this.load}}
    />
  {{/if}}
</div>
