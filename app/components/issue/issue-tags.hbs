<div class="issue-tags" data-test-issue-tags data-field="issue.tags" {{on-insert this.load}} {{on-update @issue.id this.load}}>
  <h4>{{t "views.app.issue.detail.tags.title"}}</h4>
  {{#if this.loadFailed}}
    <p class="text-danger" data-test-issue-tags-failed>{{t "views.app.issue.detail.tags.loadFailed"}}</p>
  {{else}}
    <p>
      {{#each this.taggedList as |tagged|}}
        <AppUi::Tag
          @colorKey={{tagged.tag.tag}}
          @onRemove={{if this.canRemove (fn this.remove tagged)}}
          data-test-issue-tag={{tagged.tag.tag}}
        >{{tagged.tag.tag}}</AppUi::Tag>
      {{else}}
        <span class="text-muted">-</span>
      {{/each}}
    </p>
    {{#if this.canEdit}}
      <FormFields::FieldRelateMulti
        @selected={{(array)}}
        @search={{this.search}}
        @searchEnabled={{true}}
        @searchField="label"
        @placeholder={{t "views.app.issue.detail.tags.add"}}
        @onchange={{this.select}}
        @onCreate={{this.add}}
        @closeOnSelect={{true}}
        @relateType="relate-simple"
        @data-field="issue.tags.add"
      />
    {{/if}}
  {{/if}}
</div>
