{{#if @isOpen}}
  <BootstrapModal
    @title="views.app.issue.planWithAi.modalTitle"
    @closeLabel="global.form.close"
    @close={{@onClose}}
    @confirmLabel="views.app.issue.planWithAi.modalConfirm"
    @confirm={{this.onConfirm}}
    @dataSaveBtn="create-issue-plan"
    @removeConfirmBtn={{this.planStarted}}
    @containerClass="issue-plan-modal"
    @disableSaveBtn={{@loading}}
  >
    {{#if @loading}}
      <div class="text-center"><i class="fa fa-spinner fa-spin"></i> {{t "global.form.loading"}}</div>
    {{else if @error}}
      <div class="alert alert-danger">{{@error}}</div>
    {{else if (and @data (not this.planStarted))}}
      <div class="issue-plan-tasks" {{did-insert this.initializeSelections @data}}>
        <h4>{{t "views.app.issue.planWithAi.tasksTitle"}} ({{@data.tasks.length}})
          <span class="pull-right">{{t "global.list.selected"}}: {{this.selectedTasksCount}} / {{@data.tasks.length}}</span>
        </h4>
        <div class="issue-plan-task-list">
          {{#each @data.tasks as |task|}}
            <div class="issue-plan-task-card" data-task-id="{{task.id}}">
              <div class="issue-plan-task-header">
                <div class="issue-subject">
                  <div class="issue-subject-checkbox">
                    <FormFields::FieldCheckbox
                      @data-select={{task.id}}
                      @checked={{includes task.id this.selectedTasks}}
                      @select={{fn this.toggleTaskSelection task.id}}
                    />
                  </div>
                  <strong>{{task.id}} - {{task.subject}}</strong>
                </div>
                <div class="issue-estimated-hours">
                  <span class="task-own-estimated">
                    {{t "views.app.issue.planWithAi.taskEstimatedHours"}}: <span class="task-own-estimated-value">{{call (fn this.getTaskOwnEstimatedHours task)}}</span>
                  </span>
                </div>
              </div>
              <div class="issue-plan-task-desc">{{task.description}}</div>
              {{#if task.dependency}}
                <div class="issue-plan-task-dependency text-info {{if (call (fn this.isDependencyDisabled task)) 'dependency-disabled'}}">
                  {{t "views.app.issue.planWithAi.dependency"}}: {{task.dependency}}
                </div>
              {{/if}}
              <div class="issue-plan-task-tests">
                <strong>{{t "views.app.issue.planWithAi.testCases" count=task.tests.length}}</strong>
                <ul>
                  {{#each task.tests as |test testIdx|}}
                    <li class="issue-plan-task-test" data-test-id="{{concat task.id '-test-' (inc testIdx)}}">                    
                      <div class="issue-plan-task-test-header">
                        <FormFields::FieldCheckbox
                          @data-select={{concat task.id "-test-" (inc testIdx 1)}}
                          @checked={{includes testIdx (get this.selectedTests task.id)}}
                          @select={{fn this.toggleTestSelection task.id testIdx}}
                        />                                               
                        <strong class="issue-plan-task-test-header-scenario">{{t "views.app.issue.planWithAi.scenario"}}:</strong> 
                        <span>{{test.scenario}}</span> 
                      </div>
                      <div class="issue-plan-task-test-case-details"><strong>{{t "views.app.issue.planWithAi.testCase"}}:</strong> <pre class="issue-plan-test-case-pre">{{test.test_case}}</pre></div>
                      <div class="issue-plan-task-test-estimated-hours">{{t "views.app.issue.planWithAi.estimatedHours"}}: {{test.estimated_hours}}</div>
                    </li>
                  {{/each}}
                </ul>
              </div>
              <div class="task-total-estimated">
                {{t "views.app.issue.planWithAi.totalEstimatedHours"}}: <span class="task-total-estimated-value">{{call (fn this.getTaskTotalEstimatedHours task)}}</span>
              </div>              
            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if this.planStarted}}
      <div class="issue-plan-issue-list">
        {{!-- Recursive rendering of the task tree --}}
        {{#each this.taskTree as |node|}}
          <Issue::IssuePlanTaskNode 
            @node={{node}} 
            @level={{0}} 
            @creationStates={{this.creationStates}} 
            @onRetry={{this.retryTaskRecursive}} 
            @onCopy={{this.copyToClipboard}}
          />
        {{/each}}
      </div>
    {{/if}}
  </BootstrapModal>
{{/if}} 