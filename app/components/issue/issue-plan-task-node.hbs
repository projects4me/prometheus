<div class="issue-plan-issue-item{{if this.isChild ' issue-plan-issue-child'}}" style={{this.indentStyle}}>
  <div data-task-id="{{@node.task.id}}">
    <span class="issue-plan-issue-item-task-id">{{@node.task.id}}</span> |
    <span class="issue-plan-issue-item-task-subject">{{@node.task.subject}}</span>
  </div>
  <div class="issue-plan-issue-item-status">
    {{#let (get @creationStates @node.task.id) as |state|}}
      {{#if (eq state "creating")}}
        <AppUi::Icon @name="spinner" @spin={{true}} class="issue-plan-task-node-status" />
      {{else if (eq state "success")}}
        <AppUi::Icon @name="check" class="icon-success issue-plan-task-node-status" />
      {{else if (eq state "error")}}
        <AppUi::Icon @name="times" class="icon-error issue-plan-task-node-status" />
        <AppUi::Button type="button" class="btn btn-link btn-xs issue-plan-retry-btn issue-plan-task-node-status" @onClick={{this.handleRetry}} title="Retry"><AppUi::Icon @name="refresh" /></AppUi::Button>
        <AppUi::Button type="button" class="btn btn-link btn-xs issue-plan-copy-btn issue-plan-task-node-status" @onClick={{this.handleCopy}} title="Copy to clipboard"><AppUi::Icon @name="files-o" /></AppUi::Button>
      {{else}}
        <AppUi::Icon @name="clock-o" />
      {{/if}}
    {{/let}}
  </div>
</div>
{{#each @node.children as |child|}}
  <Issue::IssuePlanTaskNode 
    @node={{child}} 
    @level={{add @level 1}} 
    @creationStates={{@creationStates}} 
    @onRetry={{@onRetry}} 
    @onCopy={{@onCopy}}
  />
{{/each}}