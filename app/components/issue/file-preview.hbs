<div class="filePreviewModal" {{did-insert this.load}} {{did-update this.load @file}}>
  <AppUi::Modal
      @title="views.app.issue.detail.file.preview"
      @closeLabel="global.form.close"
      @onClose={{@onClose}}>
    {{#if this.canPreview}}
      {{#if this.loading}}
        <p class="text-center file-preview-loading"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i> {{t "views.app.issue.detail.file.loading"}}</p>
      {{else if this.failed}}
        <div class="alert alert-danger file-preview-error" role="alert">{{t "views.app.issue.detail.file.previewFailed"}}</div>
      {{else if this.previewUrl}}
        {{#if this.isImage}}
          <img class="file-preview-image" src={{this.previewUrl}} alt={{@file.name}} {{on "error" this.markFailed}}>
        {{else}}
          <iframe class="file-preview-frame" sandbox="" title={{@file.name}} src={{this.previewUrl}}></iframe>
        {{/if}}
      {{/if}}
    {{else}}
      <div class="file-preview-unsupported text-center">
        <p>{{t "views.app.issue.detail.file.noPreview"}}</p>
        <button type="button" class="btn btn-primary" {{on "click" this.download}}><i class="fa fa-cloud-download" aria-hidden="true"></i> {{t "views.app.issue.detail.file.download"}}</button>
      </div>
    {{/if}}
  </AppUi::Modal>
</div>
