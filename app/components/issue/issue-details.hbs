<div class="issue">
  <div class="row">
    {{!-- The first Column that contains the issue details,etc --}}
    <div class="col-md-{{if (and @quickView this.renderSingleColumn) '12' '8'}}">

      {{!-- This are the issue details --}}
      <AccessControl @aclContext="issue.read">
        <div class="box box-primary issue-details" data-field="issue.subject">
          <div class="box-header with-border box-header-no-content flex-row flex-jc-sb flex-ai-c">
            {{#unless @quickView}}
            <h2 class="box-title issue-title">{{this.issue.issuetype.name}} - #{{this.issue.issueNumber}} | 
              <AccessControl @aclContext="issue.subject.read">
                <span class="issue-subject">{{this.issue.subject}}</span>
              </AccessControl>

              {{!-- Issue status dropdown --}}
              <span class="issue-status">
                <div class="dropdown">
                  <span class="badge {{this.issue.status}}" data-toggle="dropdown">
                    {{t (concat "views.app.issue.lists.status." this.issue.status)}}
                    <i class="fa fa-caret-down"></i>
                  </span>
                  <ul class="dropdown-menu">
                    {{#each @issueStatuses as |issuestatus|}}
                      {{#if (not-eq issuestatus.name this.issue.status)}}
                        <li>
                          <div {{on "click" (fn this.updateStatus this.issue issuestatus.name)}}>
                            <span class="badge {{issuestatus.name}}">{{t (concat "views.app.issue.lists.status." issuestatus.name)}}</span>
                          </div>
                        </li>
                      {{/if}}
                    {{/each}}
                  </ul>
                </div>
              </span>
            </h2>
            {{else}}
            <h4 class="box-title issue-title">
              <LinkTo @route="app.project.issue.page" target="_blank" @model={{this.issue.issueNumber}}>#{{this.issue.issueNumber}} - {{this.issue.subject}}</LinkTo>
            </h4>
            {{/unless}}
            {{!-- Issue Actions Toolbar --}}
            <AppUi::Toolbar>
              <:primary>
                {{!-- AI Plan button --}}
                {{#unless (or @quickView this.issue.isPlanned)}}
                  <AppUi::Button 
                    data-btn="ai-plan" 
                    type="button" 
                    class="btn btn-box-tool btn-no-outline" 
                    data-toggle="tooltip" 
                    title="{{t 'views.app.issue.planWithAi.title'}}" 
                    @onClick={{this.showIssuePlanDialog}}
                  >
                  <svg xmlns="http://www.w3.org/2000/svg" width="78" height="76" viewBox="0 0 78 76" fill="none">
                  <path data-ai-btn fill-rule="evenodd" clip-rule="evenodd" d="M9.73381 0.86665C6.41996 1.92159 1.91324 6.6113 0.875631 10.0853C-0.241692 13.8247 -0.311698 53.8126 0.792455 57.8307C1.76006 61.3525 6.39917 65.9015 10.1781 67.0334C11.9879 67.5761 17.8774 67.8811 26.5311 67.8811C42.5416 67.8811 42.9367 67.7237 39.4295 62.7471L37.1852 59.5635H25.1434C13.0061 59.5635 11.0563 59.2315 9.22921 56.8513C8.08901 55.3666 7.98089 13.9792 9.10999 11.4999C9.53349 10.5711 10.6397 9.4649 11.5685 9.0414C13.9716 7.94695 54.3227 7.98022 56.3855 9.07814C59.3777 10.6723 59.5871 11.5928 59.6099 23.263C59.6259 31.3393 59.8726 34.6393 60.4985 35.1557C60.9754 35.5487 62.7685 35.9771 64.484 36.1067L67.6031 36.3437L67.7937 24.6181C67.9448 15.3302 67.7535 12.1979 66.8746 9.55155C65.5785 5.64993 61.7302 1.9812 57.6511 0.759215C54.0677 -0.31444 13.1544 -0.222947 9.73381 0.86665ZM23.2332 17.9918C22.4714 19.2241 13.8856 46.2042 13.8856 47.3645C13.8856 48.1609 14.542 48.4735 16.2111 48.4735C18.2406 48.4735 18.619 48.1865 19.1811 46.2208L19.8258 43.9681L26.1055 43.7706L32.3852 43.5724L33.0347 45.85C33.5455 47.6424 34.1028 48.1754 35.6526 48.3542C36.7353 48.4797 37.8928 48.3099 38.2255 47.9772C38.5693 47.6334 36.727 40.8858 33.9538 32.3277L29.0776 17.2827H26.3744C24.8877 17.2827 23.4737 17.6015 23.2332 17.9918ZM45.4043 18.1207C45.2081 18.6322 45.1319 25.5933 45.2351 33.5892L45.423 48.1269L47.6888 48.3452L49.9553 48.5636L49.7682 33.0964L49.5817 17.6293L47.6715 17.4095C46.541 17.2792 45.6157 17.5697 45.4043 18.1207ZM28.1398 30.6254C29.1795 33.7708 30.1742 36.7339 30.3502 37.2101C30.5845 37.8464 29.4921 38.0765 26.2455 38.0765H21.822L23.9055 31.4918C25.0512 27.8702 26.0473 24.9071 26.1187 24.9071C26.1901 24.9071 27.0994 27.48 28.1398 30.6254ZM59.0818 47.327C57.1847 52.617 55.0789 54.7567 49.6317 56.9296C47.3721 57.8314 45.4147 58.896 45.2809 59.296C45.1478 59.6959 47.1946 60.8687 49.8292 61.9021C55.4706 64.116 56.5664 65.1869 58.9632 70.8338C59.9537 73.1655 61.1008 75.1866 61.5139 75.3239C61.9271 75.4618 62.9979 73.6409 63.8942 71.2781C65.9222 65.932 67.7771 64.0862 73.4947 61.7261C75.9726 60.703 78 59.6176 78 59.314C78 59.0104 75.8208 57.8321 73.1578 56.696C70.4948 55.56 67.8131 54.1758 67.1983 53.6192C66.5835 53.0634 65.2042 50.4302 64.1326 47.7686C63.061 45.1062 61.8411 42.9284 61.4218 42.9284C61.0024 42.9284 59.9496 44.908 59.0818 47.327Z" fill="black"/>
                  </svg>
                  </AppUi::Button>
                {{/unless}}
                
                {{!-- Edit issue button --}}
                  <AppUi::Button 
                    data-btn="edit" 
                    type="button" 
                    class="btn btn-box-tool btn-no-outline" 
                    data-toggle="tooltip" 
                    title="{{t 'global.form.edit'}}" 
                    @onClick={{fn this.editIssue this.issue.issueNumber}} 
                    @aclContext="issue.update"
                  >
                    <i class="fa fa-pencil"></i>
                  </AppUi::Button>

                {{!-- Watcher Issue button --}}
                <div class="watcher-container">
                  <AppUi::Button 
                    data-btn="watcher" 
                    type="button" 
                    class="btn btn-box-tool btn-no-outline" 
                    data-toggle="tooltip" 
                    title="{{t (if this.isWatching 'views.app.issue.watcher.watching' 'views.app.issue.watcher.notWatching')}}" 
                    @onClick={{this.toggleWatcher}}
                    disabled={{this.isCoreMember}}
                  >
                    {{#if this.isCoreMember}}
                      <i class="fa fa-eye-slash"></i>
                    {{else}}
                      <i class="fa {{if this.isWatching 'fa-eye-slash' 'fa-eye'}}"></i>
                    {{/if}}
                  </AppUi::Button>
                  
                  {{#if this.isCoreMember}}
                    <AppUi::Button 
                      data-btn="add-watcher" 
                      type="button" 
                      class="btn btn-box-tool btn-no-outline btn-sm" 
                      data-toggle="tooltip" 
                      title="{{t 'views.app.issue.watcher.addWatchers'}}" 
                      @onClick={{this.showAddWatcherDialog}}
                    >
                      <i class="fa fa-plus"></i>
                    </AppUi::Button>
                  {{/if}}                 
                </div>

                {{!-- Close issue button --}}
                {{#if @quickView}}
                  <AppUi::Button 
                    data-btn="close" 
                    type="button" 
                    class="btn btn-box-tool btn-no-outline" 
                    data-toggle="tooltip" 
                    title="{{t 'views.app.issue.close'}}" 
                    @onClick={{@closeIssueDetails}}>
                    <i class="fa fa-times"></i>
                  </AppUi::Button>
                {{/if}}
              </:primary>
            </AppUi::Toolbar>
          </div>



          <div class="box-body">

            <div class="row">
              <div class="col-xs-3 col-md-2" data-field="issue.assignee">
                <div class="project-manager">
                  <img class="img-circle" src="{{this.apiHost}}/userimage/get/{{this.issue.assignedTo.id}}" alt="{{this.issue.assignedTo.name}}">
                  <LinkTo @route="app.user.page" @model={{this.issue.assignedTo.id}} class="users-list-name">{{this.issue.assignedTo.name}}</LinkTo>
                  <span class="users-list-date">{{t "views.app.issue.detail.assignedTo"}}</span>
                </div>
              </div>
              <div class="col-xs-9 col-md-10 issue-description"  data-field="issue.description">
                <h4>{{t "views.app.issue.detail.description"}}</h4>
                <p>
                  {{safe-html this.issue.description}}
                </p>
              </div>
            </div>

            <div class="row">

              <div class="col-xs-6 col-md-4" data-field="issue.priority">
                <h4>{{t "views.app.issue.detail.priority"}}</h4>
                <p>
                  <AppUi::PriorityIcon @priority={{this.issue.priority}}/> {{t (concat "views.app.issue.lists.priority." this.issue.priority)}}
                </p>
              </div>

              <div class="col-xs-6 col-md-4" data-field="issue.startDate">
                <h4>{{t "views.app.issue.detail.duration"}}</h4>
                <p>
                  {{moment-format this.issue.startDate 'Do MMM \'YY'}} - {{moment-format this.issue.endDate 'DD MMM \'YY'}}
                </p>
              </div>

              <div class="col-xs-6 col-md-4" data-field="issue.issuetype">
                <h4>{{t "views.app.issue.detail.type"}}</h4>
                <p>
                  {{this.issue.issuetype.name}}
                </p>
              </div>

              <div class="col-xs-6 col-md-4" data-field="issue.milestone">
                <h4>{{t "views.app.issue.detail.milestone"}}</h4>
                <p>
                  {{this.issue.issuemilestone.name}}
                </p>
              </div>

              <div class="col-xs-6 col-md-4" data-field="issue.parentissue">
                <h4>{{t "views.app.issue.detail.parent"}}</h4>
                {{#if this.issue.parentId}}
                  <LinkTo @route="app.project.issue.page" @model={{this.issue.parentissue.issueNumber}} {{action "navigateToIssue" this.issue.parentissue.issueNumber this.issue.projectId}}>
                    #{{this.issue.parentissue.issueNumber}} - {{this.issue.parentissue.subject}}
                  </LinkTo>
                {{else}}
                  <p>-</p>
                {{/if}}
              </div>

            </div>

          </div>
          {{!-- /.box-body --}}

          <div class="box-footer no-padding">
          </div>
        </div>
      </AccessControl>
      {{!-- /.end project details --}}

      {{!-- This div contains the issue conversations and milestones --}}
      <div class="row">

        {{!-- This is the issue conversations --}}
        <AccessControl @aclContext="issue.read">
          <div class="col-md-12" {{did-insert this.scrollToElement 'conversation'}}>
            <div class="box box-info conversations issue-conversation-section" data-conversation-id="{{this.issue.conversationroom.id}}">
              <div class="box-header with-border">
                <h3 class="box-title">{{t "views.app.issue.detail.conversation"}}</h3>
                <div class="box-tools pull-right">
                </div>
              </div>
              {{!-- /.box-header --}}
              <div class="box-body box-footer box-comments" {{did-insert this.scrollToElement 'comment'}}>

                {{#each this.issue.comments as |comment|}}
                  <ConversationUi::CommentItem 
                    @comment={{comment}} 
                    @usersList={{this.usersList}}
                    @issueSearch={{perform this.search}}
                  />
                {{/each}}

                <div class="box-footer box-comments">
                  <form action="#" method="post">
                    <img class="img-responsive img-circle img-sm" src="{{this.apiHost}}/userimage/get/{{this.currentUser.user.id}}" alt="{{this.currentUser.user.name}}">
                    {{!-- .img-push is used to add margin to elements next to floating images --}}
                    <div class="img-push">
                      <div class="message-box" data-field="issue.conversation">
                        <ConversationUi::MessageBox
                          @issueSearch={{perform this.search}}
                          @usersList={{this.usersList}}
                          @spellcheck={{false}}
                          @entity={{this.issue}}
                          @placeholder={{t "views.app.conversation.messagebox"}}
                          @save={{this.saveComment}}
                        />
                      </div>
                    </div>

                  </form>
                </div>
              </div>
            </div>
          </div>
        </AccessControl>

      </div>

      <div class="row">
        {{#unless @quickView}}
        {{!-- This is the project activities section --}}
        <AccessControl @aclContext="issue.read">
          <div class="col-md-12">
            <div class="box box-primary issue-activities-section">
              <div class="box-header with-border">
                <h3 class="box-title">{{t "views.app.issue.detail.issueactivities"}}</h3>
              </div>
              <div class="box-body no-padding">
                <div class="issue-activities">
                  <AppUi::Timeline @activities={{@activities}} @dataKey='data' as |key|>
                    {{moment-format key "Do MMM. YYYY"}}
                  </AppUi::Timeline>
                </div>
              </div>
            </div>
          </div>
        </AccessControl>
        {{!-- ./ end project activities section --}}
        {{/unless}}
      </div>


    </div>
    {{!-- /.end col-md -8 --}}

    <div class="col-md-{{if (and @quickView this.renderSingleColumn) '12' '4'}}">

      {{!-- Project Members --}}
      <AccessControl @aclContext="issue.read">
        <div class="box box-warning">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.project.detail.members"}}</h3>
            <div class="box-tools pull-right">
            </div>
          </div>
          {{!-- /.box-header --}}
          <div class="box-body no-padding">
            <ul class="users-list clearfix">
              <li>
                <img src="{{this.apiHost}}/userimage/get/{{this.issue.assignedTo.id}}" alt="{{this.issue.assignedTo.name}}">
                <div class="dropdown" data-issue-assignee-dropdown>
                  <div class="flex-row flex-ai-c flex-jc-c" data-toggle="dropdown">
                    <span class="users-list-name" data-issue-assignee>
                      {{this.issue.assignedTo.name}}
                    </span>
                      <i class="fa fa-caret-down"></i>
                  </div>
                  <ul class="dropdown-menu">
                    {{#each this.availableAssignees as |member|}}
                      <li>
                        <a href="#" {{on "click" (fn this.updateAssignee this.issue member)}}>
                          <img src="{{this.apiHost}}/userimage/get/{{member.id}}" alt="{{member.name}}" style="width: 20px; height: 20px; border-radius: 50%; margin-right: 8px;">
                          {{member.name}}
                        </a>
                      </li>
                    {{/each}}
                  </ul>
                </div>
                <span class="users-list-date">{{t "views.app.issue.detail.assignedTo"}}</span>
              </li>
              <li>
                <img src="{{this.apiHost}}/userimage/get/{{this.issue.ownedBy.id}}" alt="{{this.issue.ownedBy.name}}">
                <LinkTo @route="app.user.page" @model={{this.issue.ownedBy.id}} class="users-list-name">{{this.issue.ownedBy.name}}</LinkTo>
                <span class="users-list-date">{{t "views.app.issue.detail.ownedBy"}}</span>
              </li>
              <li>
                <img src="{{this.apiHost}}/userimage/get/{{this.issue.modifiedBy.id}}" alt="{{this.issue.modifiedBy.name}}">
                <LinkTo @route="app.user.page" @model={{this.issue.modifiedBy.id}} class="users-list-name">{{this.issue.modifiedBy.name}}</LinkTo>
                <span class="users-list-date">{{t "views.app.issue.detail.modifiedBy"}}</span>
              </li>
              <li>
                <img src="{{this.apiHost}}/userimage/get/{{this.issue.reportedBy.id}}" alt="{{this.issue.reportedBy.name}}">
                <LinkTo @route="app.user.page" @model={{this.issue.reportedBy.id}} class="users-list-name">{{this.issue.reportedBy.name}}</LinkTo>
                <span class="users-list-date">{{t "views.app.issue.detail.reportedBy"}}</span>
              </li>
            </ul>
            {{!-- /.users-list --}}
          </div>
          {{!-- /.box-body --}}
        </div>
      </AccessControl>
      {{!-- /. Project Members --}}

      <AccessControl @aclContext="issue.read">
      {{!-- Issue Files--}}
        <div class="box box-info issue-files-section">

          <div class="box-header with-border">

            <h3 class="box-title">{{t "views.app.issue.detail.files"}}</h3>

            <div class="box-tools pull-right">
            </div>

          </div>

          <div class="box-body no-padding">

            <div class="box-footer">
              <ul class="attachments clearfix">
                {{#each this.issue.files as |file|}}
                  <li>
                    {{#if (not-eq file.fileThumbnail '0')}}
                      <span class="attachment-icon has-img">
                        <img src="{{file.fileThumbnail}}" alt="{{file.name}}">
                      </span>
                    {{else}}
                      <AppUi::AttachmentIcon @mime={{file.fileMime}}/>
                    {{/if}}
                    <div class="attachment-info">
                      <div class="attachment-name clearfix">
                        <a href="#" {{action "previewFile" file}}><i class="fa fa-paperclip"></i><span class="attachment-file-name">{{file.name}}</span></a>
                      </div>
                      <div class="attachment-additional">
                        <span class="attachment-size">
                          {{file-size file.fileSize}}
                          <a href="#" {{action 'deleteFile' file}} class="btn btn-default btn-xs pull-right"><i class="fa fa-trash-o"></i></a>
                          <a href="#" {{action 'downloadFile' file}} class="btn btn-default btn-xs pull-right"><i class="fa fa-cloud-download"></i></a>
                        </span>
                      </div>
                    </div>
                  </li>
                {{/each}}
              </ul>
              <div class="filePreviewModal">
                {{#if this.filePreviewDialog}}
                  {{#bootstrap-modal
                      title="views.app.issue.detail.file.preview"
                      closeLabel="global.form.close"
                      close="removeModal"}}
                    <iframe title="{{t "views.app.issue.detail.file.preview"}}" id="file_preview"></iframe>
                  {{/bootstrap-modal}}
                {{/if}}
              </div>

            </div>
            <FormFields::FieldUpload
                @label={{t "views.app.issue.detail.selectfile"}}
                @uploadFile={{action "uploadFile"}}
            />

          </div>
        </div>
      </AccessControl>
      {{!-- Issue Files --}}

      <AccessControl @aclContext="timelog.read">
        <div class="box box-success issues-details">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.issue.detail.estimates"}}</h3>
          </div>
          {{!-- /.box-header --}}
          <div class="box-body no-padding">
            <ul class="time-log time-log-in-box products-list product-list-in-box" {{did-insert this.scrollToElement 'estimate'}}>
              {{#if (gt this.issue.estimated.length 0)}}
                {{#each this.issue.estimated as |timelog|}}
                  <li class="item" data-issue-estimate-id={{timelog.id}}>
                    <div class="user-img" data-toggle="tooltip" title="{{timelog.createdUserName}}">
                      <img class="img-circle" src="{{this.apiHost}}/userimage/get/{{timelog.createdUser}}" alt="{{timelog.createdUserName}}">
                    </div>
                    <div class="log-info">
                      <LinkTo @route="app.user.page" @model={{timelog.createdUser}} class="user-title">{{timelog.createdUserName}}</LinkTo>
                      <span>{{t "views.app.issue.detail.timelog.estimatedon"}}<strong>{{moment-format timelog.dateCreated 'MMM Do `YY' 'YYYY-MM-DD 00:00:00'}}</strong></span>
                      <span class="log-edit pull-right">
                        <a href="javascript:void(0);" {{action "showEditEstimateDialog" timelog}} data-toggle="tooltip" title="{{t "global.form.edit"}}"><i class="fa fa-pencil"></i></a>&nbsp;
                        <a href="javascript:void(0);" {{action "deleteLog" timelog}} data-toggle="tooltip" title="{{t "global.form.delete"}}"><i class="fa fa-trash-o"></i></a>
                      </span>
                      <span class="log-entry pull-right">
                        {{#if (gt timelog.days 0)}}{{timelog.days}}{{t "views.app.issue.detail.timelog.d"}}{{/if}}
                        {{#if (gt timelog.hours 0)}}{{timelog.hours}}{{t "views.app.issue.detail.timelog.h"}}{{/if}}
                        {{#if (gt timelog.minutes 0)}}{{timelog.minutes}}{{t "views.app.issue.detail.timelog.m"}}{{/if}}
                      </span>
                      <span class="log-description" {{modify-links}}>
                        {{safe-html timelog.description}}
                      </span>
                    </div>
                  </li>
                {{/each}}
              {{else}}
                <li class="no-entry">{{t "views.app.issue.detail.timelog.noestimates"}}</li>
              {{/if}}
            </ul>

            {{#if this.editEstimateDialog}}
              {{#bootstrap-modal
                  title="views.app.issue.detail.estimate.edit"
                  closeLabel="global.form.close"
                  confirmLabel="global.form.save"
                  close=(action "removeEditEstimateModal")
                  confirm=(action "editLog")}}

                <IntervalSelector
                  @days={{this.editingLog.days}}
                  @hours={{this.editingLog.hours}}
                  @minutes={{this.editingLog.minutes}}
                  @update={{fn this.updateTimelog this.editingLog}}
                />                      

                <div data-field="issue.editEstimateTime" data-field-type="wysiwyg" class="form-field ember-view">
                  <AppUi::ToastUi
                    @placeholder={{t "views.app.issue.detail.timelog.inputdescription"}}
                    @label={{t "views.app.issue.detail.timelog.description"}}
                    @onContentChange={{@selectStatic this.editingLog 'description'}}              
                    @data-field="issue.editEstimateTime"
                    @editType= 'wysiwyg'
                    @hide={{array 'footer'}}
                    @initialValue={{this.editingLog.description}}
                  />
                  <FormFields::Label
                    @label={{t "views.app.issue.detail.timelog.description"}}
                    @data-field="issue.editEstimateTime"
                  />
                </div>

              {{/bootstrap-modal}}
            {{/if}}

            {{#if this.estimateTimeDialog}}
              {{#bootstrap-modal
                  title="views.app.issue.detail.timelog.estimate"
                  closeLabel="global.form.close"
                  confirmLabel="global.form.save"
                  close=(action "removeEstimateTimeModal")
                  confirm=(action "addEstimate")}}

                <IntervalSelector
                  @days={{this.newTimeLog.days}}
                  @hours={{this.newTimeLog.hours}}
                  @minutes={{this.newTimeLog.minutes}}
                  @update={{fn this.updateTimelog this.newTimeLog}}
                />                      

                <div data-field="issue.estimateTime" data-field-type="wysiwyg" class="form-field ember-view">
                  <AppUi::ToastUi 
                    @placeholder={{t "views.app.issue.detail.timelog.inputdescription"}}
                    @onContentChange={{fn @selectStatic this.newTimeLog 'description'}}              
                    @editType= 'wysiwyg'
                    @hide={{array 'footer'}}
                    @initialValue={{this.newTimeLog.description}}
                  />
                  <FormFields::Label
                    @label={{t "views.app.issue.detail.timelog.description"}}
                    @data-field="issue.estimateTime"
                  />
                </div>

              {{/bootstrap-modal}}
            {{/if}}

          </div>

          <div class="box-footer text-center">
            <span>
              <a href="javascript:void(0);" id="addEstimateTime" {{action "showEstimateTimeDialog"}}><ion class="ion-md-stopwatch"></ion> {{t "views.app.issue.detail.timelog.estimate"}}</a>
            </span>
          </div>
        </div>
      </AccessControl>

      <AccessControl @aclContext="timelog.read">
      {{!-- Issue Timelogs --}}
        <div class="box box-danger">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.issue.detail.timelogs"}}</h3>
          </div>
          <div class="box-body no-padding">

            <ul class="time-log time-log-in-box products-list product-list-in-box" {{did-insert this.scrollToElement 'spent'}}>
              {{#if (gt this.issue.spent.length 0)}}
                {{#each this.issue.spent as |timelog|}}
                  <li class="item" data-issue-spent-id={{timelog.id}}>
                    <div class="user-img" data-toggle="tooltip" title="{{timelog.createdUserName}}">
                      <img class="img-circle" src="{{this.apiHost}}/userimage/get/{{timelog.createdUser}}" alt="{{timelog.createdUserName}}">
                    </div>
                    <div class="log-info">
                      <LinkTo @route="app.user.page" @model={{timelog.createdUser}} class="user-title">{{timelog.createdUserName}}</LinkTo>
                      <span>{{t "views.app.issue.detail.timelog.on"}}<strong>{{moment-format timelog.spentOn 'MMM Do `YY' 'YYYY-MM-DD 00:00:00'}}</strong></span>
                      <span class="log-edit pull-right">
                        <a href="javascript:void(0);" {{action "showEditLogDialog" timelog}} data-toggle="tooltip" title="{{t "global.form.edit"}}"><i class="fa fa-pencil"></i></a>&nbsp;
                        <a href="javascript:void(0);" {{action "deleteLog" timelog}} data-toggle="tooltip" title="{{t "global.form.delete"}}"><i class="fa fa-trash-o"></i></a>
                      </span>
                      <span class="log-entry pull-right">
                        {{#if (gt timelog.days 0)}}{{timelog.days}}{{t "views.app.issue.detail.timelog.d"}}{{/if}}
                        {{#if (gt timelog.hours 0)}}{{timelog.hours}}{{t "views.app.issue.detail.timelog.h"}}{{/if}}
                        {{#if (gt timelog.minutes 0)}}{{timelog.minutes}}{{t "views.app.issue.detail.timelog.m"}}{{/if}}
                      </span>
                      <span class="log-description">
                        {{safe-html timelog.description}}
                      </span>
                    </div>
                  </li>
                {{/each}}
              {{else}}
                <li class="no-entry">{{t "views.app.issue.detail.timelog.noentry"}}</li>
              {{/if}}
            </ul>

            {{#if this.editLogDialog}}
              {{#bootstrap-modal
                  title="views.app.issue.detail.timelog.edit"
                  closeLabel="global.form.close"
                  confirmLabel="global.form.save"
                  close=(action "removeEditLogModal")
                  confirm=(action "editLog")}}

                <IntervalSelector
                  @days={{this.editingLog.days}}
                  @hours={{this.editingLog.hours}}
                  @minutes={{this.editingLog.minutes}}
                  @update={{fn this.updateTimelog this.editingLog}}
                />                      

                <FormFields::FieldDate
                    @placeholder={{t "views.app.issue.detail.timelog.inputspenton"}}
                    @label={{t "views.app.issue.detail.timelog.spenton"}}
                    @value={{readonly this.editingLog.spentOn}}
                    @update={{fn @selectStatic this.editingLog 'spentOn'}}
                    @mask="alphanumeric"
                    @data-field="issue.detail.timelog.edit"
                    @format="YYYY-MM-DD"
                    @singleDatePicker={{true}}
                    @showDropdowns={{true}}
                    @positionX="right"
                    @positionY="down"
                    @autoApply={{true}}
                    @minDate='1990'
                />

                <div data-field="issue.editTimelog" data-field-type="wysiwyg" class="form-field ember-view">
                  <AppUi::ToastUi
                    @placeholder={{t "views.app.issue.detail.timelog.inputdescription"}}
                    @onContentChange={{fn @selectStatic this.editingLog 'description'}}              
                    @data-field="issue.editTimelog"
                    @editType='wysiwyg'
                    @hide={{array 'footer'}}
                    @initialValue={{this.editingLog.description}}
                  />
                  <FormFields::Label
                    @label={{t "views.app.issue.detail.timelog.description"}}
                    @data-field="issue.editTimelog"
                  />
                </div>

              {{/bootstrap-modal}}
            {{/if}}


            {{#if this.logTimeDialog}}
              {{#bootstrap-modal
                  title="views.app.issue.detail.timelog.log"
                  closeLabel="global.form.close"
                  confirmLabel="global.form.save"
                  close=(action "removeLogTimeModal")
                  confirm=(action "logTime")}}

                <IntervalSelector
                  @days={{this.newTimeLog.days}}
                  @hours={{this.newTimeLog.hours}}
                  @minutes={{this.newTimeLog.minutes}}
                  @update={{fn this.updateTimelog this.newTimeLog}}
                />                      

                <FormFields::FieldDate
                    @placeholder={{t "views.app.issue.detail.timelog.inputspenton"}}
                    @label={{t "views.app.issue.detail.timelog.spenton"}}
                    @value={{readonly this.newTimeLog.spentOn}}
                    @update={{fn @selectStatic this.newTimeLog 'spentOn'}}
                    @mask="alphanumeric"
                    @data-field="issue.detail.timelog.spenton"
                    @format="YYYY-MM-DD"
                    @singleDatePicker={{true}}
                    @showDropdowns={{true}}
                    @positionX="right"
                    @positionY="down"
                    @autoApply={{true}}
                    @minDate='1990'
                />

                <div data-field="issue.timelog" data-field-type="wysiwyg" class="form-field ember-view">
                  <AppUi::ToastUi
                    @placeholder={{t "views.app.issue.detail.timelog.inputdescription"}}
                    @onContentChange={{fn @selectStatic this.newTimeLog 'description'}}              
                    @data-field="issue.timelog"
                    @editType='wysiwyg'
                    @hide={{array 'footer'}}
                    @initialValue={{this.newTimeLog.description}}
                  />
                  <FormFields::Label
                    @label={{t "views.app.issue.detail.timelog.description"}}
                    @data-field="issue.timelog"
                  />
                </div>

              {{/bootstrap-modal}}
            {{/if}}
          </div>

          <div class="box-footer text-center">
            <span>
              <a href="javascript:void();" id="addLogTime" {{action "showLogTimeDialog"}}><ion class="ion-md-stopwatch"></ion> {{t "views.app.issue.detail.timelog.log"}}</a>
            </span>
          </div>
          {{!-- /.box-footer --}}
        </div>
      </AccessControl>

      <AccessControl @aclContext="issue.read">
        <div class="box box-info issue-hierarchy">
          <div class="box-header with-border">
            <h3 class="box-title">{{t "views.app.issue.detail.hierarchy"}}</h3>
          </div>

          <div class="box-body no-padding">
            <ul class="issue-overview clearfix {{unless this.issue.childissues.length 'no-child-issues'}}">
              {{#if this.issue.childissues.length}}
                <li class="current-issue" data-field="issue.parentissue">
                  <div class="issue-block">
                    <div class="priority"><AppUi::PriorityIcon @priority={{this.issue.priority}}/></div>
                    <div class="data-block">
                      <span class="subject">
                        <LinkTo
                          @route="app.project.issue.page"
                          @models={{array this.issue.projectShortcode this.issue.issueNumber}}
                        >#{{this.issue.issueNumber}}</LinkTo> - {{this.issue.subject}}
                      </span>
                      <span class="description">{{translate-comment this.issue.description}}</span>
                      <span class="badge {{this.issue.status}}">{{t (concat "views.app.issue.lists.status." this.issue.status)}}</span>
                    </div>
                  </div>
                </li>
              {{/if}}
              {{#if this.issue.childissues}}
                {{#each this.issue.childissues as |child|}}
                  <li class="child-issue" data-child-issue-id={{child.id}}>
                    <div class="issue-block">
                      <div class="priority"><AppUi::PriorityIcon @priority={{child.priority}}/></div>
                      <div class="data-block">
                        <span class="subject">
                          <LinkTo
                            @route="app.project.issue.page"
                            @models={{array child.projectShortcode child.issueNumber}}
                          >#{{child.issueNumber}}</LinkTo> - {{child.subject}}
                        </span>
                        <span class="description">{{translate-comment child.description}}</span>
                        <span class="badge {{child.status}}">{{t (concat "views.app.issue.lists.status." child.status)}}</span>
                      </div>
                    </div>
                  </li>
                {{/each}}
              {{else}}
                <Exceptions::NothingFound
                  @description={{t "views.app.issue.detail.childissues.noentry"}}
                />
              {{/if}}
            </ul>
          </div>
        </div>
      </AccessControl>
      {{!-- Project Summary --}}

    </div>
      {{!-- /.end col-md -4 --}}
  </div>
  {{!-- /.end row --}}
</div>
{{!-- /.end project --}}

{{!-- AI Planning Modal --}}
<Issue::IssuePlanning
  @isOpen={{this.issuePlanDialog}}
  @loading={{this.issuePlanLoading}}
  @error={{this.issuePlanError}}
  @data={{this.issuePlanData}}
  @issue={{this.issue}}
  @project={{this.project}}
  @onClose={{action this.removeIssuePlanDialog}}
  @issueStatuses={{@issueStatuses}}
  @issueTypes={{@issueTypes}}
  @scrollAndHighlight={{this.scrollAndHighlight}}
/>

{{!-- Add Watchers Modal --}}
{{#if this.addWatcherDialog}}
  {{#bootstrap-modal
      title="views.app.issue.watcher.addWatchers"
      closeLabel="global.form.close"
      close=(action "removeAddWatcherDialog")}}
    <div class="project-members-list">
      {{#if this.availableProjectMembers.length}}
        {{#each this.availableProjectMembers as |member|}}
            <div class="member-item flex-column flex-ai-c" data-member-id={{member.id}}>
              <img class="img-circle img-sm" src="{{this.apiHost}}/userimage/get/{{member.id}}" alt="{{member.name}}">
              <button type="button" class="btn btn-xs btn-success" {{on "click" (fn this.addWatcher member)}} data-toggle="tooltip" title="{{t 'views.app.issue.watcher.addWatcher'}}">
                <i class="fa fa-plus"></i>
              </button>
              <p data-toggle="tooltip" title="{{member.name}}">{{member.name}}</p>
            </div>
        {{/each}}
      {{else}}
        <Exceptions::NothingFound
          @infoIcon={{false}}
          @fontStyle='italic'
          @description={{t "views.app.issue.watcher.noAvailableMembers"}}
        />
      {{/if}}
    </div>
  {{/bootstrap-modal}}
{{/if}}
