<div class="box box-info linked-issues" data-test-linked-issues {{on-insert this.load}} {{on-update @issue.id this.load}}>
  <div class="box-header with-border">
    <h3 class="box-title">{{t "views.app.issue.detail.linkedIssues.title"}}</h3>
    <div class="box-tools pull-right">
      <AccessControl @aclContext="issue.update">
        <button type="button" class="btn btn-box-tool" title={{t "views.app.issue.detail.linkedIssues.link"}} data-test-linked-issues-link {{on "click" this.openLink}}><i class="fa fa-link" aria-hidden="true"></i> {{t "views.app.issue.detail.linkedIssues.link"}}</button>
      </AccessControl>
    </div>
  </div>

  <div class="box-body no-padding">
    {{#if this.isLoading}}
      <div class="text-center linked-issues-loading" data-test-linked-issues-loading>
        <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
      </div>
    {{else if this.loadFailed}}
      <Exceptions::NothingFound @description={{t "views.app.issue.detail.linkedIssues.loadFailed"}} />
    {{else if this.isEmpty}}
      <div data-test-linked-issues-empty><Exceptions::NothingFound @description={{t "views.app.issue.detail.linkedIssues.empty"}} /></div>
    {{else}}
      <AppUi::DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @depthKey="depth"
        @currentId={{this.currentId}}
        @expandedIds={{this.expandedIds}}
        @loadingIds={{this.loadingIds}}
        @isExpandable={{this.isExpandable}}
        @onToggle={{this.toggle}}
        @groupKey={{this.groupKey}}
        @groupLabel={{this.groupLabel}}
        @hideHeader={{true}}
        @hasMoreActions={{this.hasUnlink}}
      >
        <:cell as |record column|>
          {{#if (eq column.key "issue")}}
            <span class="linked-issue-subject" data-test-linked-issue={{record.issue.id}}>
              {{#each record.guides}}<span class="linked-issue-guide" data-test-linked-issue-guide aria-hidden="true"></span>{{/each}}
              {{#if record.isCurrent}}
                #{{record.issue.issueNumber}} {{record.issue.subject}}
                <small class="text-muted" data-test-linked-issue-current>({{t "views.app.issue.detail.linkedIssues.thisIssue"}})</small>
              {{else}}
                <LinkTo @route="app.project.issue.page" @models={{array (lowercase record.issue.projectShortcode) record.issue.issueNumber}}>{{this.label record.issue}}</LinkTo>
                {{record.issue.subject}}
              {{/if}}
            </span>
            {{#if record.error}}
              <div class="text-danger small" data-test-linked-issue-error>{{t "views.app.issue.detail.linkedIssues.loadNextFailed"}}</div>
            {{/if}}
          {{else if (eq column.key "status")}}
            <AppUi::StatusLabel @status={{record.issue.status}} />
          {{else}}
            <span class="linked-issue-assignee" data-test-linked-issue-assignee>
              <AppUi::Avatar @user={{record.issue.assignedTo}} @size="xs" />
              {{record.issue.assignedTo.name}}
            </span>
          {{/if}}
        </:cell>
        <:moreActions as |record|>
          <AccessControl @aclContext="issue.update">
            <button type="button" data-test-linked-issue-unlink={{record.issue.id}} {{on "click" (fn this.askUnlink record)}}><span>{{t "views.app.issue.detail.linkedIssues.unlink"}}</span></button>
          </AccessControl>
        </:moreActions>
      </AppUi::DataTable>
    {{/if}}
  </div>
</div>

{{#if this.showLink}}
  <Issue::LinkIssueModal @issue={{@issue}} @onLinked={{this.changed}} @onClose={{this.closeLink}} />
{{/if}}

{{#if this.unlinking}}
  <AppUi::Modal
    @title="views.app.issue.detail.linkedIssues.unlinkModal.title"
    @closeLabel="global.form.cancel"
    @confirmLabel="views.app.issue.detail.linkedIssues.unlinkModal.confirm"
    @confirm={{this.confirmUnlink}}
    @onClose={{this.closeUnlink}}
    data-test-unlink-modal
  >
    <p>{{t "views.app.issue.detail.linkedIssues.unlinkModal.message" issue=(this.code this.unlinking.issue)}}</p>
    {{#if this.unlinkError}}<span class="error text-red" data-test-unlink-error>{{this.unlinkError}}</span>{{/if}}
  </AppUi::Modal>
{{/if}}
