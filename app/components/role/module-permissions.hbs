<div class="panel panel-default" data-permission-module={{@name}}>
    <div class="panel-heading">
    <h4 class="panel-title">
        <a data-toggle="collapse" data-parent="#accordion" href={{concat "#" @name}} {{on "click" (fn
        @setPermissions @name)}}>{{t (concat "views.app.role.tabs.permission.modules." @name)}}</a>
    </h4>
    </div>
    <div id={{@name}} class="panel-collapse collapse">

    <div class="table-responsive">
        <table class="table table-hover table-striped">
        <thead>
            <tr>
            <th>{{t "views.app.role.tabs.permission.resource"}}</th>
            <th>{{t "views.app.role.tabs.permission.options.allow"}}</th>
            <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each @modulePermissions as |permission|}}
            <tr data-module-resource={{permission.resourceName}}>
            <td>{{t (concat "views.app.role.tabs.permission.labels." permission.resourceName)}}</td>
            <td>
                <Role::PermissionOptions
                @options={{get-permission-options 'apiOptions' permission}}
                @value={{permission.allowed}}
                @permission={{permission}}
                @flag="allowed"
                @updateDisableState={{this.updateDisableState}}
                />
            </td>
            
            <td>
                <span data-module="permission-state">
                {{#if (get @permissionsState (concat permission.moduleName '.' permission.resourceAlias '.isRunning'))}}
                    <i class="fa fa-spinner fa-spin"></i>
                {{/if}}

                {{#if (get @permissionsState (concat permission.moduleName '.' permission.resourceAlias '.isSuccessful'))}}
                    <i class="fa fa-check-circle"></i>
                {{/if}}

                {{#if (get @permissionsState (concat permission.moduleName '.' permission.resourceAlias '.isErrored'))}}
                    <i class="fa fa-times-circle"></i>
                {{/if}}
                </span>
            </td>
            </tr>
            {{/each}}
        </tbody>
        </table>
    </div>

    <AppUi::Button type="button" data-btn="save" class="btn btn-primary" @onClick={{fn this.updatePermission @name}}>{{t "global.form.save"}}</AppUi::Button>
    <AppUi::Button type="button" data-btn="cancel" class="btn btn-default" @onClick={{this.cancel}}>{{t "global.form.cancel"}}</AppUi::Button>
    </div>
</div>
