<div class="panel panel-default" data-permission-module={{@name}}>
    <div class="panel-heading">
    <h4 class="panel-title">
        <a data-toggle="collapse" data-parent="#accordion" href={{concat "#" @name}} {{on "click" (fn
        @setPermissions @name)}}>{{t (concat "views.app.role.tabs.permission.modules." @name)}}</a>
    </h4>
    </div>
    <div id={{@name}} class="panel-collapse collapse">

    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <li class="active">
          <a href={{concat "#" @name "-actions"}} data-toggle="tab">{{t "views.app.role.tabs.permission.actions"}}</a>
        </li>
        {{#if this.fieldPermissionGroups.length}}
        <li>
          <a href={{concat "#" @name "-fields"}} data-toggle="tab">{{t "views.app.role.tabs.permission.fields"}}</a>
        </li>
        {{/if}}
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade in active" id={{concat @name "-actions"}}>
          <div class="table-responsive">
            <table class="table table-hover table-striped">
              <thead>
                <tr>
                  <th>{{t "views.app.role.tabs.permission.resource"}}</th>
                  <th>{{t "views.app.role.tabs.permission.options.allow"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each this.actionPermissions as |row|}}
                <tr data-module-resource={{row.resourceName}}>
                  <td>{{row.displayLabel}}</td>
                  <td>
                    <Role::PermissionOptions
                      @options={{get-permission-options 'apiOptions' row.permission.allowed}}
                      @value={{row.permission.allowed}}
                      @permission={{row.permission}}
                      @flag="allowed"
                      @updateDisableState={{this.updateDisableState}}
                    />
                  </td>
                  <td>
                    <span data-module="permission-state">
                      {{#if (get @permissionsState (concat row.moduleName '.' row.resourceAlias '.isRunning'))}}
                        <i class="fa fa-spinner fa-spin"></i>
                      {{/if}}
                      {{#if (get @permissionsState (concat row.moduleName '.' row.resourceAlias '.isSuccessful'))}}
                        <i class="fa fa-check-circle"></i>
                      {{/if}}
                      {{#if (get @permissionsState (concat row.moduleName '.' row.resourceAlias '.isErrored'))}}
                        <i class="fa fa-times-circle"></i>
                      {{/if}}
                    </span>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        {{#if this.fieldPermissionGroups.length}}
        <div class="tab-pane fade" id={{concat @name "-fields"}} data-field-permissions={{@name}}>
          <div class="table-responsive">
            <table class="table table-hover table-striped">
              <thead>
                <tr>
                  <th>{{t "views.app.role.tabs.permission.field"}}</th>
                  <th>{{t "views.app.role.tabs.permission.options.allow"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each this.fieldPermissionGroups as |group|}}
                <tr data-field-group={{group.field}} data-field-access={{group.accessMode}} data-module-resource={{group.permission.resourceName}}>
                  <td>{{group.displayLabel}}</td>
                  <td>
                    <select data-field-access-select={{group.field}} {{on "change" (fn this.setFieldAccessMode group)}}>
                      {{#each this.fieldAccessOptions as |optionObject|}}
                      <option value={{optionObject.value}} selected={{eq group.accessMode optionObject.value}}>{{optionObject.label}}</option>
                      {{/each}}
                    </select>
                  </td>
                  <td>
                    {{#if group.permission}}
                    <span data-module="permission-state">
                      {{#if (get @permissionsState (concat group.permission.moduleName '.' group.permission.resourceAlias '.isRunning'))}}
                        <i class="fa fa-spinner fa-spin"></i>
                      {{/if}}
                      {{#if (get @permissionsState (concat group.permission.moduleName '.' group.permission.resourceAlias '.isSuccessful'))}}
                        <i class="fa fa-check-circle"></i>
                      {{/if}}
                      {{#if (get @permissionsState (concat group.permission.moduleName '.' group.permission.resourceAlias '.isErrored'))}}
                        <i class="fa fa-times-circle"></i>
                      {{/if}}
                    </span>
                    {{/if}}
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
        {{/if}}
      </div>
    </div>

    <AppUi::Button type="button" data-btn="save" class="btn btn-primary" @onClick={{fn this.updatePermission @name}}>{{t "global.form.save"}}</AppUi::Button>
    <AppUi::Button type="button" data-btn="close" class="btn btn-default" @onClick={{this.close}}>{{t "global.form.close"}}</AppUi::Button>
    </div>
</div>
