<div class='widgets-container' {{did-insert this.initSortable}} data-widgets>
{{#each-in @widgets as |key value|}}
	<div class='col-md-6 col-sm-12 widgets connectedSortable ui-sortable'>
		{{component
			(concat 'widgets/' (dasherize key))
			data=value
			widgetSettings=(get-prop @widgetSettings key)
			currentUser=@currentUser
		}}
	</div>
{{/each-in}}
</div>