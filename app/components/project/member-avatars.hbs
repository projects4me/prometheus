<div class="member-avatars">
  {{#each this.visibleMembers as |member|}}
    {{#if @linkToUser}}
      <a href="/app/user/{{member.id}}" data-member-link={{member.id}}>
        <AppUi::Avatar @user={{member}} @size={{this.size}} class="member-avatar" title={{member.name}} data-toggle="tooltip" />
      </a>
    {{else}}
      <AppUi::Avatar @user={{member}} @size={{this.size}} class="member-avatar" title={{member.name}} data-toggle="tooltip" />
    {{/if}}
  {{/each}}
  {{#if this.overflowCount}}
    <span class="member-avatars-overflow member-avatars-overflow-{{this.size}}" title="{{this.overflowCount}} more members" data-toggle="tooltip">
      +{{this.overflowCount}}
    </span>
  {{/if}}
</div>
