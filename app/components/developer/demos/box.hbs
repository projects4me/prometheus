<Developer::EntryHeader @entry={{@entry}} />
<Developer::Entry @onReset={{this.reset}}>
  <:demo>
    <AppUi::Box @variant={{this.variant}} @listView={{this.listView}} @noPadding={{this.noPadding}} @collapsed={{this.collapsed}} data-test-demo-box>
      <:header>{{#if this.showHeader}}<h3 class="box-title">Box title</h3>{{/if}}</:header>
      <:tools>{{#if this.showTools}}<button type="button" class="btn btn-box-tool"><i class="fa fa-cog"></i></button>{{/if}}</:tools>
      <:body>The body of the box.</:body>
      <:footer>{{#if this.showFooter}}The footer of the box.{{/if}}</:footer>
    </AppUi::Box>
  </:demo>
  <:controls>
    <div class="form-group">
      <label>Variant</label>
      <div class="btn-group" data-control-variant>
        {{#each this.variants as |variant|}}
          <button type="button" class="btn btn-default {{if (eq variant this.variant) 'active'}}" data-variant={{variant}} {{on "click" (fn this.setVariant variant)}}>{{variant}}</button>
        {{/each}}
      </div>
    </div>
    <FormFields::FieldCheckbox @label="Header" @checked={{this.showHeader}} @select={{fn this.toggle "showHeader"}} data-control-header />
    <FormFields::FieldCheckbox @label="Tools" @checked={{this.showTools}} @select={{fn this.toggle "showTools"}} data-control-tools />
    <FormFields::FieldCheckbox @label="Footer" @checked={{this.showFooter}} @select={{fn this.toggle "showFooter"}} data-control-footer />
    <FormFields::FieldCheckbox @label="List view" @checked={{this.listView}} @select={{fn this.toggle "listView"}} data-control-list-view />
    <FormFields::FieldCheckbox @label="No-padding body" @checked={{this.noPadding}} @select={{fn this.toggle "noPadding"}} data-control-no-padding />
    <FormFields::FieldCheckbox @label="Collapsed" @checked={{this.collapsed}} @select={{fn this.toggle "collapsed"}} data-control-collapsed />
  </:controls>
  <:docs>
    <Developer::Docs @doc="app-ui-box.md" />
  </:docs>
</Developer::Entry>
