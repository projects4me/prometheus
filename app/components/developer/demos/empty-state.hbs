<Developer::EntryHeader @entry={{@entry}} />
<Developer::Entry @onReset={{this.reset}}>
  <:demo>
    <div class="box box-primary" data-test-demo-empty-state>
      <div class="box-body">
        <AppUi::EmptyState @icon={{if this.customIcon "search"}} @message="No records found.">
          <:action>
            {{#if this.withAction}}
              <button type="button" class="btn btn-link quick-list__state-action">Clear the search</button>
            {{/if}}
          </:action>
        </AppUi::EmptyState>
      </div>
    </div>
  </:demo>
  <:controls>
    <FormFields::FieldCheckbox @label="Custom icon" @checked={{this.customIcon}} @select={{fn this.toggle "customIcon"}} data-control-icon />
    <FormFields::FieldCheckbox @label="Action" @checked={{this.withAction}} @select={{fn this.toggle "withAction"}} data-control-action />
  </:controls>
  <:docs>
    <Developer::Docs @doc="app-ui-empty-state.md" />
  </:docs>
</Developer::Entry>
