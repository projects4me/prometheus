<Developer::EntryHeader @entry={{@entry}} />
<Developer::Entry>
  <:demo>
    <table class="table table-condensed" data-demo-avatar>
      <thead>
        <tr><th></th>{{#each this.sizes as |size|}}<th>{{size.label}}</th>{{/each}}</tr>
      </thead>
      <tbody>
        {{#each this.users as |user|}}
          <tr>
            <th>{{user.label}}</th>
            {{#each this.sizes as |size|}}
              <td><AppUi::Avatar @user={{user.record}} @size={{size.value}} /></td>
            {{/each}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  </:demo>
  <:docs>
    <Developer::Docs @doc="app-ui-avatar.md" />
  </:docs>
</Developer::Entry>
