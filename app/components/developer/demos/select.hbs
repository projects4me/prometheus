<Developer::EntryHeader @entry={{@entry}} />
<Developer::Entry @onReset={{this.reset}}>
  <:demo as |log|>
    <div class="form-group" data-demo-select>
      <AppUi::Select
        @multiple={{this.multiple}}
        @options={{this.options}}
        @selected={{if this.multiple this.selectedMany this.selected}}
        @onChange={{fn this.change log}}
        @searchEnabled={{this.searchEnabled}}
        @searchField="label"
        @placeholder="Select a project"
        @noMatchesMessage="No projects found"
        @allowClear={{this.allowClear}}
        @disabled={{this.disabled}}
        @renderInPlace={{true}}
        @onOpen={{fn this.opened log}}
        @onClose={{fn this.closed log}}
        data-test-demo-select
        as |option|
      >
        <span data-demo-select-option={{option.value}}>{{option.label}}</span>
      </AppUi::Select>
    </div>
  </:demo>
  <:controls>
    <FormFields::FieldCheckbox @label="Multiple" @checked={{this.multiple}} @select={{fn this.toggle "multiple"}} data-control-multiple />
    <FormFields::FieldCheckbox @label="Search enabled" @checked={{this.searchEnabled}} @select={{fn this.toggle "searchEnabled"}} data-control-search />
    <FormFields::FieldCheckbox @label="Allow clear" @checked={{this.allowClear}} @select={{fn this.toggle "allowClear"}} data-control-clear />
    <FormFields::FieldCheckbox @label="Disabled" @checked={{this.disabled}} @select={{fn this.toggle "disabled"}} data-control-disabled />
  </:controls>
  <:docs>
    <Developer::Docs @doc="select.md" />
  </:docs>
</Developer::Entry>
