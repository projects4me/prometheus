<div
  class="app-dropdown"
  {{click-outside this.closeDropdown disabled=(not this.isOpen)}}
  ...attributes
>
  <button
    type="button"
    class="btn {{if @isPrimary 'btn-primary' 'btn-default'}} app-dropdown-btn"
    {{on "click" this.toggleDropdown}}
    aria-haspopup="true"
    aria-expanded={{this.isOpen}}
  >
    {{yield to="button"}}
    <i class="fa {{if this.isOpen 'fa-caret-up' 'fa-caret-down'}}"></i>
  </button>
  <div class="app-dropdown-content {{if this.isOpen 'show'}}">
    {{yield to="content"}}
  </div>
</div>