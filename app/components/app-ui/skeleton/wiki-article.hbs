<div class="wiki-detail box box-primary wiki-article-skeleton" data-test-skeleton-wiki-article>

  {{!-- Header: lock icon placeholder + title + meta --}}
  <div class="box-header with-border" style="display: flex; align-items: flex-start; gap: 0.75rem;">
    <div style="flex: 1;">
      <span class="skeleton-line skeleton-line--title" style="width: 50%;"></span>
      <div style="display: flex; gap: 1rem; margin-top: 0.6rem;">
        <span class="skeleton-line skeleton-line--xs" style="width: 10rem;"></span>
        <span class="skeleton-line skeleton-line--xs" style="width: 8rem;"></span>
      </div>
    </div>
    <div class="box-tools pull-right" style="display: flex; gap: 0.5rem;">
      <span class="skeleton-line skeleton-line--xs" style="width: 6rem;"></span>
    </div>
  </div>

  {{!-- Article body: paragraph blocks --}}
  <div class="box-body">
    {{#each (array 1 2 3)}}
      <div style="margin-bottom: 2rem;">
        <span class="skeleton-line skeleton-line--heading" style="width: 35%;"></span>
        <span class="skeleton-line"></span>
        <span class="skeleton-line skeleton-line--medium"></span>
        <span class="skeleton-line skeleton-line--short"></span>
        <span class="skeleton-line"></span>
        <span class="skeleton-line skeleton-line--medium"></span>
      </div>
    {{/each}}

    {{!-- Code/content block placeholder --}}
    <span class="skeleton-rect skeleton-rect--content" style="height: 14rem;"></span>
  </div>

</div>
