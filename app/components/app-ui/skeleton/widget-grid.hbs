<section class="content-header">
  <h1>
    <span class="skeleton-line skeleton-line--heading"></span>
  </h1>
  <div class="page-skeleton-breadcrumb">
    <span class="skeleton-line skeleton-line--xs"></span>
    <span class="skeleton-line skeleton-line--xs"></span>
  </div>
</section>

<section class="content" data-test-skeleton-widget-grid>
  <div class="row">
    <div class="col-md-6">
      {{#each (array 1 2 3)}}
        <div class="box box-primary">
          <div class="skeleton-box-header with-border">
            <span class="skeleton-line skeleton-line--subtitle"></span>
          </div>
          <div class="skeleton-box-body">
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem;">
              {{#each (array 1 2 3 4 5)}}
                <div style="padding: 0.75rem; border: 1px solid #f4f4f4; border-radius: 0.4rem;">
                  <span class="skeleton-line skeleton-line--xs" style="width: 60%;"></span>
                  <div style="display: flex; gap: 0.4rem; margin-top: 0.4rem;">
                    <span class="skeleton-rect" style="height: 1.6rem; flex: 1; margin-top: 0;"></span>
                    <span class="skeleton-rect" style="height: 1.6rem; flex: 1; margin-top: 0;"></span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>

    <div class="col-md-6">
      {{#each (array 1 2)}}
        <div class="box box-primary">
          <div class="skeleton-box-header with-border">
            <span class="skeleton-line skeleton-line--subtitle"></span>
          </div>
          <div class="skeleton-box-body">
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem;">
              {{#each (array 1 2 3 4 5)}}
                <div style="padding: 0.75rem; border: 1px solid #f4f4f4; border-radius: 0.4rem;">
                  <span class="skeleton-line skeleton-line--xs" style="width: 60%;"></span>
                  <div style="display: flex; gap: 0.4rem; margin-top: 0.4rem;">
                    <span class="skeleton-rect" style="height: 1.6rem; flex: 1; margin-top: 0;"></span>
                    <span class="skeleton-rect" style="height: 1.6rem; flex: 1; margin-top: 0;"></span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</section>
