<div class="page-skeleton" data-test-page-loading>
  <div class="box box-primary">
    <div class="skeleton-box-header">
      <span class="skeleton-line skeleton-line--subtitle"></span>
    </div>
    <div class="skeleton-toolbar">
      <span class="skeleton-line skeleton-line--xs"></span>
      <span class="skeleton-line skeleton-line--xs"></span>
      <span class="skeleton-line skeleton-line--xs"></span>
    </div>
    <div class="skeleton-box-body--flush">
      {{#each (array 1 2 3 4 5 6)}}
        <div class="skeleton-list-row">
          <span class="skeleton-circle skeleton-circle--sm"></span>
          <div class="skeleton-list-row__content">
            <span class="skeleton-line skeleton-line--short"></span>
            <span class="skeleton-line skeleton-line--medium"></span>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="box box-default">
    <div class="skeleton-box-header">
      <span class="skeleton-line skeleton-line--subtitle"></span>
    </div>
    <div class="skeleton-box-body">
      <span class="skeleton-line skeleton-line--heading"></span>
      <span class="skeleton-line"></span>
      <span class="skeleton-line"></span>
      <span class="skeleton-line skeleton-line--medium"></span>
      <span class="skeleton-rect skeleton-rect--content"></span>
    </div>
  </div>
</div>
