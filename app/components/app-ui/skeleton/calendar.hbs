<div class="calendar" data-test-skeleton-calendar>
  <div class="row">
    <div class="col-md-12">
      <div class="box box-primary">
        <div class="box-header with-border">
          <span class="skeleton-line skeleton-line--subtitle"></span>
        </div>
        <div class="box-body no-padding" style="padding: 1rem !important;">
          <div class="row" style="margin-bottom: 0.8rem;">
            {{#each (array 1 2 3 4 5 6 7)}}
              <div class="col-xs-1" style="width: 14.28%;">
                <span class="skeleton-line skeleton-line--xs" style="width: 100%;"></span>
              </div>
            {{/each}}
          </div>

          {{#each (array 1 2 3 4 5)}}
            <div class="row" style="margin-bottom: 0.6rem;">
              {{#each (array 1 2 3 4 5 6 7)}}
                <div class="col-xs-1" style="width: 14.28%;">
                  <span class="skeleton-rect" style="display: block; height: 5rem; border-radius: 0.3rem;"></span>
                </div>
              {{/each}}
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</div>
