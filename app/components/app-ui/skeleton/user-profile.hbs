<div class="user-page">
  <section class="content-header">
    <h1>
      <span class="skeleton-line skeleton-line--heading"></span>
    </h1>
    <div class="page-skeleton-breadcrumb">
      <span class="skeleton-line skeleton-line--xs"></span>
      <span class="skeleton-line skeleton-line--xs"></span>
    </div>
  </section>

  <section class="content">
    <div class="row">
      <div class="col-md-3 col-sm-3">
        <div class="box box-primary">
          <div class="box-body box-profile">
            <div class="user-info">
              <span class="skeleton-circle skeleton-circle--sm" style="margin-bottom: 1rem;"></span>
              <span class="skeleton-line skeleton-line--title" style="margin-bottom: 0.5rem;"></span>
              <span class="skeleton-line skeleton-line--subtitle" style="width: 60%;"></span>
              <span class="skeleton-line skeleton-line--xs"></span>
              <span class="skeleton-line skeleton-line--xs" style="width: 9rem;"></span>
            </div>

            {{!-- Social links row placeholder --}}
            <div style="margin-top: 1.25rem;">
              <span class="skeleton-line skeleton-line--short" style="width: 85%;"></span>
            </div>

            {{!-- Meta fields --}}
            <div style="margin-top: 1rem;">
              {{#each (array 1 2 3 4)}}
                <div class="skeleton-list-row" style="padding: 0.8rem 0;">
                  <span class="skeleton-circle skeleton-circle--sm" style="height: 1.4rem; width: 1.4rem;"></span>
                  <div class="skeleton-list-row__content">
                    <span class="skeleton-line skeleton-line--short"></span>
                    <span class="skeleton-line skeleton-line--xs" style="width: 10rem;"></span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-9">
        <div class="row">
          {{#each (array 1 2 3 4)}}
            <div class="col-md-3">
              <div class="box box-primary">
                <div class="box-header with-border">
                  <span class="skeleton-line skeleton-line--subtitle"></span>
                </div>
                <div class="box-body">
                  <span class="skeleton-rect skeleton-rect--content" style="height: 4.5rem;"></span>
                </div>
              </div>
            </div>
          {{/each}}
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="box box-primary">
              <div class="box-header with-border">
                <span class="skeleton-line skeleton-line--subtitle"></span>
              </div>
              <div class="box-body">
                {{#each (array 1 2 3 4)}}
                  <div class="skeleton-list-row">
                    <span class="skeleton-circle skeleton-circle--sm"></span>
                    <div class="skeleton-list-row__content">
                      <span class="skeleton-line skeleton-line--short"></span>
                      <span class="skeleton-line skeleton-line--xs" style="width: 9rem;"></span>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="box box-primary">
              <div class="box-header with-border">
                <span class="skeleton-line skeleton-line--subtitle"></span>
              </div>
              <div class="box-body">
                {{#each (array 1 2 3 4)}}
                  <div class="skeleton-list-row">
                    <span class="skeleton-circle skeleton-circle--sm"></span>
                    <div class="skeleton-list-row__content">
                      <span class="skeleton-line skeleton-line--short"></span>
                      <span class="skeleton-line skeleton-line--xs" style="width: 9rem;"></span>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>

        <div class="row" style="margin-top: 1.25rem;">
          <div class="col-md-8">
            <div class="box box-primary">
              <div class="box-header with-border">
                <span class="skeleton-line skeleton-line--subtitle"></span>
              </div>
              <div class="box-body">
                {{#each (array 1 2 3 4 5)}}
                  <div class="skeleton-list-row">
                    <span class="skeleton-circle skeleton-circle--sm"></span>
                    <div class="skeleton-list-row__content">
                      <span class="skeleton-line skeleton-line--short"></span>
                      <span class="skeleton-line skeleton-line--xs" style="width: 12rem;"></span>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="box box-primary">
              <div class="box-header with-border">
                <span class="skeleton-line skeleton-line--subtitle"></span>
              </div>
              <div class="box-body">
                {{#each (array 1 2 3 4)}}
                  <div class="skeleton-list-row">
                    <span class="skeleton-circle skeleton-circle--sm"></span>
                    <div class="skeleton-list-row__content">
                      <span class="skeleton-line skeleton-line--short"></span>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
