{{#each-in @meta as |module definition|}}
{{#if (this.isDisabled definition)}}
  <li class="nav-disabled" data-navigation-module={{module}} title={{t "views.nav.selectProjectTitle"}}>
    <a role="link" aria-disabled="true" tabindex="-1">
      <i class="fa fa-{{definition.icon}}"></i>
      <span>{{t definition.label}}</span>
    </a>
  </li>
{{else if definition.actions}}
  {{#let (is-active-route definition.route) as |active|}}
  {{#let (this.isOpen module active) as |open|}}
  <li class="treeview {{if active 'active'}} {{if open 'menu-open'}}" data-navigation-module={{module}}>
    <a href={{this.hrefFor definition}} {{on "click" (prevent-default this.toggle module open)}}>
      <i class="fa fa-{{definition.icon}}"></i>
      <span>{{t definition.label}}</span>
      <span class="pull-right-container">
        <i class="fa fa-angle-left pull-right"></i>
      </span>
    </a>
    <ul class="treeview-menu">
      {{#each-in definition.actions as |section menu|}}
        {{#each-in menu as |entity item|}}
          <li data-navigation-action={{entity}}>
            <a href={{this.hrefFor item}} {{on "click" (prevent-default @navigate item)}}>
              <i class="fa fa-circle-o {{item.className}}"></i>{{t item.label}}
            </a>
          </li>
        {{/each-in}}
        {{#if (not-last definition.actions menu)}}
          <li role="separator" class="divider"></li>
        {{/if}}
      {{/each-in}}
    </ul>
  </li>
  {{/let}}
  {{/let}}
{{else}}
  <li class="treeview {{if (is-active-route definition.route) 'active'}}" data-navigation-module={{module}}>
    <a href={{this.hrefFor definition}} {{on "click" (prevent-default @navigate definition)}}>
      <i class="fa fa-{{definition.icon}}"></i>
      <span>{{t definition.label}}</span>
    </a>
  </li>
{{/if}}
{{/each-in}}
