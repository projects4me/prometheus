<div class="milestone box" data-milestone-details={{this.milestone.id}} {{sticky-board-headers}}>
  
  <div class="box-header with-border">
    <div class="milestone-header-content flex-row">
      <div class="milestone-icon {{this.milestoneBgClass}} flex-row jc-c">
        <i class="{{this.milestoneIcon}}"></i>
      </div>
      
      <div class="milestone-progress-section">
        <div class="milestone-progress-info flex-row flex-jc-sb">
          <strong class="progress-description">{{this.milestoneProgress}}% ({{this.completedIssuesCount}}/{{this.milestone.issues.length}} {{t "global.module.plural.issue"}})</strong>
          <div class="flex-row">
            <div data-milestone-time="spent">{{t "views.app.board.spent"}} {{this.spent.hours}} {{t "views.app.board.hours"}} {{this.spent.minutes}} {{t "views.app.board.minutes"}}</div>
            <div>&nbsp;|&nbsp;</div>
            <div data-milestone-time="estimated">{{t "views.app.board.estimated"}} {{this.estimated.hours}} {{t "views.app.board.hours"}} {{this.estimated.minutes}} {{t "views.app.board.minutes"}}</div>
          </div>
          <span data-milestone="dates">
            {{date-format this.milestone.startDate 'Do MMM. YYYY'}} - {{date-format this.milestone.endDate 'Do MMM. YYYY'}}
          </span>
        </div>
        
        <div class="progress">
          <div class="progress-bar" style={{progress-width this.milestoneProgress}} data-toggle="tooltip" title="{{t "views.app.project.detail.milestone.progress" closed=this.completedIssuesCount total=this.milestone.issues.length}}"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="lane-status-bar" data-lane-status-bar aria-label={{t "views.app.board.laneStatusBar"}}>
    {{#each @statuses as |status|}}
      <button type="button" class="lane-status-chip {{if (eq status.name this.activeLane) "is-active"}}" data-lane-chip={{status.name}} {{on "click" (fn this.scrollToLane status.name)}}>
        {{status-label status.name}} <span class="lane-status-chip-count">({{call (fn this.getIssuesCountForStatus status.name)}})</span>
      </button>
    {{/each}}
  </div>

  <div class="milestone box-body" data-field-milestone-id={{if this.milestone.id this.milestone.id "backlog"}} {{observe-active-lane this.setActiveLane}}>
    {{#each @statuses as |status|}}
      {{#let (includes status.name this.collapsedLanes) as |collapsed|}}
      <div class="lane {{if collapsed "lane-collapsed"}}" data-lane-name={{status.name}}>
        
        <div class="box-header with-border box {{get-prop @statusClass status.name}}" style={{if status.color (status-style status.name "border-top-color")}} data-field-status="{{status.name}}">
          <div class="flex-row flex-jc-sb flex-ai-c lane-header">
            <button type="button" class="btn btn-box-tool lane-collapse-toggle" data-lane-toggle={{status.name}} title={{t (if collapsed "views.app.board.expandLane" "views.app.board.collapseLane")}} {{on "click" (fn this.toggleLane status.name)}}>
              <i class="fa {{if collapsed "fa-angle-right" "fa-angle-left"}}"></i>
            </button>
            <div class="lane-title">
              <span class="lane-name">{{status-label status.name}}</span> <span class="lane-count">({{call (fn this.getIssuesCountForStatus status.name)}})</span>{{#if collapsed}} <i class="fa fa-arrow-down lane-drop-icon" aria-hidden="true"></i>{{/if}}
            </div>
            {{#unless collapsed}}
              <AppUi::DottedAddButton 
                @onClick={{fn this.showAddIssueDialog status.name}}
                @title={{t "views.app.board.issue.create"}}
                @data-add={{concat "issue-" status.name}}
                @aclContext="issue.create"
              />
            {{/unless}}
          </div>
        </div>

        <div class="lane box-body lane-status-{{get-prop @statusClass status.name}}" style={{if status.color (status-style status.name "--lane-color")}} data-field-lane-group={{@group}} data-field-milestone-id={{this.milestone.id}} data-field-status="{{status.name}}" data-issue-status-id={{status.id}}>
          {{#if (eq (call (fn this.getIssuesCountForStatus status.name)) 0)}}
            <div class="lane-empty" data-lane-empty={{status.name}}>
              <i class="fa fa-inbox" aria-hidden="true"></i>
              <span>{{t "views.app.board.laneEmpty" status=(status-label status.name)}}</span>
            </div>
          {{/if}}
          <AppUi::TaskBoard::IssuesProvider @issues={{this.sortedIssues}} as |issues|>
            {{#each issues as |issue|}}
              {{#if (eq issue.status status.name)}}
                <div class="board-issue-item" style="{{laneitem-color issue.issuetype.name}}" data-field-issue-id="{{issue.id}}" data-field-issue-status="{{issue.status}}" data-field-issue-milestone="{{issue.milestoneId}}">
                  <div class="flex-row flex-ai-c issue-card-meta flex-jc-sb">
                    <div class="flex-row flex-ai-c issue-card-meta-left">
                      <span class="issue-number">#{{issue.issueNumber}}</span>
                      <span class="issue-priority badge priority-{{issue.priority}}">
                        <AppUi::PriorityIcon @priority={{issue.priority}} />
                        {{t (concat "views.app.issue.lists.priority." issue.priority)}}
                      </span>
                    </div>
                    <button type="button" class="btn btn-box-tool issue-card-move" data-issue-move data-test-issue-move title={{t "views.app.board.move.action"}} aria-label={{t "views.app.board.move.action"}} {{on "click" (fn this.openMoveIssue issue)}}>
                      <i class="fa fa-arrows" aria-hidden="true"></i>
                    </button>
                  </div>

                  {{!-- Issue card subject --}}
                  <div class="issue-card-subject">
                    <LinkTo @route="app.project.issue.page" @disabledClass="navigate-issue-quick-view" @disabled={{true}} @model={{issue.issueNumber}} title={{issue.subject}} {{on "click" (fn @selectIssue issue)}}>
                      {{issue.subject}}
                    </LinkTo>
                  </div>

                  {{#if issue.parentissue}}
                    <div class="issue-parent-reference">
                      <span>{{t "views.app.issue.create.parentIssue"}}:</span>
                      <LinkTo
                        @route="app.project.issue.page"
                        @disabledClass="navigate-issue-quick-view"
                        @disabled={{true}}
                        @model={{issue.parentissue.issueNumber}}
                        {{on "click" (fn @selectIssue issue.parentissue)}}
                      >
                        #{{issue.parentissue.issueNumber}}
                      </LinkTo>
                    </div>
                  {{/if}}

                  {{!-- Issue card effort --}}
                  <div class="flex-row flex-ai-c flex-jc-sb issue-card-effort">
                    <span><i class="fa fa-clock-o"></i> {{t "views.app.board.estimated"}}: {{call (fn this.getIssueTimeLabel issue "estimated")}}</span>
                    <span><i class="fa fa-hourglass-half"></i> {{t "views.app.board.spent"}}: {{call (fn this.getIssueTimeLabel issue "spent")}}</span>
                  </div>

                  {{!-- Issue card time left --}}
                  {{#let (call (fn this.getIssueTimeLeftMeta issue)) as |timeLeftMeta|}}
                    {{#if timeLeftMeta.isVisible}}
                      <div class="issue-card-time-left-wrap">
                        <div class="issue-card-time-left {{if (eq timeLeftMeta.state "warning") "is-warning"}} {{if (eq timeLeftMeta.state "overdue") "is-overdue"}}">
                          <i class="fa {{if (eq timeLeftMeta.state "overdue") "fa-calendar-times-o" "fa-calendar-o"}}"></i>
                          {{timeLeftMeta.label}}
                        </div>
                      </div>
                    {{/if}}
                  {{/let}}                  

                  {{!-- Issue card footer --}}
                  <div class="flex-row flex-jc-sb flex-ai-c issue-card-footer">
                    <div class="issue-card-tags">
                      {{#if issue.issuetype.name}}
                        <span class="badge issue-type-tag" style={{call (fn this.getIssueTypeTagStyle issue)}}>
                          {{type-label issue.issuetype}}
                        </span>
                      {{/if}}
                      {{#if issue.infoTag}}
                        <span class="badge info-tag">{{issue.infoTag}}</span>
                      {{/if}}
                    </div>
                  
                      <div class="flex-row flex-ai-c flex-jc-sb issue-card-right-meta">
                        {{#if issue.files.length}}
                          <div class="issue-card-files-count">
                            <i class="fa fa-paperclip"></i> {{issue.files.length}}
                          </div>
                        {{/if}}

                        {{#if issue.comments.length}}
                          <div class="issue-card-comments-count">
                            <i class="fa fa-comments-o"></i> {{issue.comments.length}}
                          </div>
                        {{/if}}
                        <div class="issue-card-assignee">
                          <Issue::AssigneeSelect @issue={{issue}} @members={{@members}} @compact={{true}} />
                        </div>
                      </div>
                  </div>
                  
                  {{#if issue.isSaving}}
                    <div class="item-overlay" {{lock-item}}>
                      <div class="dot-pulse"></div>
                    </div>
                  {{/if}}

                </div>
              {{/if}}
            {{/each}}
          </AppUi::TaskBoard::IssuesProvider>

        </div>
      </div>
      {{/let}}
    {{/each}}
  </div>

</div>

{{!-- Add Issue Modal --}}
{{#if this.addIssueDialog}}
  <AppUi::Modal
    @title="views.app.board.issue.create"
    @closeLabel="global.form.close"
    @confirmLabel="global.form.save"
    @onClose={{this.removeAddIssueModal}}
    @confirm={{this.saveIssue}}
  >
    <div class="form-group">
      <FormFields::FieldText
        @placeholder={{t "views.app.issue.create.placeholder.subject"}}
        @label={{t "views.app.issue.create.subject"}}
        @type="text"
        @value={{this.newIssue.subject}}
        @data-field="issue.subject"
        @length="255"
        @validate={{fn @validateField "issueCreate" (hash name="subject" value=this.newIssue.subject model=this.newIssue)}}
        @message={{@message.issueCreate.subject}}
        @aclContext="issue.create"
        {{autofocus}}
      />

      <AppUi::Editor
        @label={{t "views.app.issue.create.description"}}
        @data-field="issue.description"
        data-field="issue.description"
        @usersList={{@membersList}}
        @issueSearch={{perform @search}}
        @value={{this.newIssue.description}}
        @onChange={{fn @selectStatic this.newIssue 'description'}}
      />

      <FormFields::FieldRelate
        @renderInPlace={{true}}
        @placeholder={{t "views.app.issue.create.type"}}
        @label={{t "views.app.issue.create.type"}}
        @value={{this.newIssue.typeId}}
        @options={{this.typeList}}
        @selected={{find-by "value" this.newIssue.typeId this.typeList}}
        @searchField="label"
        @onchange={{fn @selectRelated this.newIssue 'typeId'}}
        @relateType="relate-simple"
        @data-field="issue.type"
        @validate={{fn @validateField "issueCreate" (hash name="typeId" value=this.newIssue.typeId model=this.newIssue)}}
        @message={{@message.issueCreate.typeId}}
      />

      <FormFields::FieldRelate
        @renderInPlace={{true}}
        @placeholder={{t "views.app.issue.create.status"}}
        @label={{t "views.app.issue.create.status"}}
        @value={{this.newIssue.statusId}}
        @options={{this.issueStatusList}}
        @selected={{find-by "value" this.newIssue.statusId this.issueStatusList}}
        @searchField="label"
        @onchange={{fn @selectRelated this.newIssue 'statusId'}}
        @relateType="relate-simple"
        @data-field="issue.status"
        @validate={{fn @validateField "issueCreate" (hash name="statusId" value=this.newIssue.statusId model=this.newIssue)}}                
        @message={{@message.issueCreate.statusId}}
        @disabled={{true}}
      />

      <FormFields::FieldRelate
        @renderInPlace={{true}}
        @placeholder={{t "views.app.issue.create.priority"}}
        @label={{t "views.app.issue.create.priority"}}
        @value={{this.newIssue.priority}}
        @options={{this.priority}}
        @selected={{find-by "value" this.newIssue.priority this.priority}}
        @searchField="label"
        @onchange={{fn @selectRelated this.newIssue 'priority'}}
        @relateType="relate-issuepriority"
        @data-field="issue.priority"
        @validate={{fn @validateField "issueCreate" (hash name="priority" value=this.newIssue.priority model=this.newIssue)}}
        @message={{@message.issueCreate.priority}}
      />

      <FormFields::FieldDate
        @placeholder={{t "views.app.issue.create.placeholder.startDate"}}
        @label={{t "views.app.issue.create.startDate"}}
        @value="{{readonly this.newIssue.startDate}}"
        @update={{fn @selectStatic this.newIssue 'startDate'}}
        @data-field="issue.startDate"
        @format="YYYY-MM-DD"
        @singleDatePicker={{true}}
        @showDropdowns={{true}}
        @positionX="right"
        @positionY="down"
        @autoApply={{true}}
        @minDate='1990'
        @validate={{fn @validateField "issueCreate" (hash name="startDate" value=this.newIssue.startDate model=this.newIssue)}}                
        @message={{@message.issueCreate.startDate}}
      />

      <FormFields::FieldDate
        @placeholder={{t "views.app.issue.create.placeholder.endDate"}}
        @label={{t "views.app.issue.create.endDate"}}
        @value={{readonly this.newIssue.endDate}}
        @update={{fn @selectStatic this.newIssue 'endDate'}}
        @data-field="issue.endDate"
        @format="YYYY-MM-DD"
        @singleDatePicker={{true}}
        @showDropdowns={{true}}
        @positionX="right"
        @positionY="down"
        @autoApply={{true}}
        @minDate='1990'
        @validate={{fn @validateField "issueCreate" (hash name="endDate" value=this.newIssue.endDate model=this.newIssue)}}                
        @message={{@message.issueCreate.endDate}}
      />
    </div>
  </AppUi::Modal>
{{/if}}

{{#if this.movingIssue}}
  <AppUi::TaskBoard::MoveIssue
    @issue={{this.movingIssue}}
    @statuses={{@statuses}}
    @members={{@members}}
    @milestones={{@milestones}}
    @onSave={{this.saveMoveIssue}}
    @onClose={{this.closeMoveIssue}}
  />
{{/if}}
