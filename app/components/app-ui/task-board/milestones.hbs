<div class="milestone box">
  
  <div class="box-header with-border">
    <div class="milestone-header-content flex-row">
      <div class="milestone-icon {{this.milestoneBgClass}} flex-row jc-c">
        <i class="{{this.milestoneIcon}}"></i>
      </div>
      
      <div class="milestone-progress-section">
        <div class="milestone-progress-info flex-row flex-jc-sb">
          <span class="progress-description">{{this.milestoneProgress}}% ({{this.completedIssuesCount}}/{{this.milestone.issues.length}} {{t "global.module.plural.issue"}})</span>
          <span data-milestone="dates">
            {{moment-format this.milestone.startDate 'Do MMM. YYYY'}} - {{moment-format this.milestone.endDate 'Do MMM. YYYY'}}
          </span>
        </div>
        
        <div class="progress">
          <div class="progress-bar" style={{progress-width this.milestoneProgress}} data-toggle="tooltip" title="{{t "views.app.project.detail.milestone.progress" closed=this.completedIssuesCount total=this.milestone.issues.length}}"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="milestone box-body" data-field-milestone-id={{this.milestone.id}}>
    {{#each @statuses as |status|}}
      <div class="lane">
        
        <div class="box {{get-prop @statusClass status.name}}">

          <div class="box-header with-border" data-field-status="{{status.name}}">
            {{t (concat "views.app.issue.lists.status." status.name)}} ({{call (fn this.getIssuesCountForStatus status.name)}})
          </div>

          <div class="lane box-body" data-field-lane-group={{@group}} data-field-milestone-id={{this.milestone.id}} data-field-status="{{status.name}}" data-issue-status-id={{status.id}}>
            <AppUi::TaskBoard::IssuesProvider @issues={{this.milestone.issues}} @query={{@query}} as |issues|>
              {{#each issues as |issue|}}
                {{#if (eq issue.status status.name)}}
                  <div class="item" style="{{laneitem-color issue.issuetype.name}}" data-field-issue-id="{{issue.id}}" data-field-issue-status="{{issue.status}}" data-field-issue-milestone="{{issue.milestoneId}}">
                  
                    <h4>{{priority-icon priority=(readonly issue.priority)}} <LinkTo @route="app.project.issue.page" @model={{issue.issueNumber}} {{action @openIssue issue}}>#{{issue.issueNumber}} - {{issue.subject}}</LinkTo></h4>
                    <p class="description">{{safe-html issue.description}}</p>
                    <div class="flex-row flex-jc-end">
                      <div><img class="img-circle" src="{{this.apiHost}}/userimage/get/{{issue.assignedTo.id}}" alt="{{issue.assignedTo.name}}" title="{{issue.assignedTo.name}}"></div>
                    </div>
                    
                    {{#if issue.isSaving}}
                      <div class="item-overlay" {{lock-item}}>
                        <div class="dot-pulse"></div>
                      </div>
                    {{/if}}

                  </div>
                {{/if}}
              {{/each}}
            </AppUi::TaskBoard::IssuesProvider>

          </div>
          
        </div>

      </div>
    {{/each}}
  </div>

</div>