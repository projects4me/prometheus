<div class="gantt-chart">
  <div class="gantt-container">

    {{! Left side - Task list }}
    <div class="gantt-task-list">
      <div class="gantt-header">
        <div class="gantt-header-row">
          <div class="gantt-header-cell task-name">{{t "views.app.gantt.milestone"}}</div>
          <div class="gantt-header-cell task-dates">{{t "views.app.gantt.startEndDate"}}</div>
        </div>
      </div>
      <div class="gantt-tasks" {{initialize-slimscroll width="6"}}>
        {{#each @milestones as |milestone|}}
          <AppUi::GanttChart::GanttRow
            @milestone={{milestone}}
            @isExpanded={{call (fn this.isMilestoneExpanded milestone.id)}}
            @onToggle={{this.toggleMilestone}}
            @onIssueClick={{this.handleIssueClick}}
            @onOpenIssuePanel={{this.handleOpenIssuePanel}}
            @selectedIssue={{@selectedIssue}}
            @isIssuePanelOpen={{@isIssuePanelOpen}}
            @timelineStart={{@timelineStart}}
            @timelineEnd={{@timelineEnd}}
            @dayWidth={{this.dayWidth}}
          />
        {{/each}}
      </div>
    </div>

    {{! Right side - Timeline }}
    <div class="gantt-timeline-wrapper {{if @isIssuePanelOpen 'gantt-timeline-hidden'}}">
      <div class="nav-tabs-custom gantt-time-scale-selector">
        <ul class="nav nav-tabs gantt-time-scale-tabs">
          <li class="gantt-time-scale-tab {{if (eq this.timeScale 'days') 'active' ''}}">
            <a href="#gantt-scale-days" data-toggle="tab" aria-expanded={{if (eq this.timeScale 'days') "true" "false"}} {{on "click" (fn this.setTimeScale "days")}}>
              Days
            </a>
          </li>
          <li class="gantt-time-scale-tab {{if (eq this.timeScale 'weeks') 'active' ''}}">
            <a href="#gantt-scale-weeks" data-toggle="tab" aria-expanded={{if (eq this.timeScale 'weeks') "true" "false"}} {{on "click" (fn this.setTimeScale "weeks")}}>
              Weeks
            </a>
          </li>
        </ul>
      </div>
      <div class="gantt-timeline-container" 
        {{did-insert this.registerTimelineContainer}} 
        {{did-update this.hideScaleConversionOverlay this.timelineWidth}}
        {{will-destroy this.unregisterTimelineContainer}}>
      {{! Scale conversion overlay }}
      {{#if this.showScaleConversionOverlay}}
        <AppUi::Loader @message={{this.conversionMessage}} @variant="overlay" />
      {{/if}}
      <AppUi::GanttChart::TimelineHeader
        @dateRange={{this.dateRange}}
        @monthGroups={{this.monthGroups}}
        @weekGroups={{this.weekGroups}}
        @yearGroups={{this.yearGroups}}
        @dayWidth={{this.dayWidth}}
        @timeScale={{this.timeScale}}
      />
      <div class="gantt-timeline-body" {{did-insert this.registerTimelineBody}} {{did-update this.updateTimelineBodyWidth this.timelineWidth}} {{will-destroy this.unregisterTimelineBody}}>
        <svg
          class="gantt-grid-overlay"
          {{did-insert this.applyGridOverlayStyle}}
          {{did-update this.applyGridOverlayStyle this.timelineWidth}}
          width={{this.timelineWidth}}
          height="100%"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id={{this.gridPatternId}}
              width={{this.gridPatternWidth}}
              height={{this.rowHeight}}
              patternUnits="userSpaceOnUse"
            >
              <path d={{this.gridVerticalPath}} class="grid-line-vertical" vector-effect="non-scaling-stroke" />
              <path d={{this.gridHorizontalPath}} class="grid-line-horizontal" vector-effect="non-scaling-stroke" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={{concat "url(#" this.gridPatternId ")"}} />
        </svg>
        <div 
          class="gantt-weekend-overlay"
          {{did-insert this.applyWeekendOverlayStyle}}
          {{did-update this.applyWeekendOverlayStyle this.timelineWidth}}
        >
          {{#each this.weekendHighlights as |highlight|}}
            <div
              class="weekend-block"
              {{did-insert (fn this.applyWeekendBlockStyle highlight)}}
              {{did-update (fn this.applyWeekendBlockStyle highlight) this.timelineWidth}}
            ></div>
          {{/each}}
        </div>
        <AppUi::GanttChart::DependencyLayer
          @dependencies={{this.dependencies}}
          @barRegistry={{this.barRegistry}}
          @registryVersion={{this.barRegistryVersion}}
          @timelineBodyElement={{this.timelineBodyElement}}
          @linkingState={{this.linkingState}}
          @getDragOffset={{this.getDragOffset}}
          @onDeleteDependency={{this.handleDeleteDependency}}
          @onCancelDependencyLink={{this.cancelDependencyLink}}
        />
        {{#each @milestones as |milestone|}}
          <AppUi::GanttChart::GanttRow
            @milestone={{milestone}}
            @isExpanded={{call (fn this.isMilestoneExpanded milestone.id)}}
            @onToggle={{this.toggleMilestone}}
            @onIssueClick={{this.handleIssueClick}}
            @onOpenIssuePanel={{this.handleOpenIssuePanel}}
            @selectedIssue={{@selectedIssue}}
            @isIssuePanelOpen={{@isIssuePanelOpen}}
            @onIssueDragStart={{this.handleIssueDragStart}}
            @onIssueDragUpdate={{this.handleIssueDragUpdate}}
            @onIssueDragEnd={{this.handleIssueDragEnd}}
            @onIssueResizeStart={{this.handleIssueResizeStart}}
            @onIssueResizeUpdate={{this.handleIssueResizeUpdate}}
            @onIssueResizeEnd={{this.handleIssueResizeEnd}}
            @timelineStart={{@timelineStart}}
            @timelineEnd={{@timelineEnd}}
            @dayWidth={{this.dayWidth}}
            @showBars={{true}}
            @registerBar={{this.registerIssueBar}}
            @unregisterBar={{this.unregisterIssueBar}}
            @onStartDependencyLink={{this.startDependencyLink}}
            @onCompleteDependencyLink={{this.completeDependencyLink}}
            @isLinking={{this.isLinking}}
            @linkingState={{this.linkingState}}
            @updateDependencyPositions={{this.updateBarRegisteryVersion}}
            @timelineContainer={{this.timelineContainerElement}}
            @onCheckAutoScroll={{this.checkAndStartAutoScrollForBar}}
            @onStopAutoScroll={{this.stopAutoScroll}}
            @timelineWidth={{this.timelineWidth}}
          />
        {{/each}}
      </div>
      </div>
    </div>
    
    {{! Issue Details Panel - shown when issue is opened }}
    <AppUi::GanttChart::IssueDetailsPanel
      @isOpen={{@isIssuePanelOpen}}
      @issue={{@panelIssue}}
      @onClose={{@onCloseIssuePanel}}
      @selectStatic={{@selectStatic}}
      @projectController={{@projectController}}
      @issueTypes={{@issueTypes}}
    />
  </div>
</div>
