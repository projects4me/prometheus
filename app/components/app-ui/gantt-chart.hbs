<div class="gantt-chart box box-primary" style={{this.rootStyle}}>
  {{#if (has-block "search")}}
    <div class="gantt-search" data-gantt-search>
      {{yield to="search"}}
    </div>
  {{/if}}
  {{#if this.viewport.isPhone}}
    <div class="nav-tabs-custom gantt-phone-tabs" data-test-gantt-phone-tabs>
      <ul class="nav nav-tabs">
        <li class={{if (eq this.phoneTab "list") "active"}}>
          <a href="#gantt-tab-list" data-test-gantt-tab="list" {{on "click" (fn this.setPhoneTab "list")}}>{{t "components.gantt.tabs.list"}}</a>
        </li>
        <li class={{if (eq this.phoneTab "timeline") "active"}}>
          <a href="#gantt-tab-timeline" data-test-gantt-tab="timeline" {{on "click" (fn this.setPhoneTab "timeline")}}>{{t "components.gantt.tabs.timeline"}}</a>
        </li>
      </ul>
    </div>
  {{/if}}
  {{#if (or (not this.viewport.isPhone) (eq this.phoneTab "timeline"))}}
    <div class="gantt-toolbar" data-test-gantt-toolbar>
      <div class="btn-group btn-group-sm" data-test-gantt-scale>
        {{#each this.scales as |scale|}}
          <button type="button" class="btn {{if (eq this.timeScale scale) 'btn-primary' 'btn-default'}}" data-test-gantt-scale-button={{scale}} {{on "click" (fn this.setTimeScale scale)}}>{{t (concat "components.gantt.scale." scale)}}</button>
        {{/each}}
      </div>
      <button type="button" class="btn btn-default btn-sm gantt-today-button" data-test-gantt-today {{on "click" this.scrollToToday}}>{{t "components.gantt.toolbar.today"}}</button>
      {{#unless this.viewport.isPhone}}
        <FormFields::FieldCheckbox @label={{t "components.gantt.toolbar.dependencies"}} @checked={{this.showDependencies}} @select={{this.toggleDependencies}} @data-select="gantt-dependencies" />
        <FormFields::FieldCheckbox @label={{t "components.gantt.toolbar.weekends"}} @checked={{this.showWeekends}} @select={{this.toggleWeekends}} @data-select="gantt-weekends" />
        <div class="gantt-legend" data-test-gantt-legend>
          {{#each this.legendStatuses as |status|}}
            <span class="label gantt-legend-status" style={{status-style status.name}} data-test-gantt-legend-status>{{status-label status.name}}</span>
          {{/each}}
        </div>
      {{/unless}}
    </div>
  {{/if}}
  <div class="gantt-container {{if this.viewport.isPhone (concat 'gantt-phone gantt-phone-' this.phoneTab)}}">

    {{! Phones - the List tab's issue list }}
    {{#if this.viewport.isPhone}}
      <div class="gantt-list-column">
        <AppUi::GanttChart::IssueList
          @milestones={{@milestones}}
          @activeId={{@selectedIssue.id}}
          @onSelect={{this.handleListSelect}}
          @onOpen={{this.handleOpenIssuePanel}}
        />
      </div>
    {{/if}}

    {{! The grid (desktop) and the timeline, row for row in one scroll container }}
    <div class="gantt-timeline-wrapper {{if (and @isIssuePanelOpen (not this.viewport.isPhone)) 'gantt-panel-open'}}">
      <div class="gantt-timeline-container"
        {{did-insert this.registerTimelineContainer}}
        {{will-destroy this.unregisterTimelineContainer}}>
      <div class="gantt-scroll-header">
        {{#unless this.viewport.isPhone}}
          <div class="gantt-grid-header" data-test-gantt-grid-header>
            <div class="gantt-grid-cell gantt-grid-name">{{t "components.gantt.grid.name"}}</div>
            <div class="gantt-grid-cell gantt-grid-who">{{t "components.gantt.grid.who"}}</div>
            <div class="gantt-grid-cell gantt-grid-date">{{t "components.gantt.grid.start"}}</div>
            <div class="gantt-grid-cell gantt-grid-date">{{t "components.gantt.grid.end"}}</div>
          </div>
        {{/unless}}
        <div class="gantt-timeline-column">
          <AppUi::GanttChart::TimelineHeader
            @dateRange={{this.dateRange}}
            @monthGroups={{this.monthGroups}}
            @weekGroups={{this.weekGroups}}
            @yearGroups={{this.yearGroups}}
            @dayWidth={{this.dayWidth}}
            @timeScale={{this.timeScale}}
          />
        </div>
      </div>
      <div class="gantt-scroll-body">
      {{#unless this.viewport.isPhone}}
        <div class="gantt-grid-column" data-test-gantt-grid
          {{register-element this.registerGridColumn}}>
          {{#each @milestones as |milestone|}}
            <AppUi::GanttChart::GanttRow
              @part="grid"
              @milestone={{milestone}}
              @isExpanded={{call (fn this.isMilestoneExpanded milestone.id)}}
              @onToggle={{this.toggleMilestone}}
              @onIssueClick={{this.handleGridSelect}}
              @onOpenIssuePanel={{this.handleOpenIssuePanel}}
              @selectedIssue={{@selectedIssue}}
            />
          {{/each}}
        </div>
      {{/unless}}
      <div class="gantt-timeline-body gantt-timeline-column" {{did-insert this.registerTimelineBody}} {{will-destroy this.unregisterTimelineBody}}>
        <svg
          class="gantt-grid-overlay"
          width={{this.timelineWidth}}
          height="100%"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id={{this.gridPatternId}}
              x={{this.gridPatternX}}
              width={{this.gridPatternWidth}}
              height={{this.rowHeight}}
              patternUnits="userSpaceOnUse"
              data-test-gantt-grid-pattern
            >
              {{#if this.showWeekends}}
                <rect
                  x={{this.gridWeekendX}}
                  width={{this.gridWeekendWidth}}
                  height={{this.rowHeight}}
                  class="grid-weekend"
                  data-test-gantt-grid-weekend
                />
              {{/if}}
              <path d={{this.gridVerticalPath}} class="grid-line-vertical" vector-effect="non-scaling-stroke" />
              <path d={{this.gridHorizontalPath}} class="grid-line-horizontal" vector-effect="non-scaling-stroke" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={{concat "url(#" this.gridPatternId ")"}} />
        </svg>
        {{#if this.todayLineStyle}}
          <div class="gantt-today-line" style={{this.todayLineStyle}} data-test-gantt-today-line></div>
        {{/if}}
        {{#if this.showDependencies}}
        <AppUi::GanttChart::DependencyLayer
          @dependencies={{this.dependencies}}
          @barRegistry={{this.barRegistry}}
          @registryVersion={{this.dependencyRegistryVersion}}
          @timelineBodyElement={{this.timelineBodyElement}}
          @linkingState={{this.linkingState}}
          @selectedIssueId={{@selectedIssue.id}}
          @rowHeight={{this.rowHeight}}
          @getDragOffset={{this.getDragOffset}}
          @onDeleteDependency={{this.handleDeleteDependency}}
          @onCancelDependencyLink={{this.cancelDependencyLink}}
        />
        {{/if}}
        {{#each @milestones as |milestone|}}
          <AppUi::GanttChart::GanttRow
            @milestone={{milestone}}
            @showLabel={{this.viewport.isPhone}}
            @timeTotals={{@timeTotals}}
            @isExpanded={{call (fn this.isMilestoneExpanded milestone.id)}}
            @onToggle={{this.toggleMilestone}}
            @onIssueClick={{this.handleIssueClick}}
            @onOpenIssuePanel={{this.handleOpenIssuePanel}}
            @selectedIssue={{@selectedIssue}}
            @isIssuePanelOpen={{@isIssuePanelOpen}}
            @onIssueDragStart={{this.handleIssueDragStart}}
            @onIssueDragUpdate={{this.handleIssueDragUpdate}}
            @onIssueDragEnd={{this.handleIssueDragEnd}}
            @onIssueResizeStart={{this.handleIssueResizeStart}}
            @onIssueResizeUpdate={{this.handleIssueResizeUpdate}}
            @onIssueResizeEnd={{this.handleIssueResizeEnd}}
            @timelineStart={{@timelineStart}}
            @timelineEnd={{@timelineEnd}}
            @dayWidth={{this.dayWidth}}
            @registerBar={{this.registerIssueBar}}
            @unregisterBar={{this.unregisterIssueBar}}
            @onStartDependencyLink={{this.startDependencyLink}}
            @onCompleteDependencyLink={{this.completeDependencyLink}}
            @isLinking={{this.isLinking}}
            @linkingState={{this.linkingState}}
            @updateDependencyPositions={{this.updateBarRegisteryVersion}}
            @timelineContainer={{this.timelineContainerElement}}
            @onCheckAutoScroll={{this.checkAndStartAutoScrollForBar}}
            @onStopAutoScroll={{this.stopAutoScroll}}
            @timelineWidth={{this.timelineWidth}}
            @tooltipElement={{this.tooltipElement}}
            @onTooltipIssue={{this.showTooltipIssue}}
          />
        {{/each}}
      </div>
      </div>
      </div>
    </div>

    {{! Issue Details: a bottom sheet on phones, a side panel otherwise }}
    {{#if this.viewport.isPhone}}
      {{#if (and @isIssuePanelOpen @panelIssue)}}
        <AppUi::Modal
          @title="views.app.board.quickView"
          @removeConfirmBtn={{true}}
          @closeLabel="global.form.close"
          @onClose={{@onCloseIssuePanel}}
          @containerClass="gantt-quick-view-modal"
        >
          <Issue::IssueDetails
            @issue={{@panelIssue}}
            @selectStatic={{@selectStatic}}
            @projectController={{@projectController}}
            @issueTypes={{@issueTypes}}
            @quickView={{true}}
            @hideCloseButton={{true}}
            @renderSingleColumn={{false}}
            @closeIssueDetails={{@onCloseIssuePanel}}
          />
        </AppUi::Modal>
      {{/if}}
    {{else}}
      <AppUi::GanttChart::IssueDetailsPanel
        @isOpen={{@isIssuePanelOpen}}
        @issue={{@panelIssue}}
        @onClose={{@onCloseIssuePanel}}
        @selectStatic={{@selectStatic}}
        @projectController={{@projectController}}
        @issueTypes={{@issueTypes}}
      />
    {{/if}}
  </div>
  {{! One tooltip content for every bar; the bar under the pointer or focus fills it }}
  <div hidden>
    <div data-test-gantt-tooltip {{register-element this.registerTooltipElement}}>
      <AppUi::GanttChart::BarTooltip @issue={{this.tooltipIssue}} @timeTotals={{@timeTotals}} />
    </div>
  </div>
</div>
