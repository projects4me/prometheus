{{#if this.isOpen}}
  <div class="gantt-quick-view {{if this.isCollapsed 'gantt-quick-view-collapsed'}}" data-test-gantt-quick-view>
    <button
      class="board-panel-divider"
      type="button"
      title={{if this.isCollapsed (t "components.gantt.quickView.expand") (t "components.gantt.quickView.collapse")}}
      aria-expanded={{if this.isCollapsed "false" "true"}}
      data-test-gantt-quick-view-divider
      {{on "click" this.toggleCollapse}}
    >
      <span class="divider-handle">
        <i class="fa fa-angle-{{if this.isCollapsed 'left' 'right'}}" aria-hidden="true"></i>
      </span>
    </button>
    {{#unless this.isCollapsed}}
      <div
        class="gantt-issue-panel"
        {{on-insert this.registerPanel}}
        {{on-update @issue.id this.handleIssueChange}}
      >
        <Issue::IssueDetails
          @issue={{@issue}}
          @selectStatic={{@selectStatic}}
          @projectController={{@projectController}}
          @issueTypes={{@issueTypes}}
          @quickView={{true}}
          @closeIssueDetails={{this.handleClose}}
        />
      </div>
    {{/unless}}
  </div>
{{/if}}
