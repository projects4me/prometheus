{{#if (eq @part "grid")}}
  {{! Grid side - the issue's cells, level with its timeline row }}
  <div class="gantt-grid-row task-row {{if this.isSelected 'selected'}}" data-issue-id="{{@issue.id}}" data-test-gantt-grid-row>
    {{! Stretched over the row, so a click anywhere on it selects the issue }}
    <button type="button" class="gantt-grid-select" data-test-gantt-grid-select
      aria-label={{concat "#" this.issueNumber " " this.issueSubject}} aria-pressed={{if this.isSelected "true" "false"}}
      {{on "click" this.handleClick}}></button>
    <div class="gantt-grid-cell gantt-grid-name" style={{this.indentStyle}} data-depth={{@depth}}>
      {{#if @hasChildren}}
        <button type="button" class="gantt-issue-toggle" data-test-gantt-issue-toggle
          aria-expanded={{if @isCollapsed "false" "true"}} {{on "click" this.handleToggleChildren}}>
          <i class="fa {{if @isCollapsed "fa-chevron-right" "fa-chevron-down"}}" aria-hidden="true"></i>
        </button>
      {{/if}}
      <span class="gantt-grid-text">{{#if this.conflictText}}<i class="fa fa-ban text-danger gantt-conflict-icon" title={{this.conflictText}} data-test-gantt-conflict-icon aria-hidden="true"></i> {{/if}}<span class="gantt-grid-number">#{{this.issueNumber}}</span> {{this.issueSubject}}</span>
      <button type="button" class="btn btn-box-tool gantt-grid-open" data-test-gantt-grid-open
        aria-label={{t "components.gantt.issueList.open"}} title={{t "components.gantt.issueList.open"}}
        {{on "click" this.handleIssueNumberClick}}><i class="fa fa-eye" aria-hidden="true"></i></button>
    </div>
    <div class="gantt-grid-cell gantt-grid-who" data-test-gantt-grid-who>
      {{#if @issue.assignedTo}}
        <AppUi::Avatar @user={{@issue.assignedTo}} @size="xs" />
      {{/if}}
    </div>
    <div class="gantt-grid-cell gantt-grid-date" data-test-gantt-grid-start>{{if this.hasDates (format-date date=@issue.startDate format="D MMM") "—"}}</div>
    <div class="gantt-grid-cell gantt-grid-date" data-test-gantt-grid-end>{{if this.hasDates (format-date date=@issue.endDate format="D MMM") "—"}}</div>
    <div class="gantt-grid-cell gantt-grid-est" data-test-gantt-grid-est>{{or this.estimateText "—"}}</div>
    <div class="gantt-grid-cell gantt-grid-planned" data-test-gantt-grid-planned><em>{{or this.plannedStartText "—"}}</em></div>
  </div>
{{else}}
  <div class="gantt-timeline-row task-row {{this.statusClass}} {{this.priorityClass}} {{if this.isSelected 'selected'}}" data-issue-id="{{@issue.id}}">
    {{#if this.hasDates}}
    <AppUi::GanttChart::GanttBar
      @startDate={{@issue.startDate}}
      @endDate={{@issue.endDate}}
      @timelineStart={{@timelineStart}}
      @dayWidth={{@dayWidth}}
      @type="task"
      @showLabels={{@showBarLabels}}
      @status={{@issue.status}}
      @onDragStart={{this.handleDragStart}}
      @onDragUpdate={{this.handleDragUpdate}}
      @onDragEnd={{this.handleDragEnd}}
      @onResizeStart={{this.handleResizeStart}}
      @onResizeUpdate={{this.handleResizeUpdate}}
      @onResizeEnd={{this.handleResizeEnd}}
      @onSelect={{this.handleClick}}
      @onOpen={{this.handleIssueNumberClick}}
      @showLabel={{true}}
      @label={{concat "#" this.issueNumber}}
      @progress={{this.progress}}
      @issue={{@issue}}
      @isSelected={{this.isSelected}}
      @showConnectors={{true}}
      @isLinking={{@isLinking}}
      @linkingState={{@linkingState}}
      @registerBar={{@registerBar}}
      @unregisterBar={{@unregisterBar}}
      @onStartDependencyLink={{@onStartDependencyLink}}
      @updateDependencyPositions={{@updateDependencyPositions}}
      @onCompleteDependencyLink={{@onCompleteDependencyLink}}
      @timelineContainer={{@timelineContainer}}
      @onCheckAutoScroll={{@onCheckAutoScroll}}
      @onStopAutoScroll={{@onStopAutoScroll}}
      @timelineWidth={{@timelineWidth}}
      @tooltipElement={{@tooltipElement}}
      @onTooltipIssue={{@onTooltipIssue}}
    />
    {{#if this.conflictText}}
      <span class="label label-danger gantt-conflict-flag" style={{this.conflictStyle}} data-test-gantt-conflict-flag><i class="fa fa-ban" aria-hidden="true"></i> {{this.conflictText}}</span>
    {{/if}}
    {{#if this.edgeChip}}
      <button type="button" class="gantt-edge-chip gantt-edge-chip-{{this.edgeChip}}" style={{this.edgeChipStyle}} data-test-gantt-edge-chip={{this.edgeChip}}
        {{on "click" this.handleChipSelect}}>
        {{#if (eq this.edgeChip "left")}}<i class="fa fa-angle-left" aria-hidden="true"></i>{{/if}}
        {{this.edgeChipDate}}
        {{#if (eq this.edgeChip "right")}}<i class="fa fa-angle-right" aria-hidden="true"></i>{{/if}}
      </button>
    {{/if}}
    {{else}}
      <span class="text-muted gantt-no-dates" data-test-gantt-no-dates>{{t "components.gantt.grid.noDates"}}</span>
    {{/if}}
  </div>
{{/if}}
