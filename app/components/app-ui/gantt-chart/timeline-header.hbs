<div class="gantt-timeline-header" data-test-gantt-timeline-header>
  <div class="gantt-header-row top-row" data-test-gantt-header-top>
    {{#each this.topGroups as |group|}}
      <div
        class="gantt-header-cell {{this.topCellClass}}"
        style={{call (fn this.spanStyle group)}}
        data-test-gantt-header-top-cell
      >
        {{group.label}}
      </div>
    {{/each}}
  </div>

  <div class="gantt-header-row bottom-row" data-test-gantt-header-bottom>
    {{#if this.isHours}}
      {{#each this.hourCells as |cell|}}
        <div class="gantt-header-cell hour-cell {{if cell.isDayStart 'day-start'}}" data-test-gantt-header-hour={{cell.date}}>{{cell.label}}</div>
      {{/each}}
    {{else if this.isDays}}
      {{#each this.dateRangeWithFlags as |date|}}
        <div
          class="gantt-header-cell day-cell {{if date.isFirstOfMonth 'first-of-month'}} {{if date.isCurrentWeek 'current-week'}} {{if date.isCurrentWeekFirst 'current-week-first'}} {{if date.isCurrentWeekLast 'current-week-last'}} {{if date.isToday 'current-day'}}"
          title="{{date.dayOfWeek}}, {{date.month}} {{date.day}}, {{date.year}}"
        >
          {{date.weekdayInitial}} {{date.dayNumber}}
        </div>
      {{/each}}
    {{else if this.isWeeks}}
      {{#each @weekGroups as |weekGroup|}}
        <div
          class="gantt-header-cell week-cell"
          style={{call (fn this.spanStyle weekGroup)}}
        >
          {{weekGroup.label}}
        </div>
      {{/each}}
    {{else}}
      {{#each @monthGroups as |monthGroup|}}
        <div
          class="gantt-header-cell month-cell"
          style={{call (fn this.spanStyle monthGroup)}}
        >
          {{monthGroup.month}}
        </div>
      {{/each}}
    {{/if}}
  </div>
</div>
