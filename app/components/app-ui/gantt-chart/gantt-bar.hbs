<div 
  class="{{this.effectiveBarClass}} {{if this.shouldShowConnectors 'show-connectors'}} {{if @isSelected 'selected'}}" 
  style={{this.positionStyle}}
  {{on "mousedown" this.handleMouseDown}}
  {{on "mousemove" this.handleBarMouseMove}}
  {{on "click" this.handleClick}}
  {{on "keydown" this.handleKeyDown}}
  {{on "mouseenter" this.handleMouseEnter}}
  {{on "focus" this.handleFocus}}
  {{on "mouseleave" this.handleMouseLeave}}
  {{did-insert this.registerElement}}
  {{will-destroy this.unregisterElement}}
  data-issue-id="{{@issue.id}}"
  role="group"
  tabindex={{if this.isKeyboardOperable "0" "-1"}}
  aria-label={{this.accessibleLabel}}
  aria-describedby={{if this.isKeyboardOperable (concat "gantt-bar-hint-" @issue.id)}}
  data-test-gantt-bar
  {{initialize-tooltip contentElement=@tooltipElement interactive=true theme="gantt-issue-tooltip"}}
>
  {{#if this.hasProgress}}
    <span class="gantt-bar-fill" style={{this.progressStyle}} data-test-gantt-bar-fill></span>
  {{/if}}
  {{#if (and (eq @type "task") @issue)}}
    {{#if @isSelected}}
      <span class="gantt-bar-resize-handle gantt-bar-resize-handle-start" data-test-gantt-resize-handle="start" aria-hidden="true"></span>
      <span class="gantt-bar-resize-handle gantt-bar-resize-handle-end" data-test-gantt-resize-handle="end" aria-hidden="true"></span>
    {{/if}}
    <div class="gantt-bar-hover-zones">
      <div 
        class="hover-zone hover-zone-left"
        {{on "mouseenter" this.handleHoverZoneEnter}}
      >
        {{#if this.shouldShowConnectors}}
          <button
            type="button"
            class="connector-dot connector-dot-start"
            data-connector="start"
            aria-label="Dependency start connector"
            {{on "click" (fn this.handleConnectorClick "start")}}
          ></button>
        {{/if}}
      </div>
      <div 
        class="hover-zone hover-zone-right"
        {{on "mouseenter" this.handleHoverZoneEnter}}
      >
        {{#if this.shouldShowConnectors}}
          <button
            type="button"
            class="connector-dot connector-dot-end"
            data-connector="end"
            aria-label="Dependency end connector"
            {{on "click" (fn this.handleConnectorClick "end")}}
          ></button>
        {{/if}}
      </div>
    </div>
    {{#if this.viewport.isPhone}}
      <span class="assignee-avatar">
        <AppUi::Avatar @user={{@issue.assignedTo}} @size="s" {{initialize-tooltip content=@issue.assignedTo.name placement="right"}} />
      </span>
    {{/if}}
  {{/if}}
  {{#if this.showInnerLabel}}
    {{! Inside a task bar, pinned to the visible part of the bar: the issue number and subject }}
    <span class="bar-label-clip" aria-hidden="true">
      <span class="bar-label bar-label-inner {{if this.isCompleted 'completed'}}" data-test-gantt-bar-label>{{this.innerLabel}}</span>
    </span>
  {{else if this.showAfterLabel}}
    {{! After the bar: the milestone's "name · %" }}
    <span class="bar-label {{if this.isCompleted 'completed'}}" data-test-gantt-bar-label>{{this.displayLabel}}</span>
  {{/if}}
  {{#if this.isKeyboardOperable}}
    <span id="gantt-bar-hint-{{@issue.id}}" class="sr-only">{{t 'views.app.gantt.bar.keyboardHint'}}</span>
  {{/if}}
</div>
