<div 
  class="{{this.effectiveBarClass}} {{if this.shouldShowConnectors 'show-connectors'}}" 
  {{did-insert this.applyBarStyle}}
  {{did-update this.applyBarStyle this.barLeft this.barWidth this.dragOffset this.isDragging this.isResizing this.resizeOffset}}
  {{on "mousedown" this.handleMouseDown}}
  {{on "mousemove" this.handleBarMouseMove}}
  {{on "click" this.handleClick}}
  {{on "mouseenter" this.handleMouseEnter}}
  {{on "mouseleave" this.handleMouseLeave}}
  {{did-insert this.registerElement}}
  {{will-destroy this.unregisterElement}}
  data-issue-id="{{@issue.id}}"
  {{initialize-tooltip templateId=@issue.issueNumber interactive=true theme="gantt-issue-tooltip"}}
>
  {{#if (and (eq @type "task") @issue)}}
    <div class="gantt-bar-hover-zones">
      <div 
        class="hover-zone hover-zone-left"
        {{on "mouseenter" this.handleHoverZoneEnter}}
      >
        {{#if this.shouldShowConnectors}}
          <button
            type="button"
            class="connector-dot connector-dot-start"
            data-connector="start"
            aria-label="Dependency start connector"
            {{on "click" (fn this.handleConnectorClick "start")}}
          ></button>
        {{/if}}
      </div>
      <div 
        class="hover-zone hover-zone-right"
        {{on "mouseenter" this.handleHoverZoneEnter}}
      >
        {{#if this.shouldShowConnectors}}
          <button
            type="button"
            class="connector-dot connector-dot-end"
            data-connector="end"
            aria-label="Dependency end connector"
            {{on "click" (fn this.handleConnectorClick "end")}}
          ></button>
        {{/if}}
      </div>
    </div>
    <span class="assignee-avatar">
      <img src="{{this.apiHost}}/userimage/get/{{@issue.assignedTo.id}}" alt="{{@issue.assignedTo.name}}" class="img-circle img-sm"
      {{initialize-tooltip content=@issue.assignedTo.name placement="right"}}
      >
    </span>    
  {{/if}}
  {{#if this.showLabel}}
    {{#if (eq @type "milestone")}}
      <div class="milestone-sticky-label">
        <i class="fa fa-caret-up milestone-caret milestone-caret-start"></i>
        <span class="bar-label">{{this.displayLabel}}</span>
      </div>
    {{else}}
      <span class="bar-label {{if this.isCompleted 'completed'}}">{{this.displayLabel}}</span>
    {{/if}}
  {{/if}}
  {{#if (eq @type "milestone")}}
    <i class="fa fa-caret-up milestone-caret milestone-caret-end"></i>
  {{/if}}
</div>

{{!-- Tooltip content for the issue --}}
<div id="tooltip-{{@issue.issueNumber}}" style="display: none;">
  <LinkTo @route="app.project.issue.page" @models={{array (lowercase @issue.projectShortcode) @issue.issueNumber}} class="issue-title">
    #{{@issue.issueNumber}} - {{@issue.subject}}
  </LinkTo>
  <br>
  <ion class="ion-md-stopwatch"></ion>
  <strong>
    {{t 'views.app.gantt.tooltip.estimatedHours'}}:</strong> {{call this.formatTime 'estimated'}}
  <br>
  <ion class="ion-md-stopwatch"></ion>
  <strong>
    {{t 'views.app.gantt.tooltip.spentHours'}}:</strong> {{call this.formatTime 'spent'}}
  <br>
  <strong>{{t 'views.app.gantt.tooltip.modifiedBy'}}:</strong> {{@issue.modifiedBy.name}}
  {{t 'views.app.gantt.tooltip.at'}} {{format-date-time date=@issue.dateModified}}
</div>