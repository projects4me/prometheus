{{#if @showBars}}
  {{! Timeline side - Show bars }}
  <div class="gantt-timeline-row milestone-row" data-milestone-id="{{this.milestoneId}}">
    {{#if this.hasValidDates}}
      <AppUi::GanttChart::GanttBar
        @startDate={{this.milestoneBarStartDate}}
        @endDate={{this.milestoneBarEndDate}}
        @timelineStart={{@timelineStart}}
        @dayWidth={{@dayWidth}}
        @type="milestone"
        @label={{this.milestoneName}}
      />
    {{/if}}
  </div>

  {{#if @isExpanded}}
    {{#each this.validIssues as |issue|}}
      <AppUi::GanttChart::TaskRow
        @issue={{issue}}
        @timelineStart={{@timelineStart}}
        @dayWidth={{@dayWidth}}
        @onIssueClick={{@onIssueClick}}
        @onOpenIssuePanel={{@onOpenIssuePanel}}
        @selectedIssue={{@selectedIssue}}
        @isIssuePanelOpen={{@isIssuePanelOpen}}
        @onIssueDragStart={{@onIssueDragStart}}
        @onIssueDragUpdate={{@onIssueDragUpdate}}
        @onIssueDragEnd={{@onIssueDragEnd}}
        @onIssueResizeStart={{@onIssueResizeStart}}
        @onIssueResizeUpdate={{@onIssueResizeUpdate}}
        @onIssueResizeEnd={{@onIssueResizeEnd}}
        @showBars={{true}}
        @registerBar={{@registerBar}}
        @unregisterBar={{@unregisterBar}}
        @onStartDependencyLink={{@onStartDependencyLink}}
        @onCompleteDependencyLink={{@onCompleteDependencyLink}}
        @isLinking={{@isLinking}}
        @linkingState={{@linkingState}}
        @updateDependencyPositions={{@updateDependencyPositions}}
        @timelineContainer={{@timelineContainer}}
        @onCheckAutoScroll={{@onCheckAutoScroll}}
        @onStopAutoScroll={{@onStopAutoScroll}}
        @timelineWidth={{@timelineWidth}}
      />
    {{/each}}
  {{/if}}
{{else}}
  {{! Task list side - Show names and dates }}
  <div class="gantt-task-row milestone-row" data-milestone-id="{{this.milestoneId}}">
    <div class="task-info" {{on "click" this.toggleMilestone}} {{on "keydown" this.handleKeyDown}} role="button" tabindex="0">
      <div class="task-name">
        <span class="toggle-icon">
          {{#if @isExpanded}}
            <i class="fa fa-chevron-down"></i>
          {{else}}
            <i class="fa fa-chevron-right"></i>
          {{/if}}
        </span>
        <strong>{{this.milestoneName}}</strong>
        {{#if this.totalIssuesCount}}
          <span class="issue-count">({{this.completedIssuesCount}}/{{this.totalIssuesCount}})</span>
        {{/if}}
      </div>
      <div class="task-dates">
        {{this.dateRange}}
      </div>
    </div>
  </div>

  {{#if @isExpanded}}
    {{#each this.validIssues as |issue|}}
      <AppUi::GanttChart::TaskRow
        @issue={{issue}}
        @timelineStart={{@timelineStart}}
        @dayWidth={{@dayWidth}}
        @onIssueClick={{@onIssueClick}}
        @onOpenIssuePanel={{@onOpenIssuePanel}}
        @selectedIssue={{@selectedIssue}}
        @isIssuePanelOpen={{@isIssuePanelOpen}}
        @showBars={{false}}
        @timelineWidth={{@timelineWidth}}
      />
    {{/each}}
  {{/if}}
{{/if}}
