{{!--
  AppUi::Select is the only component that renders ember-power-select. Everything else (the FormFields
  relate and multi-select fields, the header search and the sidebar project switcher) goes through it.
  Its API is deliberately small: add an argument here when a caller needs it, do not pass every
  PowerSelect argument through. Inside an open dialog the list is drawn in the dialog (select.js).
  See public/ui-docs/select.md.
--}}
<PowerSelect
  @multiple={{@multiple}}
  @options={{@options}}
  @selected={{@selected}}
  @onChange={{@onChange}}
  @search={{@search}}
  @searchEnabled={{@searchEnabled}}
  @searchField={{@searchField}}
  @matcher={{@matcher}}
  @placeholder={{@placeholder}}
  @noMatchesMessage={{@noMatchesMessage}}
  @allowClear={{@allowClear}}
  @disabled={{@disabled}}
  @initiallyOpened={{@initiallyOpened}}
  @closeOnSelect={{@closeOnSelect}}
  @renderInPlace={{@renderInPlace}}
  @dropdownClass={{@dropdownClass}}
  @onOpen={{this.handleOpen}}
  @destinationElement={{this.dialog}}
  @calculatePosition={{this.calculatePosition}}
  @onClose={{@onClose}}
  @onFocus={{@onFocus}}
  @onBlur={{@onBlur}}
  @onKeydown={{@onKeydown}}
  @onInput={{@onInput}}
  @afterOptionsComponent={{@afterOptionsComponent}}
  ...attributes
  as |option select|
>
  {{yield option select}}
</PowerSelect>
