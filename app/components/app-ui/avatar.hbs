<span class="app-ui-avatar app-ui-avatar-{{this.size}} {{if this.isAgent "app-ui-avatar-agent"}}" title={{this.title}} data-test-avatar data-size={{this.size}} ...attributes>
  {{#if this.isAgent}}
    <Agent::Avatar @user={{@user}} data-user-agent-avatar />
    {{#if this.hasPicture}}
      <span class="app-ui-avatar-marker" data-test-avatar-marker><i class="fa fa-android" aria-hidden="true"></i></span>
    {{/if}}
  {{else if this.showInitials}}
    <span class="app-ui-avatar-initials {{this.identityClass}}" data-test-avatar-initials>
      <span class={{this.patternClass}} data-test-avatar-pattern></span>
      {{#if this.initials}}
        <span class="app-ui-avatar-text" data-test-avatar-text>{{this.initials}}</span>
      {{else}}
        <i class="fa fa-user" aria-hidden="true" data-test-avatar-icon></i>
      {{/if}}
    </span>
  {{else}}
    <img class="img-circle" src={{this.imageUrl}} alt={{this.title}} data-test-avatar-image data-image-url={{this.imageUrl}} {{on "error" this.onError}}>
  {{/if}}
</span>
