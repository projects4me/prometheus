<div class="app-tabs" ...attributes>
  <ul class="nav nav-tabs" role="tablist">
    {{yield (hash tab=(component "app-ui/tabs/tab" active=@active onSelect=@onChange) pane=(component "app-ui/tabs/pane" active=@active)) to="tabs"}}
  </ul>
  <div class="tab-content">
    {{yield (hash tab=(component "app-ui/tabs/tab" active=@active onSelect=@onChange) pane=(component "app-ui/tabs/pane" active=@active)) to="panes"}}
  </div>
</div>
