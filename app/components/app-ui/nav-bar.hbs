
{{!-- Sidebar user panel (optional) --}}
<div class="user-panel" {{initialize-sidebar}} {{close-sidebar-on-navigate this.router}}>
  <div class="pull-left image">
    <AppUi::Avatar @user={{this.currentUser.user}} @size="m" />
  </div>
  <div class="pull-left info">
    <p id="user-name">{{this.currentUser.user.name}}</p>
    {{!-- Status --}}
    <a href="#"><i class="fa fa-circle text-success"></i>{{t "views.app.online"}}</a>
  </div>
</div>

{{!-- Sidebar Menu --}}
<ul class="sidebar-menu">
  <li class="header">{{t "views.nav.mainnav"}}</li>
  <AppUi::NavbarItems
    @meta={{this.workspaceNavigationMeta}}
    @appPrefix={{this.appPrefix}}
    @navigate={{this.navigate}}
    @trackedProject={{this.trackedProject}}
  />

  <li class="nav-divider" role="separator"></li>
  <li class="header" data-navigation-group="project">
    <span>{{t "views.nav.project"}}</span>
    {{#if this.trackedProject.shortCode}}
      <span class="nav-project-code">{{this.trackedProject.shortCode}}</span>
    {{else}}
      <span class="nav-project-code nav-project-none">{{t "views.nav.projectSwitcher.placeholder"}}</span>
    {{/if}}
  </li>
  <AppUi::NavbarItems
    @meta={{this.projectNavigationMeta}}
    @appPrefix={{this.appPrefix}}
    @navigate={{this.navigate}}
    @trackedProject={{this.trackedProject}}
    @disabled={{not this.trackedProject.shortCode}}
  />

  <li class="nav-divider" role="separator"></li>
  <li class="header">{{t "views.app.components.navBar.admin"}}</li>
  <AppUi::NavbarItems
    @meta={{this.adminNavigationMeta}}
    @appPrefix={{this.appPrefix}}
    @navigate={{this.navigate}}
    @trackedProject={{this.trackedProject}}
  />

</ul>
{{!-- /.sidebar-menu --}}