<div id={{this.editorId}} class="toast-ui-editor" {{initialize-toastui usersList=@usersList issueSearch=@issueSearch
    translatedEmojis=this.translatedEmojis onContentChange=@onContentChange onBlur=@onBlur editType=this.editType
    hide=this.hide placeholder=@placeholder value=@value onKeyboardSubmit=@onKeyboardSubmit output=@output clearEvent=@clearEvent onImage=@onImage}} ...attributes>
</div>

{{#if (and @message)}}
  <span class="error text-red" id={{@data-field}}>
    {{@message}}
  </span>
{{/if}}