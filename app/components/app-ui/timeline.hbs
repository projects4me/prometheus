{{#if (gt this.activitiesCount 0)}}

  <ul class="timeline">
    {{!

    The timeline supports the following use cases

    01. Project created
    02. Project updated
    03. Project closed
    04. Project completed
    05. Related created
    06. Related updated
    07. Related overdue
    08. Related attached
    09. Related completed
    // Others to be added here
  }}
    {{#each-in this.activitiesList as |key activityArray|}}
      {{! Group the time label }}
      <li class="time-label">
        <span class="bg-primary">
          {{yield key activityArray}}
        </span>
      </li>

      {{#each activityArray as |activity|}}
        <AppUi::ActivityBlock @activity={{activity}} />
      {{/each}}

    {{/each-in}}

    <li>
      <i class="fa fa-clock-o bg-gray"></i>
    </li>
  </ul>
{{else}}
  <Exceptions::NothingFound
    @description={{t "views.app.components.timeline.noActivitiesFound"}}
  />
{{/if}}