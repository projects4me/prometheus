<li class={{if this.isActive "active"}} role="presentation">
  <a href="#" role="tab" aria-selected={{if this.isActive "true" "false"}} {{on "click" this.select}} ...attributes>
    {{yield}}
    {{#if this.hasCount}}
      <span class="label label-default milestone-tab-count" data-tab-count>{{@count}}</span>
    {{/if}}
  </a>
</li>
