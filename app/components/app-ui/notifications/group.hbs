<li data-notification-group={{@group.key}} class="notification-group">
	<h5 class="notification-group-heading" data-notification-group-heading>
		<a href={{this.issueUrl}} data-notification-group-link {{on "click" this.goToIssue}}>
			<i class="fa fa-ticket"></i>
			<span data-notification-group-key>{{@group.shortcode}}-{{@group.issueNumber}}</span>
		</a>
	</h5>
	<ul class="notifications-list" data-notification-group-items>
		{{#each @group.notifications as |notification|}}
			<AppUi::Notifications::Notification @notification={{notification}} />
		{{/each}}
	</ul>
</li>
