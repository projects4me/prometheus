<div class="board-container" {{initialize-sortable group=@group scroll=@scroll scrollSensitivity=@scrollSensitivity scrollSpeed=@scrollSpeed sort=@sort forceFallback=@forceFallback disableSortable=@disableSortable animationSpeed=@animationSpeed dragClass=@dragClass chosenClass=@chosenClass updateIssue=@updateIssue query=this.query}}>
  <div class="nav-tabs-custom">
    <ul class="nav nav-tabs milestone-tabs">
      {{#each @milestones as |milestone index|}}
        <li class="milestone-tab {{if (eq index 0) "active" ""}} not-draggable" data-milestone-tab data-milestone-id={{if milestone.id milestone.id "backlog"}}>
          <a href="#tab_{{if milestone.id milestone.id "backlog"}}" data-toggle="tab" aria-expanded={{if (eq index 0) "true" "false"}}>
            {{t (concat "views.app.milestone.lists.type." milestone.milestoneType)}} {{milestone.name}}
          </a>
          <div class="drop-zone-area">
          </div>
        </li>
      {{/each}}
    </ul>
    <span class="milestone-filters">
      <div class="box-tools pull-right filters">
        <Input
          @value={{this.query}}
          data-milestones-taskboard-search
          name="query"
          autocomplete="off"
          placeholder={{concat (t "global.form.search") " " (t "global.module.plural.issue") " .."}}
        />
      </div>
    </span>
    <div class="tab-content">
      {{#each @milestones as |milestone index|}}
        <div class="tab-pane {{if (eq index 0) "active" ""}}" id="tab_{{if milestone.id milestone.id "backlog"}}">
          <AppUi::TaskBoard::Milestones
            @milestone={{milestone}}
            @group={{@group}}
            @statuses={{@statuses}}
            @statusClass={{@statusClass}}
            @query={{this.query}}
            @openIssue={{@openIssue}}
          />
        </div>
      {{/each}}
    </div>
  </div>
</div>