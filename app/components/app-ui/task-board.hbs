<div class="board-container" {{initialize-sortable group=@group scroll=@scroll scrollSensitivity=@scrollSensitivity scrollSpeed=@scrollSpeed sort=@sort forceFallback=@forceFallback disableSortable=@disableSortable animationSpeed=@animationSpeed dragClass=@dragClass chosenClass=@chosenClass updateIssue=@updateIssue query=this.query paramsQuery=@paramsQuery creatingIssue=this.creatingIssue newMilestoneAdded=this.newMilestoneAdded}}>
  <div class="nav-tabs-custom">
    <ul class="nav nav-tabs milestone-tabs">
      {{#each @milestones as |milestone index|}}
        <li class="milestone-tab {{if (eq index 0) "active" ""}} not-draggable" data-milestone-tab data-milestone-id={{if milestone.id milestone.id "backlog"}}>
          <a href="#tab_{{if milestone.id milestone.id "backlog"}}" data-toggle="tab" aria-expanded={{if (eq index 0) "true" "false"}} {{on "click" (fn this.updateActiveMilestone milestone)}}>
            {{t (concat "views.app.milestone.lists.type." milestone.milestoneType)}} {{milestone.name}}
          </a>
          <div class="drop-zone-area">
          </div>
        </li>
      {{/each}}
      {{!-- Create Milestone Button --}}
      <li class="milestone-tab not-draggable">
        <AppUi::DottedAddButton 
          @onClick={{this.showCreateMilestoneDialog}}
          @title={{t "views.app.board.milestone.create"}}
          @data-add="milestone-create"
          @aclContext="App.Project.Milestone.Create"
        />
      </li>

      {{!-- Mark as complete button, only when active milestone is not backlog --}}
      {{#if (not-eq this.activeMilestone.milestoneType "backlog")}}
        <li class="milestone-close-tab">
          <AppUi::Button
            class="milestone-mark-complete-button"
            @onClick={{this.toggleMarkMilestoneAsComplete}}
            @aclContext="App.Project.Milestone.Update"
            title={{t "views.app.board.milestone.markComplete.confirm"}}
          >
            <i class="fa fa-check"></i>
            {{t "views.app.board.milestone.markComplete.confirm"}}
          </AppUi::Button>
        </li>
      {{/if}}
    </ul>
    <span class="milestone-filters">
      <div class="box-tools pull-right filters flex-row">
        <AppUi::Dropdown>
          <:button>
            {{t "views.app.board.savedSearches"}}
          </:button>
          <:content>
           {{#each @savedSearches as |search|}}
            <div {{on "click" (fn this.toggleSearch search)}} class="{{if (call (fn this.isSearchActive search)) 'active' ''}}">
              {{search.name}}
              {{#if (call (fn this.isSearchActive search))}}
                <i class="fa fa-check pull-right"></i>
              {{/if}}
            </div>
           {{/each}}
          </:content>
        </AppUi::Dropdown>
        <Input
          @value={{this.query}}
          data-milestones-taskboard-search
          name="query"
          autocomplete="off"
          placeholder={{concat (t "global.form.search") " " (t "global.module.plural.issue") " .."}}
        />
      </div>
    </span>
    <div class="tab-content">
      {{#each @milestones as |milestone index|}}
        <div class="tab-pane {{if (eq index 0) "active" ""}}" id="tab_{{if milestone.id milestone.id "backlog"}}">
          <AppUi::TaskBoard::Milestones
            @milestone={{milestone}}
            @group={{@group}}
            @statuses={{@statuses}}
            @statusClass={{@statusClass}}
            @query={{this.query}}
            @openIssue={{@openIssue}}
            @selectIssue={{this.selectIssue}}
            @validateField={{@validateField}}
            @selectStatic={{@selectStatic}}
            @selectRelated={{@selectRelated}}
            @save={{this.saveIssue}}
            @message={{@message}}
            @issueTypes={{@issueTypes}}
            @membersList={{@membersList}}
            @search={{@search}}
            @getMilestoneProgress={{@getMilestoneProgress}}
            @getCompletedIssuesCount={{@getCompletedIssuesCount}}            
          />
        </div>
      {{/each}}
    </div>
  </div>
</div>

{{!-- Create Milestone Modal --}}
{{#if this.addMilestoneDialog}}
  {{#bootstrap-modal
    title="views.app.board.milestone.create"
    closeLabel="global.form.close"
    confirmLabel="global.form.save"
    close=(action "removeAddMilestoneModal")
    confirm=(action "saveMilestone")
  }}
    <div class="form-group">
      <FormFields::FieldText
        @placeholder={{t "views.app.project.detail.milestone.inputname"}}
        @label={{t "views.app.project.detail.milestone.name"}}
        @type="text"
        @value={{this.newMilestone.name}}
        @data-field="milestone.name"
        @length="255"
        @validate={{action @validateField "milestoneCreate" (hash name="name" value=this.newMilestone.name model=this.newMilestone)}}
        @message={{@message.milestoneCreate.name}}
        @aclContext="App.Project.Milestone.Create.Name"
        {{autofocus}}
      />

      <FormFields::FieldDate
        @placeholder={{t "views.app.project.detail.milestone.inputstartdate"}}
        @label={{t "views.app.project.detail.milestone.startdate"}}
        @value="{{readonly this.newMilestone.startDate}}"
        @update={{action @selectStatic this.newMilestone 'startDate'}}
        @data-field="milestone.startDate"
        @format="YYYY-MM-DD"
        @singleDatePicker={{true}}
        @showDropdowns={{true}}
        @positionX="right"
        @positionY="down"
        @autoApply={{true}}
        @minDate='1990'
        @validate={{action @validateField "milestoneCreate" (hash name="startDate" value=this.newMilestone.startDate model=this.newMilestone)}}                
        @message={{@message.milestoneCreate.startDate}}
        @aclContext="App.Project.Milestone.Create.StartDate"
      />

      <FormFields::FieldDate
        @placeholder={{t "views.app.project.detail.milestone.inputenddate"}}
        @label={{t "views.app.project.detail.milestone.enddate"}}
        @value={{readonly this.newMilestone.endDate}}
        @update={{action @selectStatic this.newMilestone 'endDate'}}
        @data-field="milestone.endDate"
        @format="YYYY-MM-DD"
        @singleDatePicker={{true}}
        @showDropdowns={{true}}
        @positionX="right"
        @positionY="down"
        @autoApply={{true}}
        @minDate='1990'
        @validate={{action @validateField "milestoneCreate" (hash name="endDate" value=this.newMilestone.endDate model=this.newMilestone)}}                
        @message={{@message.milestoneCreate.endDate}}
        @aclContext="App.Project.Milestone.Create.EndDate"
      />

      <FormFields::FieldRelate
        @placeholder={{t "views.app.project.detail.milestone.inputtype"}}
        @label={{t "views.app.project.detail.milestone.type"}}
        @value={{this.newMilestone.milestoneType}}
        @options={{this.milestoneTypes}}
        @selected={{find-by "value" this.newMilestone.milestoneType this.milestoneTypes}}
        @searchField="label"
        @onchange={{action @selectRelated this.newMilestone 'milestoneType'}}
        @relateType="relate-simple"
        @data-field="milestone.type"
        @validate={{action @validateField "milestoneCreate" (hash name="milestoneType" value=this.newMilestone.milestoneType model=this.newMilestone)}}
        @message={{@message.milestoneCreate.milestoneType}}
        @aclContext="App.Project.Milestone.Create.Type"
      />

      <FormFields::FieldRelate
        @placeholder={{t "views.app.project.detail.milestone.inputstatus"}}
        @label={{t "views.app.project.detail.milestone.status"}}
        @value={{this.newMilestone.status}}
        @options={{this.milestoneStatuses}}
        @selected={{find-by "value" this.newMilestone.status this.milestoneStatuses}}
        @searchField="label"
        @onchange={{action @selectRelated this.newMilestone 'status'}}
        @relateType="relate-simple"
        @data-field="milestone.status"
        @validate={{action @validateField "milestoneCreate" (hash name="status" value=this.newMilestone.status model=this.newMilestone)}}
        @message={{@message.milestoneCreate.status}}
        @aclContext="App.Project.Milestone.Create.Status"
      />

      <FormFields::FieldTextArea
        @placeholder={{t "views.app.project.detail.milestone.inputdescription"}}
        @label={{t "views.app.project.detail.milestone.description"}}
        @value={{this.newMilestone.description}}
        @data-field="milestone.description"
        @validate={{action @validateField "milestoneCreate" (hash name="description" value=this.newMilestone.description model=this.newMilestone)}}
        @message={{@message.milestoneCreate.description}}
        @aclContext="App.Project.Milestone.Create.Description"
      />
    </div>
  {{/bootstrap-modal}}
{{/if}}

{{!-- Close Milestone Confirmation Modal --}}
{{#if this.showMarkMilestoneAsCompleteModal}}
  {{#bootstrap-modal
    title="views.app.board.milestone.markComplete.title"
    closeLabel="global.form.cancel"
    confirmLabel="views.app.board.milestone.markComplete.confirm"
    close=(action "cancelMarkMilestoneAsComplete")
    confirm=(action "markMilestoneAsComplete")
    confirmClass="btn-danger"
  }}
    <div class="close-milestone-confirmation">
      <div class="alert alert-warning flex-row flex-ai-c">
        <i class="fa fa-exclamation-triangle"></i>
        <p>{{safe-html (t "views.app.board.milestone.markComplete.message" milestoneName=this.activeMilestone.name)}}</p>
      </div>
      
      <div class="milestone-info">
        <strong>{{t "views.app.board.milestone.markComplete.details"}}</strong>
        <ul>
          <li>{{safe-html (t "views.app.board.milestone.markComplete.totalIssues" count=this.activeMilestone.issues.length)}}</li>
          <li>{{safe-html (t "views.app.board.milestone.markComplete.completedIssues" count=this.completedIssuesCount)}}</li>
          <li>{{safe-html (t "views.app.board.milestone.markComplete.progress" progress=this.milestoneProgress)}}</li>
        </ul>
      </div>
    </div>
  {{/bootstrap-modal}}
{{/if}}
