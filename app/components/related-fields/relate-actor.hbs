<span class="relate-user {{if (eq @data.kind "agent") "relate-agent"}}" data-actor-option={{@data.kind}}>
  {{#if (eq @data.kind "agent")}}
    <AppUi::Avatar @size="xs" @user={{hash id=@data.value name=@data.label type="agent" profilePicture=@data.user.profilePicture}} />
  {{else if (eq @data.kind "user")}}
    <AppUi::Avatar @size="xs" @user={{hash id=@data.value name=@data.label}} />
  {{else}}
    <AppUi::Icon @name="code" />
  {{/if}}
  <span class="username">{{@data.label}}</span>
</span>
