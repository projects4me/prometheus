<div class="user-social-links">

  {{#if this.user.githubUrl}}
    <div data-social-name="github">
      <AppUi::Icon @name="github" @size="lg" />
      <a {{on "click" (fn this.redirect this.user.githubUrl)}}>{{get-username 'github' this.user.githubUrl}}</a>
    </div>
  {{/if}}

  {{#if this.user.gitlabUrl}}
    <div data-social-name="gitlab">
      <AppUi::Icon @name="gitlab" />
      <a {{on "click" (fn this.redirect this.user.gitlabUrl)}}>{{get-username 'gitlab' this.user.gitlabUrl}}</a>
    </div>
  {{/if}}

  {{#if this.user.skypeUrl}}
    <div data-social-name="skype">
      <AppUi::Icon @name="skype" @size="lg" />
      <a {{on "click" (fn this.redirect (concat "skype:" this.user.skypeUrl "?chat"))}} >{{get-username 'skype' this.user.skypeUrl}}</a>
    </div>
  {{/if}}

  {{#if this.user.linkedinUrl}}
    <div data-social-name="linkedin">
      <AppUi::Icon @name="linkedin" @size="lg" />
      <a {{on "click" (fn this.redirect this.user.linkedinUrl)}}>{{get-username 'linkedin' this.user.linkedinUrl}}</a>
    </div>
  {{/if}}

  {{#if this.user.slackUrl}}
    <div data-social-name="slack">
      <AppUi::Icon @name="slack" @size="lg" />
      <a {{on "click" (fn this.redirect (concat "https://slack.com/app_redirect?channel=" this.user.slackUrl))}} >@slack</a>
    </div>
  {{/if}}
  
</div>
