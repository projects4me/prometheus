<div class="recent-activities slim-scroll">
{{#if @activities.length}}

  <ul class="timeline">
    {{#each @activities as |activity|}}
      <AppUi::ActivityBlock
        @activity={{activity}}
      />
    {{/each}}

    <li>
      <AppUi::Icon @name="clock-o" class="bg-gray" />
    </li>

  </ul>

{{else}}
  <Exceptions::NothingFound
    @description={{t "views.app.user.page.recentActivities.noActivity"}}
  />
{{/if}}
</div>