<div class="collaboration-card user-stats-card">
  <div class="shape">
    {{#if (gt this.userCollaboration 50)}}
      <AppUi::Icon @name="caret-up" class="up" />
      {{else}}
        <AppUi::Icon @name="caret-down" class="down" />
    {{/if}}
  </div>
  <div data-user-collaboration="value" class="value">
    {{this.userCollaboration}}%
  </div>
</div>