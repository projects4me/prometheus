{{#let (concat "quick-list-item" (if (has-block "leading") " quick-list-item--with-leading") (if @isActive " quick-list-item--active")) as |classes|}}
  {{#if @route}}
    <LinkTo @route={{@route}} @models={{this.models}} @query={{this.query}} class={{classes}} data-test-quick-list-item ...attributes>
      {{#if (has-block "leading")}}
        <div class="quick-list-item__leading" data-test-quick-list-item-leading>{{yield to="leading"}}</div>
        <div class="quick-list-item__body" data-test-quick-list-item-body>
          <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
          {{#if (has-block "secondary")}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
        </div>
      {{else}}
        <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
        {{#if (has-block "secondary")}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
      {{/if}}
    </LinkTo>
  {{else}}
    <div class={{classes}} data-test-quick-list-item ...attributes>
      {{#if (has-block "leading")}}
        <div class="quick-list-item__leading" data-test-quick-list-item-leading>{{yield to="leading"}}</div>
        <div class="quick-list-item__body" data-test-quick-list-item-body>
          <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
          {{#if (has-block "secondary")}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
        </div>
      {{else}}
        <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
        {{#if (has-block "secondary")}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
      {{/if}}
    </div>
  {{/if}}
{{/let}}
