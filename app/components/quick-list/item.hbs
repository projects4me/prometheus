{{#let (concat "quick-list-item" (if (has-block "leading") " quick-list-item--with-leading") (if (has-block "trailing") " quick-list-item--with-trailing") (if @isActive " quick-list-item--active")) as |classes|}}
  {{#if (has-block "trailing")}}
    {{!-- The trailing block is a sibling of the row element, never inside it: no button inside the
      link, and a click in it never reaches a click handler the host put on the item. --}}
    <div class="quick-list-item-wrap" data-test-quick-list-item-wrap>
      <QuickList::ItemRow @route={{@route}} @models={{this.models}} @query={{this.query}} @classes={{classes}}
        @hasLeading={{has-block "leading"}} @hasSecondary={{has-block "secondary"}} ...attributes>
        <:leading>{{yield to="leading"}}</:leading>
        <:primary>{{yield to="primary"}}</:primary>
        <:secondary>{{yield to="secondary"}}</:secondary>
      </QuickList::ItemRow>
      <div class="quick-list-item__trailing" data-test-quick-list-item-trailing>{{yield to="trailing"}}</div>
    </div>
  {{else}}
    <QuickList::ItemRow @route={{@route}} @models={{this.models}} @query={{this.query}} @classes={{classes}}
      @hasLeading={{has-block "leading"}} @hasSecondary={{has-block "secondary"}} ...attributes>
      <:leading>{{yield to="leading"}}</:leading>
      <:primary>{{yield to="primary"}}</:primary>
      <:secondary>{{yield to="secondary"}}</:secondary>
    </QuickList::ItemRow>
  {{/if}}
{{/let}}
