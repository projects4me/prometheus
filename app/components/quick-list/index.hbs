<div class="box box-primary quick-list" data-test-quick-list {{on-update @items this.itemsChanged}} ...attributes>
  <QuickList::Header @title={{@title}} @count={{this.items.length}} @total={{@total}} @showCount={{this.showCount}}>
    {{yield to="actions"}}
  </QuickList::Header>
  {{yield to="search"}}
  {{#if this.selectedIds.length}}
    <QuickList::SelectionBar @state={{this.selectionState}} @count={{this.selectedIds.length}}
      @onToggleAll={{this.toggleAll}} @onClear={{this.clearSelection}}>
      <:actions>{{yield this.selectedIds this.clearSelection to="selectionActions"}}</:actions>
    </QuickList::SelectionBar>
  {{else if this.showToolbar}}
    <QuickList::Toolbar @groupOptions={{@groupOptions}} @groupBy={{@groupBy}} @onGroup={{@onGroup}}
      @sortOptions={{@sortOptions}} @sort={{@sort}} @order={{@order}} @onSort={{@onSort}}>
      <:start>
        {{#if @selectable}}
          <QuickList::SelectAll @state={{this.selectionState}} @onToggle={{this.toggleAll}} />
        {{/if}}
      </:start>
    </QuickList::Toolbar>
  {{/if}}
  <div class="box-body no-padding quick-list__body">
    {{#if @isLoading}}
      {{#each this.skeletonRows}}
        <div class="quick-list__skeleton" data-test-quick-list-skeleton>
          <span class="skeleton-line skeleton-line--medium"></span>
          <span class="skeleton-line skeleton-line--short"></span>
        </div>
      {{/each}}
    {{else if @error}}
      <p class="quick-list__state quick-list__state--error" data-test-quick-list-error>
        <i class="fa fa-exclamation-triangle"></i>
        {{t "components.quickList.error"}}
        {{#if @onRetry}}
          <button type="button" class="btn btn-link quick-list__state-action" data-test-quick-list-retry {{on "click" @onRetry}}>
            {{t "components.quickList.retry"}}
          </button>
        {{/if}}
      </p>
    {{else if this.isEmpty}}
      {{#if (has-block "empty")}}
        {{yield to="empty"}}
      {{else}}
        <p class="quick-list__state quick-list__state--empty" data-test-quick-list-empty>
          <i class="fa fa-info-circle"></i>
          {{t "components.quickList.empty"}}
          {{#if @onClearSearch}}
            <button type="button" class="btn btn-link quick-list__state-action" data-test-quick-list-clear-search {{on "click" @onClearSearch}}>
              {{t "components.quickList.clearSearch"}}
            </button>
          {{/if}}
        </p>
      {{/if}}
    {{else}}
      <ul class="quick-list__items">
        {{#if this.groups}}
          {{#each this.groups as |entry|}}
            <li class="quick-list__group">
              <QuickList::Group @group={{entry.group}} @collapsed={{entry.collapsed}}
                @onToggle={{fn this.toggleGroup entry.key}}>
                <:heading as |g|>
                  {{#if (has-block "group")}}{{yield g to="group"}}{{else if (eq g.key null)}}{{t "components.quickList.group.none"}}{{else}}{{g.label}}{{/if}}
                </:heading>
                <:default>
                  <ul class="quick-list__items">
                    {{#each entry.rows as |row|}}
                      <QuickList::Row @selectable={{@selectable}} @selected={{row.isSelected}}
                        @onToggle={{fn this.toggleRow row.record}}>
                        {{yield row.record (component "quick-list/item" isActive=row.isActive) to="item"}}
                      </QuickList::Row>
                    {{/each}}
                  </ul>
                </:default>
              </QuickList::Group>
            </li>
          {{/each}}
        {{else}}
          {{#each this.rows as |row|}}
            <QuickList::Row @selectable={{@selectable}} @selected={{row.isSelected}}
              @onToggle={{fn this.toggleRow row.record}}>
              {{yield row.record (component "quick-list/item" isActive=row.isActive) to="item"}}
            </QuickList::Row>
          {{/each}}
        {{/if}}
      </ul>
    {{/if}}
  </div>
  {{#if @onPage}}
    <QuickList::Pagination @page={{@page}} @limit={{@limit}} @total={{@total}} @disabled={{@isLoading}} @onPage={{@onPage}} />
  {{/if}}
  {{yield to="footer"}}
</div>
