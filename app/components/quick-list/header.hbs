{{!--
  The header of a QuickList: the box title with the record count (QuickList::Count: @count, @total, @hasNext,
  @showCount), and the header tools (the default block, the list's <:actions>). @title is already translated.
--}}
<div class="box-header with-border quick-list__header" data-test-quick-list-header>
  <h3 class="box-title">
    {{@title}}
    <QuickList::Count @count={{@count}} @total={{@total}} @hasNext={{@hasNext}} @showCount={{@showCount}} />
  </h3>
  {{#if (has-block)}}
    <div class="box-tools pull-right" data-test-quick-list-actions>
      {{yield}}
    </div>
  {{/if}}
</div>
