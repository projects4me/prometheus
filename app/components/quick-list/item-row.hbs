{{!--
  The row of a QuickList::Item: the link (or the plain div when there is no @route) holding the optional
  leading column and the primary and secondary lines. Internal to QuickList::Item, which renders it on its
  own or inside the trailing wrapper, so the row is written once. @hasLeading and @hasSecondary carry the
  item's has-block checks: a block passed through here always exists.
--}}
{{#if @route}}
  <LinkTo @route={{@route}} @models={{@models}} @query={{@query}} class={{@classes}} data-test-quick-list-item ...attributes>
    {{#if @hasLeading}}
      <div class="quick-list-item__leading" data-test-quick-list-item-leading>{{yield to="leading"}}</div>
      <div class="quick-list-item__body" data-test-quick-list-item-body>
        <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
        {{#if @hasSecondary}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
      </div>
    {{else}}
      <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
      {{#if @hasSecondary}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
    {{/if}}
  </LinkTo>
{{else}}
  <div class={{@classes}} data-test-quick-list-item ...attributes>
    {{#if @hasLeading}}
      <div class="quick-list-item__leading" data-test-quick-list-item-leading>{{yield to="leading"}}</div>
      <div class="quick-list-item__body" data-test-quick-list-item-body>
        <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
        {{#if @hasSecondary}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
      </div>
    {{else}}
      <div class="quick-list-item__primary" data-test-quick-list-item-primary>{{yield to="primary"}}</div>
      {{#if @hasSecondary}}<div class="quick-list-item__secondary" data-test-quick-list-item-secondary>{{yield to="secondary"}}</div>{{/if}}
    {{/if}}
  </div>
{{/if}}
