<AccessControl @aclContext="agentcredential.read">
  <div class="box box-primary agent-credentials" data-agent-box="credentials" {{did-insert this.load}}>
    <div class="box-header with-border">
      <h3 class="box-title">{{t "views.app.agent.credentials.title"}}</h3>
    </div>
    <div class="box-body">
      {{#if this.credential}}
        <small class="text-muted">{{t "views.app.agent.credentials.clientId"}}</small>
        <div><code data-credential-field="client-id">{{this.credential.clientId}}</code></div>
        <small class="text-muted">{{t "views.app.agent.credentials.clientSecret"}}</small>
        <div><code data-credential-field="secret">••••••••••••••••</code></div>
        <p class="text-muted" data-credential-field="meta">
          {{t "views.app.agent.credentials.created" date=(format-date-time date=this.credential.dateCreated humanize=true) user=this.credential.createdUserName}}
          {{#if this.credential.lastUsedAt}}
            · {{t "views.app.agent.credentials.lastUsed" date=(format-date-time date=this.credential.lastUsedAt humanize=true)}}
          {{else}}
            · {{t "views.app.agent.credentials.neverUsed"}}
          {{/if}}
        </p>
        <div class="agent-credentials-actions">
          <AccessControl @aclContext="agentcredential.create">
            <AppUi::Button type="button" class="btn btn-default" data-btn="rotate-secret" @onClick={{this.issue}}>{{t "views.app.agent.credentials.rotate"}}</AppUi::Button>
          </AccessControl>
          <AccessControl @aclContext="agentcredential.delete">
            <AppUi::Button type="button" class="btn btn-default text-red" data-btn="revoke-secret" @onClick={{this.askRevoke}}>{{t "views.app.agent.credentials.revoke"}}</AppUi::Button>
          </AccessControl>
        </div>
      {{else if this.loaded}}
        <p class="text-muted" data-credential-field="none">{{t "views.app.agent.credentials.none"}}</p>
        <AccessControl @aclContext="agentcredential.create">
          <AppUi::Button type="button" class="btn btn-primary" data-btn="issue-secret" @onClick={{this.issue}}>{{t "views.app.agent.credentials.issue"}}</AppUi::Button>
        </AccessControl>
      {{/if}}
    </div>
  </div>
</AccessControl>

{{#if this.issued}}
  <BootstrapModal
    @title="views.app.agent.credentials.newSecretTitle"
    @closeLabel="views.app.agent.credentials.copiedIt"
    @close={{this.closeIssued}}
    @removeConfirmBtn={{true}}
    @containerClass="agent-secret-modal"
  >
    <div class="alert alert-warning" data-credential-field="warning">{{t "views.app.agent.credentials.copyNow"}}</div>
    <label>{{t "views.app.agent.credentials.clientId"}}</label>
    <div class="input-group">
      <input type="text" class="form-control" readonly value={{this.issued.clientId}} data-credential-field="new-client-id">
      <span class="input-group-btn">
        <button type="button" class="btn btn-default" data-btn="copy-client-id" {{on "click" (fn this.copy this.issued.clientId)}}>{{t "views.app.agent.credentials.copy"}}</button>
      </span>
    </div>
    <label>{{t "views.app.agent.credentials.clientSecret"}}</label>
    <div class="input-group">
      <input type="text" class="form-control" readonly value={{this.issued.clientSecret}} data-credential-field="new-secret">
      <span class="input-group-btn">
        <button type="button" class="btn btn-default" data-btn="copy-secret" {{on "click" (fn this.copy this.issued.clientSecret)}}>{{t "views.app.agent.credentials.copy"}}</button>
      </span>
    </div>
    <label>{{t "views.app.agent.credentials.forMachine"}}</label>
    <pre data-credential-field="env"># dev-tools/gaia-mcp/gaia-mcp.env
{{this.envLines}}</pre>
    <small class="text-muted">{{t "views.app.agent.credentials.orConfigure"}}</small>
  </BootstrapModal>
{{/if}}

{{#if this.confirmingRevoke}}
  <BootstrapModal
    @title="views.app.agent.credentials.revokeTitle"
    @closeLabel="global.form.cancel"
    @close={{this.closeRevoke}}
    @confirmLabel="views.app.agent.credentials.revoke"
    @confirm={{this.revoke}}
    @dataSaveBtn="confirm-revoke"
    @containerClass="agent-revoke-modal"
  >
    <p>{{t "views.app.agent.credentials.revokeWarning"}}</p>
  </BootstrapModal>
{{/if}}
