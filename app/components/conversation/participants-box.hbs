{{!-- Who takes part in a thread: its creator, then the people who commented or voted --}}
<div class="box box-success" data-participants-box>
  <div class="box-header with-border">
    <h3 class="box-title">{{t "views.app.conversation.thread.participants"}}</h3>
  </div>
  <div class="box-body">
    <Project::MemberAvatars @members={{@participants}} @maxVisible={{8}} @linkToUser={{true}} />
  </div>
</div>
