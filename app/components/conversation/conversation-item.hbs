<div class="conversation-item" id={{@entity.id}}>
  <div class="box box-widget">
    <div class="box-header with-border">
      <div class="user-block">
        <img class="img-circle" src="{{this.apiHost}}/userimage/get/{{@entity.createdUser}}" alt="{{t "global.form.image"}}">
        <span class="subject"><a href="#">{{@entity.subject}}</a></span>
        <span class="description"><a href="/app/user/{{@entity.createdBy.id}}">{{@entity.createdBy.name}}</a> - {{format-date-time date=@entity.dateModified}}</span>
      </div>
      {{!-- /.user-block --}}
      <div class="box-tools">
        <span class="upvotes">
          {{@entity.votes.length}}
          {{#if @entity.votes}}
            {{#if (user-created @entity.votes @currentUser.user.id)}}
              <i class="fa fa-heart"></i>
            {{else}}
              <i class="fa fa-heart-o"></i>
            {{/if}}
          {{else}}
            <i class="fa fa-heart-o"></i>
          {{/if}}
        </span>
        {{#if this.isOwnConversation}}
          <AppUi::Button 
            type="button" 
            class="btn btn-box-tool" 
            data-btn="edit-conversation"
            @onClick={{this.showEditConversationDialog}}
            data-toggle="tooltip" 
            title="{{t 'global.form.edit'}}"
          >
            <i class="fa fa-pencil"></i>
          </AppUi::Button>
        {{/if}}
        <AppUi::Button type="button" class="btn btn-box-tool" data-widget="collapse">
          <i class="fa fa-minus"></i>
        </AppUi::Button>
      </div>
      {{!-- /.box-tools --}}
    </div>
    {{!-- /.box-header --}}
    <div class="box-body">
      {{!-- post text --}}
      <p>{{translate-comment @entity.description}}</p>
      {{!-- /.attachment-block --}}
      {{!-- Social sharing buttons --}}
      {{#if (user-created @entity.votes @currentUser.user.id)}}
        {{t "views.app.conversation.you"}} <i class="fa fa-heart"></i>
      {{else}}
        <AppUi::Button type="button" class="btn btn-default btn-xs" @onClick={{fn @upvote @entity.id}} @aclContext="App.Project.Conversation.Upvote">
          <i class="fa fa-heart-o"></i> {{t "views.app.conversation.upvote"}}
        </AppUi::Button>
      {{/if}}
      <span class="pull-right text-muted">
        {{@entity.comments.length}}
        {{#if (eq @entity.roomType "discussion")}}
          {{t "views.app.conversation.comments"}}
        {{else}}
          {{t "views.app.conversation.votes"}}
        {{/if}}
      </span>
    </div>
    {{!-- /.box-body --}}
    <div class="box-footer box-comments">
      {{#if (eq @entity.roomType "discussion")}}
        {{#each @entity.comments as |comment|}}
          <ConversationUi::CommentItem 
            @comment={{comment}} 
            @usersList={{@membersList}}
            @issueSearch={{perform @search}}
          />
        {{/each}}
        <div class="box-footer">
          <form action="#" method="post">
            <img class="img-responsive img-circle img-sm" src="{{this.apiHost}}/userimage/get/{{@currentUser.user.id}}" alt="{{@currentUser.user.name}}">
            <div class="img-push">
              <div class="message-box">
                <ConversationUi::MessageBox
                  @usersList={{@membersList}}
                  @issueSearch={{perform @search}}
                  @save={{fn @saveComment}}
                  @entity={{@entity.id}}
                />
              </div>
            </div>
          </form>
        </div>
      {{else if (eq @entity.roomType "vote")}}
        <div class="panel-body">
          <div class="vote">
            <div class="agree">
              <div class="info-box">
                {{#if (user-created @entity.comments @currentUser.user.id)}}
                  <span class="info-box-icon bg-green" data-toggle="tooltip" title="{{t "views.app.conversation.vote.voted"}}"><i class="fa fa-thumbs-up"></i></span>
                {{else}}
                  <a href="javascript:void(0);" {{on "click" (fn @vote "I agree" @entity.id)}}>
                    <span class="info-box-icon bg-green" data-toggle="tooltip" title="{{t "views.app.conversation.vote.clickup"}}"><i class="fa fa-thumbs-o-up"></i></span>
                  </a>
                {{/if}}
                <div class="info-box-content">
                  <span class="info-box-text">{{t "views.app.conversation.vote.upvote"}}</span>
                  <span class="info-box-number">{{count-votes @entity.comments "I agree"}}</span>
                  <div class="progress">
                    <div class="progress-bar bg-green" style={{progress-width (round (mult (div (count-votes @entity.comments "I agree") @entity.comments.length) 100))}}></div>
                  </div>
                  <span class="progress-description">
                    {{#if @entity.comments.length}}
                      {{round (mult (div (count-votes @entity.comments "I agree") @entity.comments.length) 100)}}% {{t "views.app.conversation.vote.agree"}}
                    {{else}}
                      0% {{t "views.app.conversation.vote.agree"}}
                    {{/if}}
                  </span>
                </div>
                {{!-- /.info-box-content --}}
              </div>
            </div>
            <div class="disagree">
              <div class="info-box">
                {{#if (user-created @entity.comments @currentUser.user.id)}}
                  <span class="info-box-icon bg-red pull-right" data-toggle="tooltip" title="{{t "views.app.conversation.vote.voted"}}"><i class="fa fa-thumbs-down"></i></span>
                {{else}}
                  <a href="javascript:void(0);" {{on "click" (fn @vote "I disagree" @entity.id)}}>
                    <span class="info-box-icon bg-red pull-right" data-toggle="tooltip" title="{{t "views.app.conversation.vote.clickdown"}}"><i class="fa fa-thumbs-o-down"></i></span>
                  </a>
                {{/if}}
                <div class="info-box-content">
                  <span class="info-box-text">{{t "views.app.conversation.vote.downvote"}}</span>
                  <span class="info-box-number">{{count-votes @entity.comments "I disagree"}}</span>
                  <div class="progress">
                    <div class="progress-bar bg-red" style={{progress-width (round (mult (div (count-votes @entity.comments "I disagree") @entity.comments.length) 100))}}></div>
                  </div>
                  <span class="progress-description">
                    {{#if @entity.comments.length}}
                      {{round (mult (div (count-votes @entity.comments "I disagree") @entity.comments.length) 100)}}% {{t "views.app.conversation.vote.disagree"}}
                    {{else}}
                      0% {{t "views.app.conversation.vote.disagree"}}
                    {{/if}}
                  </span>
                </div>
                {{!-- /.info-box-content --}}
              </div>
            </div>
          </div>
        </div>
      {{/if}}
    </div>
  </div>

  {{#if this.showEditConversationModal}}
    {{#bootstrap-modal
      title="views.app.conversation.edit.title"
      closeLabel="global.form.cancel"
      confirmLabel="views.app.conversation.edit.update"
      close=(action "removeEditConversationModal")
      confirm=(action "updateConversation")
    }}
      <div class="edit-conversation-form">
        <div class="form-group">
          <FormFields::FieldText
            @placeholder={{t "views.app.conversation.fields.subject"}}
            @label={{t "views.app.conversation.fields.subject"}}
            @type="text"
            @value={{this.editedSubject}}
            @data-field="conversation.subject"
            @length="255"
            @onInput={{fn this.handleSubjectChange}}
          />
        </div>
        <div data-field="conversation.description" data-field-type="wysiwyg" class="form-field ember-view">
          <AppUi::ToastUi
            @usersList={{@membersList}}
            @issueSearch={{perform @search}}
            @editType='wysiwyg'
            @hide={{array 'footer'}}
            @onContentChange={{this.handleDescriptionChange}}
            @initialValue={{this.editedDescription}}
            @placeholder={{t "views.app.conversation.fields.description"}}
          />
          <FormFields::Label
            @label={{t "views.app.conversation.fields.description"}}
            @data-field="conversation.description"
          />
        </div>
      </div>
    {{/bootstrap-modal}}
  {{/if}}
</div>
