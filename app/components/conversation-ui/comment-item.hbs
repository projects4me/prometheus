<div class="comment-item-wrapper">
  <ConversationUi::CommentFrame
    @commentId={{@comment.id}}
    @userId={{@comment.createdUser}}
    @userName={{@comment.createdUserName}}
    @date={{@comment.dateModified}}
  >
    <:tools>
      {{#if this.isOwnComment}}
        <AppUi::Button
          data-btn="edit"
          type="button"
          class="btn btn-box-tool"
          @onClick={{this.showEditCommentDialog}}
          data-toggle="tooltip"
          title="{{t 'global.form.edit'}}"
        >
          <i class="fa fa-pencil"></i>
        </AppUi::Button>
        <AppUi::Button
          data-btn="delete"
          type="button"
          class="btn btn-box-tool"
          @onClick={{this.showDeleteCommentDialog}}
          data-toggle="tooltip"
          title="{{t 'global.form.delete'}}"
        >
          <i class="fa fa-trash-o"></i>
        </AppUi::Button>
      {{/if}}
    </:tools>
    <:body>
      {{translate-comment @comment.comment}}
    </:body>
  </ConversationUi::CommentFrame>

  {{#if this.showEditCommentModal}}
    {{#bootstrap-modal
      title="views.app.conversation.comment.edit.title"
      closeLabel="global.form.cancel"
      confirmLabel="views.app.conversation.comment.edit.update"
      close=(action "removeEditCommentModal")
      confirm=(action "updateComment")
    }}
      <div class="edit-comment-form">
        <div data-field="comment.edit" data-field-type="wysiwyg" class="form-field ember-view">
          <AppUi::ToastUi
            @usersList={{@usersList}}
            @issueSearch={{@issueSearch}}
            @editType='wysiwyg'
            @hide={{array 'footer'}}
            @onContentChange={{this.handleEditContentChange}}
            @initialValue={{this.comment.comment}}
            @placeholder={{t "views.app.conversation.messagebox"}}
          />
          <FormFields::Label
            @label={{t "views.app.conversation.comment.edit.comment"}}
            @data-field="comment.edit"
          />
        </div>
      </div>
    {{/bootstrap-modal}}
  {{/if}}

  {{#if this.showDeleteCommentModal}}
    {{#bootstrap-modal
      title="views.app.conversation.comment.delete.title"
      closeLabel="global.form.cancel"
      confirmLabel="views.app.conversation.comment.delete.confirm"
      close=(action "removeDeleteCommentModal")
      confirm=(action "deleteComment")
      confirmClass="btn-danger"
    }}
      <div class="delete-comment-confirmation">
        <div class="alert alert-warning flex-row flex-ai-c">
          <i class="fa fa-exclamation-triangle"></i>
          <p>{{safe-html (t "views.app.conversation.comment.delete.message")}}</p>
        </div>
      </div>
    {{/bootstrap-modal}}
  {{/if}}
</div>

