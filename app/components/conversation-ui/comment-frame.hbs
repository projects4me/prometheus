<div class="box-comment" data-comment-id={{@commentId}} ...attributes>
  {{#if @userId}}
    <Agent::UserAvatar @class="img-circle img-sm" @userId={{@userId}} @name={{@userName}} />
  {{/if}}

  <div class="comment-text" {{modify-links}}>
    <span class="username">
      {{#if @userId}}
        <a href="/app/user/{{@userId}}">{{@userName}}</a>
        <Agent::UserTag @userId={{@userId}} @showSponsor={{true}} />
      {{/if}}
      <span class="text-muted pull-right">
        {{format-date-time date=@date}}
        {{yield to="tools"}}
      </span>
    </span>
    {{yield to="body"}}
  </div>
</div>
