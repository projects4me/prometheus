<AppUi::ToastUi
    @usersList={{@usersList}}
    @issueSearch={{@issueSearch}}
    @editType= 'wysiwyg'
    @hide={{array 'footer' @hide}}
    @onContentChange={{this.setContent}}
    @onKeyboardSubmit={{this.handleKeyboardSubmit}}
    @placeholder={{@placeholder}}
/>
<div class="pull-right">
  <AppUi::Button 
    type="button" 
    class="btn btn-primary" 
    @content={{this.comment}}
    @onClick={{fn @save @entity this.comment this.mentionedIssues}}
    @disableOnEmpty={{true}}>
    {{t "views.app.conversation.post"}}
  </AppUi::Button>
</div>