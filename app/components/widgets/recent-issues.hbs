<AppUi::Table
  @header={{t "views.app.widgets.recentIssues.title"}}
  @columns={{this.fields}}
  @data={{this.originalData}}
  @showSearch={{true}}
  @searchPlaceholder={{t "views.app.widgets.recentIssues.searchPlaceholder"}}
  @emptyStateMessage={{t "views.app.widgets.recentIssues.emptyStateMessage"}}
  @searchFields={{@widgetSettings.searchFields}}
  @applyDefaultSearch={{true}}
  @onSearch={{this.handleSearch}}
  @useLazyLoading={{@widgetSettings.useLazyLoading}}
  @filters={{this.filters}}
  @filterCallbacks={{this.filterCallbacks}}
  @setData={{this.setData}}
  @onLoadMore={{this.onLoadMore}}
  @pageSize={{@widgetSettings.pageSize}}
  data-recent-issues-table
>
  <:body>
    {{#each this.filteredData as |item|}}
      <tr>
        <td>
          <LinkTo
            @route="app.project.issue.page"
            @models={{array
              (lowercase item.project.shortCode)
              item.issueNumber
            }}
          >
            #{{item.issueNumber}}
          </LinkTo>
        </td>
        <td>
          {{item.subject}}
        </td>
        <td>
          <span class="badge {{item.status}}">{{t
              (concat "views.app.issue.lists.status." item.status)
            }}</span>
        </td>
        <td>
          <LinkTo
            @route="app.project.index"
            @model={{lowercase item.project.shortCode}}
          >
            {{item.project.name}}
          </LinkTo>
        </td>
        <td>
          {{format-date date=item.startDate}}
        </td>
        <td>
          {{format-date date=item.endDate}}
        </td>
      </tr>
    {{/each}}
  </:body>
</AppUi::Table>